#, fuzzy
msgid "blog.worldcat-scrape.text2"
msgstr "ברגע שספר נכנס לספרייה מוצלת עם נתונים פתוחים כמו <a %(wikipedia_library_genesis)s>Library Genesis</a>, ועכשיו <a %(wikipedia_annas_archive)s>הארכיון של אנה</a>, הוא משוכפל בכל העולם (באמצעות טורנטים), ובכך נשמר למעשה לנצח."

#, fuzzy
msgid "blog.worldcat-scrape.text3"
