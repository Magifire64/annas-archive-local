#, fuzzy
msgid "blog.how-to.projects.metadata.title"
msgstr "Τίτλος"

#, fuzzy
msgid "blog.how-to.projects.metadata.location"
msgstr "Όνομα αρχείου / τοποθεσία"

#, fuzzy
msgid "blog.how-to.projects.metadata.id"
msgstr "ID: μπορεί να είναι κάποιο εσωτερικό ID, αλλά τα IDs όπως το ISBN ή το DOI είναι επίσης χρήσιμα."

#, fuzzy
msgid "blog.how-to.projects.metadata.size"
msgstr "Μέγεθος: για να υπολογίσετε πόσο χώρο στο δίσκο χρειάζεστε."

#, fuzzy
msgid "blog.how-to.projects.metadata.hash"
