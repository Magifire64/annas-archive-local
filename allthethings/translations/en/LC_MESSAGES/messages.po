msgstr "Metadata and torrents"

msgid "page.datasets.scihub.link_libgen_rs_torrents"
msgstr "Torrents on Libgen.rs"

msgid "page.datasets.scihub.link_libgen_li_torrents"
msgstr "Torrents on Libgen.li"

