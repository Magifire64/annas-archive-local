msgid "page.datasets.libgen_li.link_metadata"
msgstr "Metadata"

#: allthethings/page/templates/page/datasets_lgli.html:120
msgid "page.datasets.libgen_li.link_metadata_ftp"
msgstr "Metadata via FTP"

