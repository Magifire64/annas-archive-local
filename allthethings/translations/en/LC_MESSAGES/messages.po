msgid "page.datasets.upload.source.newsarch_magz"
msgstr "Archive of newspapers and magazines. Corresponds to <q>newsarch_magz</q> metadata in <a %(a1)s><q>Other metadata scrapes</q></a>."

msgid "page.datasets.upload.source.pdcnet_org"
