msgid "blog.all-isbns-winners.first.text1"
msgstr "ಈ <a %(phiresky_github)s>ಸಲ್ಲಿಕೆ</a> (<a %(annas_archive_note_2951)s>Gitlab ಕಾಮೆಂಟ್</a>) ನಮ್ಮೆಲ್ಲಾ ನಿರೀಕ್ಷೆಗಳನ್ನು ಮೀರಿ, ಮತ್ತು ಇನ್ನಷ್ಟು! ನಾವು ವಿಶೇಷವಾಗಿ ಅದ್ಭುತವಾಗಿ ಹೊಂದಿಕೊಳ್ಳುವ ದೃಶ್ಯೀಕರಣ ಆಯ್ಕೆಗಳು (ಅನ್ವಯಿತ ಶೇಡರ್‌ಗಳನ್ನು ಸಹ ಬೆಂಬಲಿಸುವ) ಇಷ್ಟಪಟ್ಟೆವು, ಆದರೆ ಪೂರ್ಣವಾದ ಪೂರ್ವನಿಯೋಜಿತ ಪಟ್ಟಿ ಸಹಿತ. ನಾವು ಎಷ್ಟು ವೇಗವಾಗಿ ಮತ್ತು ಸುಗಮವಾಗಿ ಎಲ್ಲವೂ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತವೆ ಎಂಬುದನ್ನು ಇಷ್ಟಪಟ್ಟೆವು, ಸರಳ ಅನುಷ್ಠಾನ (ಅದರಲ್ಲಿಯೇ ಬ್ಯಾಕ್‌ಎಂಡ್ ಇಲ್ಲ), ಚತುರ ಮಿನಿಮ್ಯಾಪ್, ಮತ್ತು ಅವರ <a %(phiresky_github)s>ಬ್ಲಾಗ್ ಪೋಸ್ಟ್</a> ನಲ್ಲಿ ವಿಶಾಲವಾದ ವಿವರಣೆ. ಅದ್ಭುತ ಕೆಲಸ, ಮತ್ತು ಸೂಕ್ತ ವಿಜೇತ!"

#, fuzzy
msgid "blog.all-isbns-winners.second"
msgstr "ಎರಡನೇ ಸ್ಥಾನ $3,000: hypha"

#, fuzzy
msgid "blog.all-isbns-winners.second.text1"
msgstr "ಮತ್ತೊಂದು ಅದ್ಭುತ <a %(annas_archive_note_2913)s>ಸಲ್ಲಿಕೆ</a>. ಮೊದಲ ಸ್ಥಾನಕ್ಕಿಂತ ಹೆಚ್ಚು ಹೊಂದಿಕೊಳ್ಳುವಂತಿಲ್ಲ, ಆದರೆ ನಾವು ವಾಸ್ತವಿಕ ಮಟ್ಟದ ದೃಶ್ಯೀಕರಣವನ್ನು ಮೊದಲ ಸ್ಥಾನಕ್ಕಿಂತ ಹೆಚ್ಚು ಇಷ್ಟಪಟ್ಟೆವು (ಅಂತರಾಲದ ವಕ್ರ, ಗಡಿಗಳು, ಲೇಬಲಿಂಗ್, ಹೈಲೈಟಿಂಗ್, ಪ್ಯಾನಿಂಗ್, ಮತ್ತು ಜೂಮಿಂಗ್). ಜೋ ಡೇವಿಸ್ ಅವರ <a %(annas_archive_note_2971)s>ಕಾಮೆಂಟ್</a> ನಮ್ಮೊಂದಿಗೆ ಪ್ರತಿಧ್ವನಿಸಿತು:"

#, fuzzy
msgid "blog.all-isbns-winners.second.quote"
msgstr "“ಪರಿಪೂರ್ಣ ಚೌಕಗಳು ಮತ್ತು ಆಯತಗಳು ಗಣಿತೀಯವಾಗಿ ಆಕರ್ಷಕವಾಗಿದ್ದರೂ, ಅವು ನಕ್ಷೆ ಸಂದರ್ಭದಲ್ಲಿ ಉತ್ತಮ ಸ್ಥಳೀಯತೆಯನ್ನು ಒದಗಿಸುವುದಿಲ್ಲ. ಈ ಹಿಲ್ಬರ್ಟ್ ಅಥವಾ ಕ್ಲಾಸಿಕ್ ಮಾರ್ಟನ್‌ನಲ್ಲಿನ ಅಸಮಮಿತಿ ದೋಷವಲ್ಲ, ಆದರೆ ವೈಶಿಷ್ಟ್ಯವಾಗಿದೆ ಎಂದು ನಾನು ನಂಬುತ್ತೇನೆ. ಇಟಲಿಯ ಪ್ರಸಿದ್ಧ ಬೂಟ್-ಆಕಾರದ ಹೊರರೇಖೆಯಂತೆ, ಈ ವಕ್ರಗಳ ವಿಶಿಷ್ಟ \"ವಿಲಕ್ಷಣತೆಗಳು\" ಜ್ಞಾನಾತ್ಮಕ ಲ್ಯಾಂಡ್‌ಮಾರ್ಕ್‌ಗಳಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸಬಹುದು. ಈ ವಿಶಿಷ್ಟತೆಯು ಸ್ಥಳೀಯ ಸ್ಮೃತಿಯನ್ನು ಹೆಚ್ಚಿಸಬಹುದು ಮತ್ತು ಬಳಕೆದಾರರು ತಮ್ಮನ್ನು ತಾವು ಹೊಂದಿಸಲು ಸಹಾಯ ಮಾಡಬಹುದು, ನಿರ್ದಿಷ್ಟ ಪ್ರದೇಶಗಳನ್ನು ಪತ್ತೆಹಚ್ಚುವುದು ಅಥವಾ ಮಾದರಿಗಳನ್ನು ಗಮನಿಸುವುದು ಸುಲಭವಾಗಬಹುದು.”"

#, fuzzy
msgid "blog.all-isbns-winners.second.text2"
msgstr "ಮತ್ತು ದೃಶ್ಯೀಕರಣ ಮತ್ತು ರೆಂಡರಿಂಗ್‌ಗಾಗಿ ಇನ್ನೂ ಅನೇಕ ಆಯ್ಕೆಗಳು, ಜೊತೆಗೆ ಅತ್ಯಂತ ಸುಗಮ ಮತ್ತು ಬುದ್ಧಿವಂತ UI. ದೃಢವಾದ ಎರಡನೇ ಸ್ಥಾನ!"

