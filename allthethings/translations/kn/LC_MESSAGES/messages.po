#, fuzzy
msgid "blog.how-to-run.text1"
msgstr "ನಾನು <a %(wikipedia_annas_archive)s>ಅನ್ನಾ’ಸ್ ಆರ್ಕೈವ್</a> ಅನ್ನು ನಿರ್ವಹಿಸುತ್ತೇನೆ, ಇದು <a %(wikipedia_shadow_library)s>ಶಾಡೋ ಲೈಬ್ರರಿಗಳು</a>, Sci-Hub, ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್, ಮತ್ತು Z-ಲೈಬ್ರರಿ ಹೋಲುವ ವಿಶ್ವದ ಅತಿದೊಡ್ಡ ಓಪನ್-ಸೋರ್ಸ್ ಲಾಭರಹಿತ ಶೋಧ ಎಂಜಿನ್ ಆಗಿದೆ. ನಮ್ಮ ಗುರಿ ಜ್ಞಾನ ಮತ್ತು ಸಂಸ್ಕೃತಿಯನ್ನು ಸುಲಭವಾಗಿ ಲಭ್ಯವಾಗಿಸಲು, ಮತ್ತು ಅಂತಿಮವಾಗಿ <a %(blog_isbndb_dump_how_many_books_are_preserved_forever)s>ವಿಶ್ವದ ಎಲ್ಲಾ ಪುಸ್ತಕಗಳನ್ನು</a> ಆರ್ಕೈವ್ ಮತ್ತು ಸಂರಕ್ಷಿಸಲು ಒಟ್ಟಾಗಿ ಜನರ ಸಮುದಾಯವನ್ನು ನಿರ್ಮಿಸುವುದು."

#, fuzzy
msgid "blog.how-to-run.text2"
msgstr "ಈ ಲೇಖನದಲ್ಲಿ ನಾನು ಈ ವೆಬ್‌ಸೈಟ್ ಅನ್ನು ಹೇಗೆ ನಿರ್ವಹಿಸುತ್ತೇವೆ ಮತ್ತು ಪ್ರಶ್ನಾರ್ಹ ಕಾನೂನು ಸ್ಥಿತಿಯೊಂದಿಗೆ ವೆಬ್‌ಸೈಟ್ ಅನ್ನು ನಿರ್ವಹಿಸುವುದರೊಂದಿಗೆ ಬರುವ ಅನನ್ಯ ಸವಾಲುಗಳನ್ನು ತೋರಿಸುತ್ತೇನೆ, ಏಕೆಂದರೆ ಶಾಡೋ ಚಾರಿಟಿಗಳಿಗಾಗಿ “AWS” ಇಲ್ಲ."

#, fuzzy
msgid "blog.how-to-run.text3"
msgstr "<em>ಸಹೋದರಿ ಲೇಖನವನ್ನು ಸಹ ಪರಿಶೀಲಿಸಿ <a %(blog_how_to_become_a_pirate_archivist)s>ಪೈರೇಟ್ ಆರ್ಕೈವಿಸ್ಟ್ ಆಗುವುದು ಹೇಗೆ</a>.</em>"

#, fuzzy
msgid "blog.how-to-run.innovation-tokens"
msgstr "ಆವಿಷ್ಕಾರ ಟೋಕನ್‌ಗಳು"

#, fuzzy
msgid "blog.how-to-run.innovation-tokens.text1"
msgstr "ನಮ್ಮ ತಂತ್ರಜ್ಞಾನ ಪೈಲನ್ನು ಪ್ರಾರಂಭಿಸೋಣ. ಇದು ಉದ್ದೇಶಪೂರ್ವಕವಾಗಿ ಬೋರುಗೊಳಿಸಿದೆ. ನಾವು Flask, MariaDB, ಮತ್ತು ElasticSearch ಅನ್ನು ಬಳಸುತ್ತೇವೆ. ಅಷ್ಟೇ. ಹುಡುಕಾಟವು ಬಹುಮಟ್ಟಿಗೆ ಪರಿಹಾರಗೊಂಡ ಸಮಸ್ಯೆಯಾಗಿದೆ, ಮತ್ತು ನಾವು ಅದನ್ನು ಪುನಃ ಆವಿಷ್ಕಾರ ಮಾಡಲು ಉದ್ದೇಶಿಸಿಲ್ಲ. ಇದಲ್ಲದೆ, ನಾವು ನಮ್ಮ <a %(mcfunley)s>ಆವಿಷ್ಕಾರ ಟೋಕನ್‌ಗಳನ್ನು</a> ಇನ್ನೇನಾದರೂ ಮೇಲೆ ಖರ್ಚು ಮಾಡಬೇಕಾಗಿದೆ: ಅಧಿಕಾರಿಗಳಿಂದ ತೆಗೆದುಹಾಕದಿರುವುದು."

#, fuzzy
msgid "blog.how-to-run.innovation-tokens.text2"
msgstr "ಹಾಗಾದರೆ, ಅಣ್ಣಾ’ಸ್ ಆರ್ಕೈವ್ ಎಷ್ಟು ಕಾನೂನುಬದ್ಧ ಅಥವಾ ಅಕ್ರಮವಾಗಿದೆ? ಇದು ಮುಖ್ಯವಾಗಿ ಕಾನೂನು ವ್ಯಾಪ್ತಿಯ ಮೇಲೆ ಅವಲಂಬಿತವಾಗಿದೆ. ಹೆಚ್ಚಿನ ದೇಶಗಳು ಕೆಲವು ರೀತಿಯ ಕಾಪಿರೈಟ್‌ನಲ್ಲಿ ನಂಬಿಕೆ ಇಡುತ್ತವೆ, ಇದು ಅರ್ಥವಾಗುತ್ತದೆ ಜನರು ಅಥವಾ ಕಂಪನಿಗಳಿಗೆ ಕೆಲವು ರೀತಿಯ ಕೃತಿಗಳ ಮೇಲೆ ನಿರ್ದಿಷ್ಟ ಅವಧಿಗೆ ವಿಶೇಷ ಏಕಪಕ್ಷೀಯ ಹಕ್ಕು ನೀಡಲಾಗುತ್ತದೆ. ಅಣ್ಣಾ’ಸ್ ಆರ್ಕೈವ್‌ನಲ್ಲಿ ನಾವು ನಂಬುವಂತೆ, ಕೆಲವು ಲಾಭಗಳಿದ್ದರೂ, ಒಟ್ಟಾರೆ ಕಾಪಿರೈಟ್ ಸಮಾಜಕ್ಕೆ ಶುದ್ಧ-ನಕಾರಾತ್ಮಕವಾಗಿದೆ — ಆದರೆ ಅದು ಮತ್ತೊಂದು ಸಮಯದ ಕಥೆ."

#, fuzzy
msgid "blog.how-to-run.innovation-tokens.text3"
msgstr "ಈ ವಿಶೇಷ ಏಕಪಕ್ಷೀಯ ಹಕ್ಕುಗಳು ಕೆಲವು ಕೃತಿಗಳ ಮೇಲೆ ಅರ್ಥವಾಗುತ್ತದೆ, ಈ ಏಕಪಕ್ಷೀಯ ಹಕ್ಕುಗಳ ಹೊರತಾದ ಯಾರಿಗೂ ಆ ಕೃತಿಗಳನ್ನು ನೇರವಾಗಿ ವಿತರಿಸುವುದು ಅಕ್ರಮವಾಗಿದೆ — ನಮಗೆ ಸಹ. ಆದರೆ ಅಣ್ಣಾ’ಸ್ ಆರ್ಕೈವ್ ಒಂದು ಹುಡುಕಾಟ ಎಂಜಿನ್ ಆಗಿದ್ದು, ಆ ಕೃತಿಗಳನ್ನು ನೇರವಾಗಿ ವಿತರಿಸುವುದಿಲ್ಲ (ಕ್ಲಿಯರ್‌ನೆಟ್ ವೆಬ್‌ಸೈಟ್‌ನಲ್ಲಿ ಕನಿಷ್ಠ), ಆದ್ದರಿಂದ ನಾವು ಸರಿಯೇನೋ, ಅಲ್ಲವೇ? ಅಷ್ಟೇನೂ ಅಲ್ಲ. ಅನೇಕ ಕಾನೂನು ವ್ಯಾಪ್ತಿಗಳಲ್ಲಿ ಕಾಪಿರೈಟ್‌ಗೊಳಿಸಿದ ಕೃತಿಗಳನ್ನು ವಿತರಿಸುವುದು ಮಾತ್ರವಲ್ಲ, ಅವುಗಳನ್ನು ವಿತರಿಸುವ ಸ್ಥಳಗಳಿಗೆ ಲಿಂಕ್ ಮಾಡುವುದು ಸಹ ಅಕ್ರಮವಾಗಿದೆ. ಇದರ ಒಂದು ಕ್ಲಾಸಿಕ್ ಉದಾಹರಣೆ ಯುನೈಟೆಡ್ ಸ್ಟೇಟ್ಸ್‌ನ DMCA ಕಾನೂನು."

#, fuzzy
msgid "blog.how-to-run.innovation-tokens.text4"
msgstr "ಅದು ಸ್ಪೆಕ್ಟ್ರಮ್‌ನ ಕಠಿಣ ತುದಿಯಾಗಿದೆ. ಸ್ಪೆಕ್ಟ್ರಮ್‌ನ ಇನ್ನೊಂದು ತುದಿಯಲ್ಲಿ ಸಿದ್ಧಾಂತತಃ ಯಾವುದೇ ಕಾಪಿರೈಟ್ ಕಾನೂನುಗಳಿಲ್ಲದ ದೇಶಗಳು ಇರಬಹುದು, ಆದರೆ ಇವು ವಾಸ್ತವದಲ್ಲಿ ಇಲ್ಲ. ಬಹುತೇಕ ಪ್ರತಿಯೊಂದು ದೇಶದಲ್ಲೂ ಕೆಲವು ರೀತಿಯ ಕಾಪಿರೈಟ್ ಕಾನೂನುಗಳು ಪುಸ್ತಕಗಳಲ್ಲಿ ಇವೆ. ಜಾರಿಗೆ ತರುವುದು ಬೇರೆ ಕಥೆ. ಕಾಪಿರೈಟ್ ಕಾನೂನು ಜಾರಿಗೆ ತರುವುದಕ್ಕೆ ಸರ್ಕಾರಗಳು ಆಸಕ್ತಿ ತೋರದ ಅನೇಕ ದೇಶಗಳಿವೆ. ಈ ಎರಡು ತೀವ್ರತೆಯ ನಡುವೆ ಇರುವ ದೇಶಗಳೂ ಇವೆ, ಅವು ಕಾಪಿರೈಟ್‌ಗೊಳಿಸಿದ ಕೃತಿಗಳನ್ನು ವಿತರಿಸುವುದನ್ನು ನಿಷೇಧಿಸುತ್ತವೆ, ಆದರೆ ಅಂತಹ ಕೃತಿಗಳಿಗೆ ಲಿಂಕ್ ಮಾಡುವುದು ನಿಷೇಧಿಸುವುದಿಲ್ಲ."

#, fuzzy
msgid "blog.how-to-run.innovation-tokens.text5"
msgstr "ಮತ್ತೊಂದು ಪರಿಗಣನೆ ಕಂಪನಿಯ ಮಟ್ಟದಲ್ಲಿದೆ. ಒಂದು ಕಂಪನಿ ಕಾಪಿರೈಟ್ ಬಗ್ಗೆ ಪರಿಗಣಿಸದ ಕಾನೂನು ವ್ಯಾಪ್ತಿಯಲ್ಲಿ ಕಾರ್ಯನಿರ್ವಹಿಸಿದರೂ, ಕಂಪನಿಯೇ ಯಾವುದೇ ಅಪಾಯವನ್ನು ತೆಗೆದುಕೊಳ್ಳಲು ಸಿದ್ಧವಿಲ್ಲದಿದ್ದರೆ, ಯಾರಾದರೂ ಅದರ ಬಗ್ಗೆ ದೂರು ನೀಡಿದ ತಕ್ಷಣ ನಿಮ್ಮ ವೆಬ್‌ಸೈಟ್ ಅನ್ನು ಮುಚ್ಚಬಹುದು."

#, fuzzy
msgid "blog.how-to-run.innovation-tokens.text6"
msgstr "ಕೊನೆಗೆ, ದೊಡ್ಡ ಪರಿಗಣನೆ ಪಾವತಿಗಳು. ನಾವು ಅನಾಮಧೇಯವಾಗಿರಬೇಕಾದ್ದರಿಂದ, ನಾವು ಪರಂಪರागत ಪಾವತಿ ವಿಧಾನಗಳನ್ನು ಬಳಸಲು ಸಾಧ್ಯವಿಲ್ಲ. ಇದು ನಮಗೆ ಕ್ರಿಪ್ಟೋಕರೆನ್ಸಿಗಳೊಂದಿಗೆ ಬಿಟ್ಟಿದೆ, ಮತ್ತು ಕೇವಲ ಕೆಲವು ಕಂಪನಿಗಳು ಅವುಗಳನ್ನು ಬೆಂಬಲಿಸುತ್ತವೆ (ಕ್ರಿಪ್ಟೋ ಮೂಲಕ ಪಾವತಿಸಲಾದ ವರ್ಚುವಲ್ ಡೆಬಿಟ್ ಕಾರ್ಡ್‌ಗಳಿವೆ, ಆದರೆ ಅವುಗಳನ್ನು ಹೆಚ್ಚಾಗಿ ಸ್ವೀಕರಿಸಲಾಗುವುದಿಲ್ಲ)."

#, fuzzy
msgid "blog.how-to-run.architecture"
msgstr "ಸಿಸ್ಟಮ್ ಆರ್ಕಿಟೆಕ್ಚರ್"

#, fuzzy
msgid "blog.how-to-run.architecture.text1"
msgstr "ಹಾಗಾದರೆ, ನಿಮ್ಮ ವೆಬ್‌ಸೈಟ್ ಅನ್ನು ಮುಚ್ಚದೆ ಹೋಸ್ಟ್ ಮಾಡಲು ಸಿದ್ಧವಿರುವ ಕೆಲವು ಕಂಪನಿಗಳನ್ನು ನೀವು ಕಂಡುಕೊಂಡಿದ್ದೀರಿ — ಇವುಗಳನ್ನು “ಸ್ವಾತಂತ್ರ್ಯ ಪ್ರಿಯ ಪೂರೈಕೆದಾರರು” ಎಂದು ಕರೆಯೋಣ 😄. ನೀವು ಶೀಘ್ರದಲ್ಲೇ ಎಲ್ಲವನ್ನೂ ಅವರೊಂದಿಗೆ ಹೋಸ್ಟ್ ಮಾಡುವುದು ಬಹಳ ಖರ್ಚುಬರುವುದನ್ನು ಕಂಡುಕೊಳ್ಳುತ್ತೀರಿ, ಆದ್ದರಿಂದ ನೀವು ಕೆಲವು “ಅಗ್ಗದ ಪೂರೈಕೆದಾರರು” ಅನ್ನು ಕಂಡು, ಅಲ್ಲಿ ನಿಜವಾದ ಹೋಸ್ಟಿಂಗ್ ಮಾಡಬಹುದು, ಸ್ವಾತಂತ್ರ್ಯ ಪ್ರಿಯ ಪೂರೈಕೆದಾರರ ಮೂಲಕ ಪ್ರಾಕ್ಸಿ ಮಾಡಬಹುದು. ನೀವು ಸರಿಯಾಗಿ ಮಾಡಿದರೆ, ಅಗ್ಗದ ಪೂರೈಕೆದಾರರು ನೀವು ಏನು ಹೋಸ್ಟ್ ಮಾಡುತ್ತಿದ್ದೀರಿ ಎಂಬುದನ್ನು ಎಂದಿಗೂ ತಿಳಿಯುವುದಿಲ್ಲ, ಮತ್ತು ಯಾವುದೇ ದೂರುಗಳನ್ನು ಸ್ವೀಕರಿಸುವುದಿಲ್ಲ."

#, fuzzy
msgid "blog.how-to-run.architecture.text2"
msgstr "ಈ ಎಲ್ಲಾ ಪೂರೈಕೆದಾರರೊಂದಿಗೆ, ಅವರು ಯಾವಾಗಲಾದರೂ ನಿಮ್ಮನ್ನು ಮುಚ್ಚಬಹುದು ಎಂಬ ಅಪಾಯವಿದೆ, ಆದ್ದರಿಂದ ನಿಮಗೆ ಹೆಚ್ಚುವರಿ ಅಗತ್ಯವಿದೆ. ನಮ್ಮ ಪೈಲಿನ ಎಲ್ಲಾ ಮಟ್ಟಗಳಲ್ಲಿ ನಾವು ಇದನ್ನು ಅಗತ್ಯವಿದೆ."

#, fuzzy
msgid "blog.how-to-run.architecture.text3"
msgstr "ಸ್ವಲ್ಪ ಸ್ವಾತಂತ್ರ್ಯ ಪ್ರಿಯ ಕಂಪನಿಯು ತನ್ನನ್ನು ಆಸಕ್ತಿಕರ ಸ್ಥಾನದಲ್ಲಿ ಇರಿಸಿಕೊಂಡಿದೆ, ಅದು Cloudflare. ಅವರು <a %(blog_cloudflare)s>ವಿವಾದಿಸಿದ್ದಾರೆ</a> ಅವರು ಹೋಸ್ಟಿಂಗ್ ಪೂರೈಕೆದಾರರಲ್ಲ, ಆದರೆ ಯುಟಿಲಿಟಿ, ISP ನಂತೆ. ಆದ್ದರಿಂದ ಅವರು DMCA ಅಥವಾ ಇತರ ತೆಗೆದುಹಾಕುವ ವಿನಂತಿಗಳಿಗೆ ಒಳಪಡುವುದಿಲ್ಲ, ಮತ್ತು ನಿಮ್ಮ ನಿಜವಾದ ಹೋಸ್ಟಿಂಗ್ ಪೂರೈಕೆದಾರರಿಗೆ ಯಾವುದೇ ವಿನಂತಿಗಳನ್ನು ಫಾರ್ವರ್ಡ್ ಮಾಡುತ್ತಾರೆ. ಅವರು ಈ ರಚನೆಯನ್ನು ರಕ್ಷಿಸಲು ನ್ಯಾಯಾಲಯಕ್ಕೆ ಹೋಗುವಷ್ಟು ದೂರ ಹೋಗಿದ್ದಾರೆ. ಆದ್ದರಿಂದ ನಾವು ಅವರನ್ನು ಇನ್ನೊಂದು ಲೇಯರ್ ಕ್ಯಾಶಿಂಗ್ ಮತ್ತು ರಕ್ಷಣೆಗಾಗಿ ಬಳಸಬಹುದು."

#, fuzzy
msgid "blog.how-to-run.architecture.text4"
msgstr "Cloudflare ಅನಾಮಧೇಯ ಪಾವತಿಗಳನ್ನು ಸ್ವೀಕರಿಸುವುದಿಲ್ಲ, ಆದ್ದರಿಂದ ನಾವು ಅವರ ಉಚಿತ ಯೋಜನೆಯನ್ನು ಮಾತ್ರ ಬಳಸಬಹುದು. ಇದು ಅವರ ಲೋಡ್ ಬ್ಯಾಲೆನ್ಸಿಂಗ್ ಅಥವಾ ಫೇಲ್ಓವರ್ ವೈಶಿಷ್ಟ್ಯಗಳನ್ನು ನಾವು ಬಳಸಲು ಸಾಧ್ಯವಿಲ್ಲ ಎಂಬುದನ್ನು ಅರ್ಥೈಸುತ್ತದೆ. ಆದ್ದರಿಂದ ನಾವು <a %(annas_archive_l255)s>ಇದನ್ನು ನಾವು ಸ್ವತಃ</a> ಡೊಮೇನ್ ಮಟ್ಟದಲ್ಲಿ ಅನುಷ್ಠಾನಗೊಳಿಸಿದ್ದೇವೆ. ಪುಟ ಲೋಡ್‌ನಲ್ಲಿ, ಬ್ರೌಸರ್ ಪ್ರಸ್ತುತ ಡೊಮೇನ್ ಇನ್ನೂ ಲಭ್ಯವಿದೆಯೇ ಎಂದು ಪರಿಶೀಲಿಸುತ್ತದೆ, ಮತ್ತು ಇಲ್ಲದಿದ್ದರೆ, ಇದು ಎಲ್ಲಾ URL ಗಳನ್ನು ಬೇರೆ ಡೊಮೇನ್ ಗೆ ಪುನರ್ಲಿಖಿಸುತ್ತದೆ. Cloudflare ಅನೇಕ ಪುಟಗಳನ್ನು ಕ್ಯಾಶ್ ಮಾಡುತ್ತದೆ, ಇದು ಅರ್ಥವಾಗುತ್ತದೆ ಬಳಕೆದಾರರು ನಮ್ಮ ಮುಖ್ಯ ಡೊಮೇನ್‌ನಲ್ಲಿ ಇಳಿಯಬಹುದು, ಪ್ರಾಕ್ಸಿ ಸರ್ವರ್ ಡೌನ್ ಆಗಿದ್ದರೂ, ನಂತರ ಮುಂದಿನ ಕ್ಲಿಕ್‌ನಲ್ಲಿ ಬೇರೆ ಡೊಮೇನ್‌ಗೆ ಸ್ಥಳಾಂತರಿಸಲಾಗುತ್ತದೆ."

#, fuzzy
msgid "blog.how-to-run.architecture.text5"
msgstr "ನಾವು ಇನ್ನೂ ಸಾಮಾನ್ಯ ಕಾರ್ಯಾಚರಣಾ ಚಿಂತೆಗಳನ್ನು ನಿರ್ವಹಿಸಬೇಕಾಗಿದೆ, ಉದಾಹರಣೆಗೆ ಸರ್ವರ್ ಆರೋಗ್ಯವನ್ನು ಮೇಲ್ವಿಚಾರಣೆ ಮಾಡುವುದು, ಬ್ಯಾಕ್‌ಎಂಡ್ ಮತ್ತು ಫ್ರಂಟ್‌ಎಂಡ್ ದೋಷಗಳನ್ನು ಲಾಗ್ ಮಾಡುವುದು, ಇತ್ಯಾದಿ. ನಮ್ಮ ಫೇಲ್ಓವರ್ ಆರ್ಕಿಟೆಕ್ಚರ್ ಈ ಮುಂಭಾಗದಲ್ಲಿ ಹೆಚ್ಚು ದೃಢತೆಯನ್ನು ಒದಗಿಸುತ್ತದೆ, ಉದಾಹರಣೆಗೆ ಡೊಮೇನ್‌ಗಳಲ್ಲಿ ಒಂದರಲ್ಲಿ ಸಂಪೂರ್ಣ ವಿಭಿನ್ನ ಸರ್ವರ್‌ಗಳ ಸಮೂಹವನ್ನು ನಡೆಸುವ ಮೂಲಕ. ಮುಖ್ಯ ಆವೃತ್ತಿಯಲ್ಲಿನ ಗಂಭೀರ ದೋಷ ಗಮನಿಸದಿದ್ದರೆ, ನಾವು ಈ ಪ್ರತ್ಯೇಕ ಡೊಮೇನ್‌ನಲ್ಲಿ ಹಳೆಯ ಆವೃತ್ತಿಯ ಕೋಡ್ ಮತ್ತು ಡೇಟಾಸೆಟ್‌ಗಳನ್ನು ಸಹ ನಡೆಸಬಹುದು."

