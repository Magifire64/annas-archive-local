msgid "blog.isbndb-dump.title"
msgstr "ISBNdb ಡಂಪ್, ಅಥವಾ ಎಷ್ಟು ಪುಸ್ತಕಗಳು ಶಾಶ್ವತವಾಗಿ ಉಳಿದಿವೆ?"

#, fuzzy
msgid "blog.isbndb-dump.tldr"
msgstr "ನಾವು ಶ್ಯಾಡೋ ಗ್ರಂಥಾಲಯಗಳಿಂದ ಫೈಲ್‌ಗಳನ್ನು ಸರಿಯಾಗಿ ಡಿಡ್ಯುಪ್ಲಿಕೇಟ್ ಮಾಡಿದರೆ, ಜಗತ್ತಿನ ಎಲ್ಲಾ ಪುಸ್ತಕಗಳಲ್ಲಿ ನಾವು ಎಷ್ಟು ಶೇಕಡಾವಾರು ಉಳಿಸಿದ್ದೇವೆ?"

#, fuzzy
msgid "blog.isbndb-dump.text1"
msgstr "ಪೈರೇಟ್ ಲೈಬ್ರರಿ ಮಿರರ್ (EDIT: <a %(wikipedia_annas_archive)s>ಅನ್ನಾ’ಸ್ ಆರ್ಕೈವ್</a> ಗೆ ಸ್ಥಳಾಂತರಿಸಲಾಗಿದೆ) ಸಹಾಯದಿಂದ, ಜಗತ್ತಿನ ಎಲ್ಲಾ ಪುಸ್ತಕಗಳನ್ನು ತೆಗೆದುಕೊಂಡು ಅವುಗಳನ್ನು ಶಾಶ್ವತವಾಗಿ ಉಳಿಸುವುದು ನಮ್ಮ ಉದ್ದೇಶ.<sup>1</sup> ನಮ್ಮ Z-ಲೈಬ್ರರಿ ಟೋರಂಟ್‌ಗಳು ಮತ್ತು ಮೂಲ ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್ ಟೋರಂಟ್‌ಗಳ ನಡುವೆ, ನಮ್ಮ ಬಳಿ 11,783,153 ಫೈಲ್‌ಗಳಿವೆ. ಆದರೆ ಅದು ಎಷ್ಟು, ವಾಸ್ತವವಾಗಿ? ನಾವು ಆ ಫೈಲ್‌ಗಳನ್ನು ಸರಿಯಾಗಿ ಡಿಡ್ಯುಪ್ಲಿಕೇಟ್ ಮಾಡಿದರೆ, ಜಗತ್ತಿನ ಎಲ್ಲಾ ಪುಸ್ತಕಗಳಲ್ಲಿ ನಾವು ಎಷ್ಟು ಶೇಕಡಾವಾರು ಉಳಿಸಿದ್ದೇವೆ? ನಾವು ಇದನ್ನು ಹೀಗೆ ಹೊಂದಲು ಬಯಸುತ್ತೇವೆ:"

#, fuzzy
msgid "blog.isbndb-dump.10%"
msgstr "10% oಮಾನವತೆಯ ಲಿಖಿತ ಪರಂಪರೆ ಶಾಶ್ವತವಾಗಿ ಉಳಿಸಲಾಗಿದೆ"

#, fuzzy
msgid "blog.isbndb-dump.text2"
msgstr "ಶೇಕಡಾವಾರುಗಾಗಿ, ನಮಗೆ ಹರವು ಬೇಕು: ಇದುವರೆಗೆ ಪ್ರಕಟಿತ ಎಲ್ಲಾ ಪುಸ್ತಕಗಳ ಒಟ್ಟು ಸಂಖ್ಯೆ.<sup>2</sup> ಗೂಗಲ್ ಪುಸ್ತಕಗಳ ನಾಶದ ಮೊದಲು, ಯೋಜನೆಯ ಇಂಜಿನಿಯರ್, ಲಿಯೋನಿಡ್ ಟೈಚರ್, <a %(booksearch_blogspot)s>ಈ ಸಂಖ್ಯೆಯನ್ನು ಅಂದಾಜಿಸಲು ಪ್ರಯತ್ನಿಸಿದರು</a>. ಅವರು 129,864,880 (“ಕನಿಷ್ಠವು ಭಾನುವಾರವರೆಗೆ”) ಎಂಬ ಸಂಖ್ಯೆಯನ್ನು ತಮಾಷೆಯಾಗಿ ಕಂಡುಹಿಡಿದರು. ಅವರು ಜಗತ್ತಿನ ಎಲ್ಲಾ ಪುಸ್ತಕಗಳ ಏಕೀಕೃತ ಡೇಟಾಬೇಸ್ ಅನ್ನು ನಿರ್ಮಿಸುವ ಮೂಲಕ ಈ ಸಂಖ್ಯೆಯನ್ನು ಅಂದಾಜಿಸಿದರು. ಇದಕ್ಕಾಗಿ, ಅವರು ವಿಭಿನ್ನ ಡೇಟಾಸೆಟ್‌ಗಳನ್ನು ಒಟ್ಟುಗೂಡಿಸಿದರು ಮತ್ತು ನಂತರ ಅವುಗಳನ್ನು ವಿವಿಧ ರೀತಿಯಲ್ಲಿ ವಿಲೀನಗೊಳಿಸಿದರು."

#, fuzzy
msgid "blog.isbndb-dump.text3"
msgstr "ತ್ವರಿತವಾಗಿ ಹೇಳುವುದಾದರೆ, ಜಗತ್ತಿನ ಎಲ್ಲಾ ಪುಸ್ತಕಗಳನ್ನು ಪಟ್ಟಿ ಮಾಡಲು ಪ್ರಯತ್ನಿಸಿದ ಮತ್ತೊಬ್ಬ ವ್ಯಕ್ತಿ: ಆ್ಯರನ್ ಸ್ವಾರ್ಟ್ಜ್, ದಿ ಲೇಟ್ ಡಿಜಿಟಲ್ ಆಕ್ಟಿವಿಸ್ಟ್ ಮತ್ತು ರೆಡಿಟ್ ಸಹ-ಸ್ಥಾಪಕ.<sup>3</sup> ಅವರು <a %(youtube)s>ಓಪನ್ ಲೈಬ್ರರಿ ಪ್ರಾರಂಭಿಸಿದರು</a> \"ಪ್ರತಿ ಪ್ರಕಟಿತ ಪುಸ್ತಕಕ್ಕೆ ಒಂದು ವೆಬ್ ಪುಟ\" ಎಂಬ ಗುರಿಯೊಂದಿಗೆ, ವಿವಿಧ ಮೂಲಗಳಿಂದ ಡೇಟಾವನ್ನು ಸಂಯೋಜಿಸುತ್ತಿದ್ದಾರೆ. bulk-downloading ಶೈಕ್ಷಣಿಕ ಪೇಪರ್‌ಗಳಿಗೆ ಆರೋಪಿಸಲಾಗಿದ್ದಾಗ, ಡಿಜಿಟಲ್ ಸಂರಕ್ಷಣೆ ಕಾರ್ಯಕ್ಕಾಗಿ ಅವರು ಪರಮ ಬೆಲೆ ಪಾವತಿಸಿದರು, ಇದು ಅವರ ಆತ್ಮಹತ್ಯೆಗೆ ಕಾರಣವಾಯಿತು. Needless to say, this is one of the reasons our group is pseudonymous, and why we’re being very careful. ಓಪನ್ ಲೈಬ್ರರಿ ಇನ್ನೂ ಇಂಟರ್ನೆಟ್ ಆರ್ಕೈವ್‌ನಲ್ಲಿರುವ ಜನರಿಂದ ವೀರರಂತೆ ನಿರ್ವಹಿಸಲಾಗುತ್ತಿದೆ, ಆ್ಯರನ್ ಅವರ ಪರಂಪರೆಯನ್ನು ಮುಂದುವರಿಸುತ್ತಿದೆ. ನಾವು ಈ ಬಗ್ಗೆ ಈ ಪೋಸ್ಟ್‌ನಲ್ಲಿ ನಂತರ ಮತ್ತೆ ಚರ್ಚಿಸುತ್ತೇವೆ."

#, fuzzy
msgid "blog.isbndb-dump.text4"
msgstr "Google ಬ್ಲಾಗ್ ಪೋಸ್ಟ್‌ನಲ್ಲಿ, ಟೈಚರ್ ಈ ಸಂಖ್ಯೆಯನ್ನು ಅಂದಾಜಿಸಲು ಕೆಲವು ಸವಾಲುಗಳನ್ನು ವಿವರಿಸುತ್ತಾರೆ. ಮೊದಲನೆಯದಾಗಿ, ಪುಸ್ತಕವೆಂದರೆ ಏನು? ಕೆಲವು ಸಾಧ್ಯ ವ್ಯಾಖ್ಯಾನಗಳಿವೆ:"

#, fuzzy
msgid "blog.isbndb-dump.maybe.copies"
msgstr "<strong>ಭೌತಿಕ ಪ್ರತಿಗಳು.</strong> ಸ್ಪಷ್ಟವಾಗಿ ಇದು ತುಂಬಾ ಸಹಾಯಕವಾಗಿಲ್ಲ, ಏಕೆಂದರೆ ಅವು ಒಂದೇ ವಸ್ತುವಿನ ನಕಲುಗಳು. ಜನರು ಪುಸ್ತಕಗಳಲ್ಲಿ ಮಾಡುವ ಎಲ್ಲಾ ಟಿಪ್ಪಣಿಗಳನ್ನು, ಫರ್ಮಾಟ್‌ನ ಪ್ರಸಿದ್ಧ \"ಅಂಚಿನಲ್ಲಿನ ಬರಹಗಳು\" ಅನ್ನು ನಾವು ಸಂರಕ್ಷಿಸಲು ಸಾಧ್ಯವಾಗಿದ್ದರೆ ಅದ್ಭುತವಾಗಿರುತ್ತದೆ. ಆದರೆ ಅಫ್ಸೋಸ್, ಅದು ಆರ್ಕೈವಿಸ್ಟ್‌ಗಳ ಕನಸು ಆಗಿಯೇ ಉಳಿಯುತ್ತದೆ."

#, fuzzy
msgid "blog.isbndb-dump.maybe.works"
msgstr "<strong>“ಕೃತಿಗಳು”.</strong> ಉದಾಹರಣೆಗೆ \"ಹ್ಯಾರಿ ಪಾಟರ್ ಮತ್ತು ಚೇಂಬರ್ ಆಫ್ ಸೀಕ್ರೆಟ್ಸ್\" ಎಂಬ ತಾತ್ವಿಕ ಪರಿಕಲ್ಪನೆ, ಅದರ ಎಲ್ಲಾ ಆವೃತ್ತಿಗಳನ್ನು ಒಳಗೊಂಡಂತೆ, ವಿಭಿನ್ನ ಅನುವಾದಗಳು ಮತ್ತು ಮರುಮುದ್ರಣಗಳು. ಇದು ಉಪಯುಕ್ತ ವ್ಯಾಖ್ಯಾನವಾಗಿದೆ, ಆದರೆ ಏನು ಲೆಕ್ಕಹಾಕಬೇಕು ಎಂಬುದರ ಗಡಿ ಎಳೆಯುವುದು ಕಷ್ಟವಾಗಬಹುದು. ಉದಾಹರಣೆಗೆ, ನಾವು ವಿಭಿನ್ನ ಅನುವಾದಗಳನ್ನು ಸಂರಕ್ಷಿಸಲು ಬಯಸಬಹುದು, ಆದರೆ ಕೇವಲ ಸಣ್ಣ ವ್ಯತ್ಯಾಸಗಳೊಂದಿಗೆ ಮರುಮುದ್ರಣಗಳು ಅಷ್ಟು ಮುಖ್ಯವಾಗಿಲ್ಲ."

#, fuzzy
msgid "blog.isbndb-dump.maybe.editions"
msgstr "<strong>“ಆವೃತ್ತಿಗಳು”.</strong> ಇಲ್ಲಿ ನೀವು ಪುಸ್ತಕದ ಪ್ರತಿಯೊಂದು ವಿಶಿಷ್ಟ ಆವೃತ್ತಿಯನ್ನು ಲೆಕ್ಕಹಾಕುತ್ತೀರಿ. ಅದರ ಬಗ್ಗೆ ಏನಾದರೂ ವಿಭಿನ್ನವಾಗಿದ್ದರೆ, ಉದಾಹರಣೆಗೆ ವಿಭಿನ್ನ ಮುಚ್ಚಳ ಅಥವಾ ವಿಭಿನ್ನ ಮುನ್ನುಡಿ, ಅದು ವಿಭಿನ್ನ ಆವೃತ್ತಿಯಾಗಿ ಲೆಕ್ಕಹಾಕುತ್ತದೆ."

#, fuzzy
msgid "blog.isbndb-dump.maybe.files"
msgstr "<strong>ಫೈಲ್‌ಗಳು.</strong> ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್, ಸೈ-ಹಬ್ ಅಥವಾ Z-ಲೈಬ್ರರಿ ಮುಂತಾದ ಛಾಯಾ ಗ್ರಂಥಾಲಯಗಳೊಂದಿಗೆ ಕೆಲಸ ಮಾಡುವಾಗ, ಒಂದು ಹೆಚ್ಚುವರಿ ಪರಿಗಣನೆ ಇದೆ. ಅದೇ ಆವೃತ್ತಿಯ ಅನೇಕ ಸ್ಕ್ಯಾನ್‌ಗಳು ಇರಬಹುದು. ಮತ್ತು ಜನರು OCR ಬಳಸಿ ಪಠ್ಯವನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡುವ ಮೂಲಕ ಅಥವಾ ಕೋನದಲ್ಲಿ ಸ್ಕ್ಯಾನ್ ಮಾಡಿದ ಪುಟಗಳನ್ನು ಸರಿಪಡಿಸುವ ಮೂಲಕ ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಫೈಲ್‌ಗಳ ಉತ್ತಮ ಆವೃತ್ತಿಗಳನ್ನು ಮಾಡಬಹುದು. ನಾವು ಈ ಫೈಲ್‌ಗಳನ್ನು ಒಂದೇ ಆವೃತ್ತಿಯಾಗಿ ಲೆಕ್ಕಹಾಕಲು ಬಯಸುತ್ತೇವೆ, ಇದಕ್ಕೆ ಉತ್ತಮ ಮೆಟಾಡೇಟಾ ಅಥವಾ ಡಾಕ್ಯುಮೆಂಟ್ ಸಾದೃಶ್ಯ ಕ್ರಮಗಳನ್ನು ಬಳಸಿಕೊಂಡು ಡಿಡುಪ್ಲಿಕೇಶನ್ ಅಗತ್ಯವಿರುತ್ತದೆ."

#, fuzzy
msgid "blog.isbndb-dump.text5"
msgstr "“ಆವೃತ್ತಿಗಳು” \"ಪುಸ್ತಕಗಳು\" ಎಂದರೇನು ಎಂಬುದರ ಅತ್ಯಂತ ಪ್ರಾಯೋಗಿಕ ವ್ಯಾಖ್ಯಾನವಾಗಿದೆ. ಅನುಕೂಲಕರವಾಗಿ, ಈ ವ್ಯಾಖ್ಯಾನವನ್ನು ವಿಶಿಷ್ಟ ISBN ಸಂಖ್ಯೆಗಳ ನಿಯೋಜನೆಗೆ ಸಹ ಬಳಸಲಾಗುತ್ತದೆ. ISBN, ಅಥವಾ ಅಂತಾರಾಷ್ಟ್ರೀಯ ಮಾನದಂಡ ಪುಸ್ತಕ ಸಂಖ್ಯೆ, ಅಂತಾರಾಷ್ಟ್ರೀಯ ವ್ಯಾಪಾರಕ್ಕಾಗಿ ಸಾಮಾನ್ಯವಾಗಿ ಬಳಸಲಾಗುತ್ತದೆ, ಏಕೆಂದರೆ ಇದು ಅಂತಾರಾಷ್ಟ್ರೀಯ ಬಾರ್ಕೋಡ್ ವ್ಯವಸ್ಥೆಯೊಂದಿಗೆ ಏಕೀಕೃತವಾಗಿದೆ (\"ಅಂತಾರಾಷ್ಟ್ರೀಯ ಲೇಖನ ಸಂಖ್ಯೆ\"). ನೀವು ಅಂಗಡಿಗಳಲ್ಲಿ ಪುಸ್ತಕವನ್ನು ಮಾರಾಟ ಮಾಡಲು ಬಯಸಿದರೆ, ಅದಕ್ಕೆ ಬಾರ್ಕೋಡ್ ಅಗತ್ಯವಿದೆ, ಆದ್ದರಿಂದ ನೀವು ISBN ಪಡೆಯುತ್ತೀರಿ."

#, fuzzy
msgid "blog.isbndb-dump.text6"
msgstr "ಟೈಚರ್ ಅವರ ಬ್ಲಾಗ್ ಪೋಸ್ಟ್‌ನಲ್ಲಿ ISBNಗಳು ಉಪಯುಕ್ತವಾಗಿದ್ದರೂ, ಅವು ವಿಶ್ವವ್ಯಾಪಿಯಾಗಿಲ್ಲ, ಏಕೆಂದರೆ ಅವುಗಳನ್ನು ನಿಜವಾಗಿಯೂ ಏಳನೆಯ ದಶಕದ ಮಧ್ಯದಲ್ಲಿ ಅಳವಡಿಸಿಕೊಳ್ಳಲಾಯಿತು ಮತ್ತು ಜಗತ್ತಿನಾದ್ಯಂತ ಎಲ್ಲೆಡೆ ಅಳವಡಿಸಿಕೊಳ್ಳಲಿಲ್ಲ ಎಂದು ಉಲ್ಲೇಖಿಸಲಾಗಿದೆ. ಆದರೂ, ISBN ಬಹುಶಃ ಪುಸ್ತಕ ಆವೃತ್ತಿಗಳ ಅತ್ಯಂತ ವ್ಯಾಪಕವಾಗಿ ಬಳಸುವ ಗುರುತಿನ ಚಿಹ್ನೆಯಾಗಿದೆ, ಆದ್ದರಿಂದ ಇದು ನಮ್ಮ ಉತ್ತಮ ಆರಂಭಿಕ ಬಿಂದು. ನಾವು ಜಗತ್ತಿನ ಎಲ್ಲಾ ISBNಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು ಸಾಧ್ಯವಾದರೆ, ಯಾವ ಪುಸ್ತಕಗಳನ್ನು ಇನ್ನೂ ಸಂರಕ್ಷಿಸಬೇಕಾಗಿದೆ ಎಂಬುದರ ಉಪಯುಕ್ತ ಪಟ್ಟಿ ನಮಗೆ ಸಿಗುತ್ತದೆ."

#, fuzzy
msgid "blog.isbndb-dump.text7"
msgstr "ಹಾಗಾದರೆ, ನಾವು ಡೇಟಾವನ್ನು ಎಲ್ಲಿಂದ ಪಡೆಯುತ್ತೇವೆ? ಜಗತ್ತಿನ ಎಲ್ಲಾ ಪುಸ್ತಕಗಳ ಪಟ್ಟಿಯನ್ನು ಸಂಗ್ರಹಿಸಲು ಪ್ರಯತ್ನಿಸುತ್ತಿರುವ ಹಲವಾರು ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಪ್ರಯತ್ನಗಳಿವೆ:"

#, fuzzy
msgid "blog.isbndb-dump.effort.google"
msgstr "<strong>Google.</strong> ಕೊನೆಗೂ, ಅವರು Google ಪುಸ್ತಕಗಳಿಗಾಗಿ ಈ ಸಂಶೋಧನೆ ನಡೆಸಿದರು. ಆದರೆ, ಅವರ ಮೆಟಾಡೇಟಾ ಬಲ್ಕ್‌ನಲ್ಲಿ ಲಭ್ಯವಿಲ್ಲ ಮತ್ತು ಸ್ಕ್ರೇಪ್ ಮಾಡಲು ತುಂಬಾ ಕಷ್ಟವಾಗಿದೆ."

#, fuzzy
msgid "blog.isbndb-dump.effort.openlib"
msgstr "<strong>ಓಪನ್ ಲೈಬ್ರರಿ.</strong> ಹಿಂದಿನಂತೆ, ಇದು ಅವರ ಸಂಪೂರ್ಣ ಮಿಷನ್. ಅವರು ಸಹಕರಿಸುವ ಗ್ರಂಥಾಲಯಗಳು ಮತ್ತು ರಾಷ್ಟ್ರೀಯ ಆರ್ಕೈವ್‌ಗಳಿಂದ ಗ್ರಂಥಾಲಯದ ಡೇಟಾವನ್ನು ದೊಡ್ಡ ಪ್ರಮಾಣದಲ್ಲಿ ಸಂಗ್ರಹಿಸಿದ್ದಾರೆ ಮತ್ತು ಮುಂದುವರಿಸುತ್ತಿದ್ದಾರೆ. ಅವರು ಸ್ವಯಂಸೇವಕ ಗ್ರಂಥಪಾಲಕರು ಮತ್ತು ತಾಂತ್ರಿಕ ತಂಡವನ್ನೂ ಹೊಂದಿದ್ದಾರೆ, ಅವರು ದಾಖಲೆಗಳನ್ನು ಡಿಡುಪ್ಲಿಕೇಟ್ ಮಾಡಲು ಮತ್ತು ಎಲ್ಲಾ ರೀತಿಯ ಮೆಟಾಡೇಟಾ ಸಹಿತ ಟ್ಯಾಗ್ ಮಾಡಲು ಪ್ರಯತ್ನಿಸುತ್ತಿದ್ದಾರೆ. ಅತ್ಯುತ್ತಮವಾಗಿ, ಅವರ ಡೇಟಾಸೆಟ್ ಸಂಪೂರ್ಣವಾಗಿ ಮುಕ್ತವಾಗಿದೆ. ನೀವು ಸರಳವಾಗಿ <a %(openlibrary)s>ಅದನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಬಹುದು</a>."

#, fuzzy
msgid "blog.isbndb-dump.effort.worldcat"
msgstr "<strong>ವಿಶ್ವಕ್ಯಾಟ್.</strong> ಇದು ಲಾಭರಹಿತ OCLC ನಡೆಸುವ ವೆಬ್‌ಸೈಟ್, ಇದು ಗ್ರಂಥಾಲಯ ನಿರ್ವಹಣಾ ವ್ಯವಸ್ಥೆಗಳನ್ನು ಮಾರುತ್ತದೆ. ಅವರು ಅನೇಕ ಗ್ರಂಥಾಲಯಗಳಿಂದ ಪುಸ್ತಕ ಮೆಟಾಡೇಟಾವನ್ನು ಸಂಗ್ರಹಿಸುತ್ತಾರೆ ಮತ್ತು ಅದನ್ನು ವಿಶ್ವಕ್ಯಾಟ್ ವೆಬ್‌ಸೈಟ್ ಮೂಲಕ ಲಭ್ಯವಿರಿಸುತ್ತಾರೆ. ಆದರೆ, ಅವರು ಈ ಡೇಟಾವನ್ನು ಮಾರಾಟ ಮಾಡುವ ಮೂಲಕ ಹಣವನ್ನು ಸಂಪಾದಿಸುತ್ತಾರೆ, ಆದ್ದರಿಂದ ಇದು ಬಲ್ಕ್ ಡೌನ್‌ಲೋಡ್‌ಗಾಗಿ ಲಭ್ಯವಿಲ್ಲ. ಅವರು ನಿರ್ದಿಷ್ಟ ಗ್ರಂಥಾಲಯಗಳೊಂದಿಗೆ ಸಹಕಾರದಲ್ಲಿ ಡೌನ್‌ಲೋಡ್‌ಗಾಗಿ ಕೆಲವು ಹೆಚ್ಚು ಮಿತವಾದ ಬಲ್ಕ್ ಡೇಟಾಸೆಟ್‌ಗಳನ್ನು ಹೊಂದಿದ್ದಾರೆ."

#, fuzzy
msgid "blog.isbndb-dump.effort.isbndb"
msgstr "<strong>ISBNdb.</strong> ಇದು ಈ ಬ್ಲಾಗ್ ಪೋಸ್ಟ್‌ನ ವಿಷಯ. ISBNdb ಪುಸ್ತಕ ಮೆಟಾಡೇಟಾ, ವಿಶೇಷವಾಗಿ ಬೆಲೆ ನಿಖಾರಿಕೆಯನ್ನು ವಿವಿಧ ವೆಬ್‌ಸೈಟ್‌ಗಳಿಂದ ಸ್ಕ್ರೇಪ್ ಮಾಡುತ್ತದೆ, ನಂತರ ಅವರು ಪುಸ್ತಕ ಮಾರಾಟಗಾರರಿಗೆ ಮಾರುತ್ತಾರೆ, ಆದ್ದರಿಂದ ಅವರು ತಮ್ಮ ಪುಸ್ತಕಗಳನ್ನು ಉಳಿದ ಮಾರುಕಟ್ಟೆಯೊಂದಿಗೆ ಹೊಂದಾಣಿಕೆ ಮಾಡಬಹುದು. ISBNಗಳು ಇತ್ತೀಚಿನ ದಿನಗಳಲ್ಲಿ ಬಹಳಷ್ಟು ವಿಶ್ವವ್ಯಾಪಿಯಾಗಿರುವುದರಿಂದ, ಅವರು ಪರಿಣಾಮಕಾರಿಯಾಗಿ \"ಪ್ರತಿ ಪುಸ್ತಕಕ್ಕೆ ಒಂದು ವೆಬ್ ಪುಟ\" ನಿರ್ಮಿಸಿದ್ದಾರೆ."

#, fuzzy
msgid "blog.isbndb-dump.effort.ils"
msgstr "<strong>ವಿವಿಧ ವೈಯಕ್ತಿಕ ಗ್ರಂಥಾಲಯ ವ್ಯವಸ್ಥೆಗಳು ಮತ್ತು ಆರ್ಕೈವ್‌ಗಳು.</strong> ಮೇಲಿನ ಯಾವುದೇ ಒಂದು ಮೂಲಕ ಸೂಚ್ಯಂಕಗೊಳಿಸಲಾಗದ ಮತ್ತು ಸಂಗ್ರಹಿಸಲಾಗದ ಗ್ರಂಥಾಲಯಗಳು ಮತ್ತು ಆರ್ಕೈವ್‌ಗಳಿವೆ, ಬಹುಶಃ ಅವುಗಳಿಗೆ ಹಣಕಾಸು ಕೊರತೆಯಿರುವುದರಿಂದ, ಅಥವಾ ಇತರ ಕಾರಣಗಳಿಂದಾಗಿ ತಮ್ಮ ಡೇಟಾವನ್ನು ಓಪನ್ ಲೈಬ್ರರಿ, OCLC, Google, ಇತ್ಯಾದಿಗಳೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳಲು ಬಯಸುವುದಿಲ್ಲ. ಇವುಗಳಲ್ಲಿ ಬಹಳಷ್ಟು ಡಿಜಿಟಲ್ ದಾಖಲೆಗಳನ್ನು ಇಂಟರ್ನೆಟ್ ಮೂಲಕ ಪ್ರವೇಶಿಸಬಹುದು, ಮತ್ತು ಅವುಗಳು ಬಹಳಷ್ಟು ರಕ್ಷಿಸಲ್ಪಟ್ಟಿಲ್ಲ, ಆದ್ದರಿಂದ ನೀವು ಸಹಾಯ ಮಾಡಲು ಬಯಸಿದರೆ ಮತ್ತು ವಿಚಿತ್ರ ಗ್ರಂಥಾಲಯ ವ್ಯವಸ್ಥೆಗಳ ಬಗ್ಗೆ ತಿಳಿಯಲು ಸ್ವಲ್ಪ ಮೋಜು ಮಾಡಲು ಬಯಸಿದರೆ, ಇವು ಉತ್ತಮ ಆರಂಭಿಕ ಬಿಂದುಗಳಾಗಿವೆ."

#, fuzzy
msgid "blog.isbndb-dump.text8"
msgstr "ಈ ಪೋಸ್ಟ್‌ನಲ್ಲಿ, ನಾವು ಒಂದು ಸಣ್ಣ ಬಿಡುಗಡೆ (ನಮ್ಮ ಹಿಂದಿನ Z-ಲೈಬ್ರರಿ ಬಿಡುಗಡೆಗಳೊಂದಿಗೆ ಹೋಲಿಸಿದರೆ) ಘೋಷಿಸಲು ಸಂತೋಷವಾಗುತ್ತಿದೆ. ನಾವು ಬಹುತೇಕ ISBNdb ಅನ್ನು ಸ್ಕ್ರೇಪ್ ಮಾಡಿದ್ದೇವೆ ಮತ್ತು ಪೈರೇಟ್ ಲೈಬ್ರರಿ ಮಿರರ್ ವೆಬ್‌ಸೈಟ್‌ನಲ್ಲಿ ಟೋರಂಟ್ ಮಾಡಲು ಡೇಟಾವನ್ನು ಲಭ್ಯವಿರಿಸಿದ್ದೇವೆ (ಸಂಪಾದನೆ: <a %(wikipedia_annas_archive)s>ಅನ್ನಾ’ಸ್ ಆರ್ಕೈವ್</a> ಗೆ ಸ್ಥಳಾಂತರಿಸಲಾಗಿದೆ; ನಾವು ಇದನ್ನು ಇಲ್ಲಿ ನೇರವಾಗಿ ಲಿಂಕ್ ಮಾಡುವುದಿಲ್ಲ, ಕೇವಲ ಅದನ್ನು ಹುಡುಕಿ). ಇವು ಸುಮಾರು 30.9 ಮಿಲಿಯನ್ ದಾಖಲೆಗಳು (20GB <a %(jsonlines)s>JSON ಲೈನ್ಸ್</a> ಆಗಿ; 4.4GB gzipped). ಅವರ ವೆಬ್‌ಸೈಟ್‌ನಲ್ಲಿ ಅವರು ವಾಸ್ತವವಾಗಿ 32.6 ಮಿಲಿಯನ್ ದಾಖಲೆಗಳನ್ನು ಹೊಂದಿದ್ದಾರೆ ಎಂದು ಅವರು ಹೇಳುತ್ತಾರೆ, ಆದ್ದರಿಂದ ನಾವು ಯಾವುದೋ ರೀತಿಯಲ್ಲಿ ಕೆಲವು ತಪ್ಪಿಸಬಹುದು, ಅಥವಾ <em>ಅವರು</em> ಏನಾದರೂ ತಪ್ಪು ಮಾಡಬಹುದು. ಯಾವುದೇ ಸಂದರ್ಭದಲ್ಲಿಯೂ, ನಾವು ಅದನ್ನು ಹೇಗೆ ಮಾಡಿದ್ದೇವೆ ಎಂಬುದನ್ನು ಈಗಾಗಲೇ ಹಂಚಿಕೊಳ್ಳುವುದಿಲ್ಲ — ನಾವು ಅದನ್ನು ಓದುಗರಿಗೆ ವ್ಯಾಯಾಮವಾಗಿ ಬಿಡುತ್ತೇವೆ. ;-)"

#, fuzzy
msgid "blog.isbndb-dump.text9"
msgstr "ನಾವು ಹಂಚಿಕೊಳ್ಳುವುದು ಕೆಲವು ಪ್ರಾಥಮಿಕ ವಿಶ್ಲೇಷಣೆ, ಜಗತ್ತಿನಲ್ಲಿರುವ ಪುಸ್ತಕಗಳ ಸಂಖ್ಯೆಯನ್ನು ಅಂದಾಜಿಸಲು ಹತ್ತಿರವಾಗಲು ಪ್ರಯತ್ನಿಸಲು. ನಾವು ಮೂರು ಡೇಟಾಸೆಟ್‌ಗಳನ್ನು ನೋಡಿದ್ದೇವೆ: ಈ ಹೊಸ ISBNdb ಡೇಟಾಸೆಟ್, Z-ಲೈಬ್ರರಿ ಛಾಯಾ ಗ್ರಂಥಾಲಯದಿಂದ ನಾವು ಸ್ಕ್ರೇಪ್ ಮಾಡಿದ ಮೆಟಾಡೇಟಾದ ನಮ್ಮ ಮೂಲ ಬಿಡುಗಡೆ (ಇದರಲ್ಲಿ ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್ ಸೇರಿದೆ), ಮತ್ತು ಓಪನ್ ಲೈಬ್ರರಿ ಡೇಟಾ ಡಂಪ್."

#, fuzzy
msgid "blog.isbndb-dump.text10"
msgstr "ಕೆಲವು ಅಂದಾಜು ಸಂಖ್ಯೆಗಳೊಂದಿಗೆ ಪ್ರಾರಂಭಿಸೋಣ:"

#, fuzzy
msgid "blog.isbndb-dump.text11"
msgstr "Z-ಲೈಬ್ರರಿ/ಲಿಬ್ಜೆನ್ ಮತ್ತು ಓಪನ್ ಲೈಬ್ರರಿಯಲ್ಲಿ ಅನೇಕ ಪುಸ್ತಕಗಳಿವೆ, ಆದರೆ ವಿಶಿಷ್ಟ ISBNಗಳು ಕಡಿಮೆ. ಅಂದರೆ ಆ ಪುಸ್ತಕಗಳಲ್ಲಿ ಬಹಳಷ್ಟು ISBNಗಳನ್ನು ಹೊಂದಿಲ್ಲವೇ, ಅಥವಾ ISBN ಮೆಟಾಡೇಟಾ ಕೇವಲ ಕಾಣೆಯಾಗಿದೆ? ನಾವು ಈ ಪ್ರಶ್ನೆಗೆ ಉತ್ತರಿಸಲು ಇತರ ಗುಣಲಕ್ಷಣಗಳ ಆಧಾರದ ಮೇಲೆ ಸ್ವಯಂಚಾಲಿತ ಹೊಂದಾಣಿಕೆ (ಶೀರ್ಷಿಕೆ, ಲೇಖಕ, ಪ್ರಕಾಶಕ, ಇತ್ಯಾದಿ), ಹೆಚ್ಚಿನ ಡೇಟಾ ಮೂಲಗಳನ್ನು ಎಳೆಯುವುದು, ಮತ್ತು ISBNಗಳನ್ನು ನಿಜವಾದ ಪುಸ್ತಕ ಸ್ಕ್ಯಾನ್‌ಗಳಿಂದಲೇ ಹೊರತೆಗೆಯುವುದು (Z-ಲೈಬ್ರರಿ/ಲಿಬ್ಜೆನ್‌ನ ಸಂದರ್ಭದಲ್ಲಿ) ಸಂಯೋಜನೆ ಬಳಸಬಹುದು."

#, fuzzy
msgid "blog.isbndb-dump.text12"
msgstr "ಆ ISBNಗಳಲ್ಲಿ ಎಷ್ಟು ವಿಶಿಷ್ಟವಾಗಿವೆ? ಇದನ್ನು ವೆನ್ ಡಯಾಗ್ರಾಮ್‌ನೊಂದಿಗೆ ಉತ್ತಮವಾಗಿ ಚಿತ್ರಿಸಲಾಗಿದೆ:"

#, fuzzy
msgid "blog.isbndb-dump.text13"
msgstr "ನಿಖರವಾಗಿ ಹೇಳುವುದಾದರೆ:"

#, fuzzy
msgid "blog.isbndb-dump.text14"
msgstr "ನಾವು ಎಷ್ಟು ಕಡಿಮೆ ಒದಗಿಸುವಿಕೆ ಇದೆ ಎಂಬುದರಿಂದ ಆಶ್ಚರ್ಯಚಕಿತರಾದೆವು! ISBNdb ನಲ್ಲಿ Z-Library ಅಥವಾ Open Library ನಲ್ಲಿ ಕಾಣಿಸದಿರುವ ISBN ಗಳ ದೊಡ್ಡ ಪ್ರಮಾಣವಿದೆ, ಮತ್ತು ಇತರ ಎರಡುಗಳಿಗೂ (ಕಡಿಮೆ ಪ್ರಮಾಣದಲ್ಲಿ ಆದರೆ ಇನ್ನೂ ಸಾಕಷ್ಟು ಪ್ರಮಾಣದಲ್ಲಿ) ಇದು ಅನ್ವಯಿಸುತ್ತದೆ. ಇದು ಹಲವಾರು ಹೊಸ ಪ್ರಶ್ನೆಗಳನ್ನು ಎತ್ತುತ್ತದೆ. ISBN ಗಳೊಂದಿಗೆ ಟ್ಯಾಗ್ ಮಾಡದ ಪುಸ್ತಕಗಳನ್ನು ಟ್ಯಾಗ್ ಮಾಡಲು ಸ್ವಯಂಚಾಲಿತ ಹೊಂದಾಣಿಕೆ ಎಷ್ಟು ಸಹಾಯ ಮಾಡುತ್ತದೆ? ಹೆಚ್ಚಿನ ಹೊಂದಾಣಿಕೆಗಳು ಮತ್ತು ಆದ್ದರಿಂದ ಹೆಚ್ಚಿದ ಒದಗಿಸುವಿಕೆ ಇರುತ್ತದೆಯೇ? ಜೊತೆಗೆ, ನಾವು 4ನೇ ಅಥವಾ 5ನೇ ಡೇಟಾಸೆಟ್ ಅನ್ನು ಸೇರಿಸಿದರೆ ಏನಾಗುತ್ತದೆ? ಆಗ ನಾವು ಎಷ್ಟು ಒದಗಿಸುವಿಕೆ ನೋಡುತ್ತೇವೆ?"

#, fuzzy
msgid "blog.isbndb-dump.text15"
msgstr "ಇದು ನಮಗೆ ಪ್ರಾರಂಭದ ಬಿಂದು ನೀಡುತ್ತದೆ. ನಾವು ಈಗ Z-Library ಡೇಟಾಸೆಟ್‌ನಲ್ಲಿ ಇಲ್ಲದ ಎಲ್ಲಾ ISBN ಗಳನ್ನು ನೋಡಬಹುದು, ಮತ್ತು ಶೀರ್ಷಿಕೆ/ಲೇಖಕ ಕ್ಷೇತ್ರಗಳಿಗೂ ಹೊಂದಾಣಿಕೆ ಇಲ್ಲದಿರುವುದನ್ನು ನೋಡಬಹುದು. ಇದು ವಿಶ್ವದ ಎಲ್ಲಾ ಪುಸ್ತಕಗಳನ್ನು ಸಂರಕ್ಷಿಸಲು ನಮಗೆ ಸಹಾಯ ಮಾಡುತ್ತದೆ: ಮೊದಲು ಇಂಟರ್ನೆಟ್‌ನಿಂದ ಸ್ಕ್ಯಾನ್‌ಗಳನ್ನು ಸ್ಕ್ರಾಪ್ ಮಾಡುವ ಮೂಲಕ, ನಂತರ ನಿಜವಾದ ಜೀವನದಲ್ಲಿ ಪುಸ್ತಕಗಳನ್ನು ಸ್ಕ್ಯಾನ್ ಮಾಡಲು ಹೊರಡುವ ಮೂಲಕ. ನಂತರದವು ಕೂಡ ಜನಸಾಮಾನ್ಯರಿಂದ ಹಣ ಸಂಗ್ರಹಿಸಬಹುದಾಗಿದೆ, ಅಥವಾ ವಿಶೇಷ ಪುಸ್ತಕಗಳನ್ನು ಡಿಜಿಟೈಸ್ ಮಾಡಲು ಬಯಸುವ ಜನರಿಂದ \"ಬೌಂಟಿಗಳು\" ಮೂಲಕ ಚಲಾಯಿಸಬಹುದಾಗಿದೆ. ಇವೆಲ್ಲವೂ ಬೇರೆ ಸಮಯದ ಕಥೆ."

#, fuzzy
msgid "blog.isbndb-dump.text16"
msgstr "ನೀವು ಇದರಲ್ಲಿ ಯಾವುದೇ ಸಹಾಯ ಮಾಡಲು ಬಯಸಿದರೆ — ಹೆಚ್ಚಿನ ವಿಶ್ಲೇಷಣೆ; ಹೆಚ್ಚಿನ ಮೆಟಾಡೇಟಾವನ್ನು ಸ್ಕ್ರಾಪ್ ಮಾಡುವುದು; ಹೆಚ್ಚಿನ ಪುಸ್ತಕಗಳನ್ನು ಹುಡುಕುವುದು; ಪುಸ್ತಕಗಳ OCR ಮಾಡುವುದು; ಇತರ ಕ್ಷೇತ್ರಗಳಿಗೆ (ಉದಾ. ಪೇಪರ್‌ಗಳು, ಆಡಿಯೋಬುಕ್‌ಗಳು, ಚಲನಚಿತ್ರಗಳು, ಟಿವಿ ಶೋಗಳು, ಮಾಗಜಿನ್‌ಗಳು) ಇದನ್ನು ಮಾಡುವುದು ಅಥವಾ ML / ದೊಡ್ಡ ಭಾಷಾ ಮಾದರಿ ತರಬೇತಿಗಾಗಿ ಈ ಡೇಟಾವನ್ನು ಲಭ್ಯವಾಗಿಸುವುದು — ದಯವಿಟ್ಟು ನನ್ನನ್ನು ಸಂಪರ್ಕಿಸಿ (<a %(reddit)s>Reddit</a>)."

#, fuzzy
msgid "blog.isbndb-dump.text17"
msgstr "ನೀವು ವಿಶೇಷವಾಗಿ ಡೇಟಾ ವಿಶ್ಲೇಷಣೆಯಲ್ಲಿ ಆಸಕ್ತರಾಗಿದ್ದರೆ, ನಾವು ನಮ್ಮ ಡೇಟಾಸೆಟ್‌ಗಳು ಮತ್ತು ಸ್ಕ್ರಿಪ್ಟ್‌ಗಳನ್ನು ಬಳಸಲು ಸುಲಭವಾದ ಸ್ವರೂಪದಲ್ಲಿ ಲಭ್ಯವಾಗಿಸಲು ಕೆಲಸ ಮಾಡುತ್ತಿದ್ದೇವೆ. ನೀವು ನೋಟ್ಬುಕ್ ಅನ್ನು ಫೋರ್ಕ್ ಮಾಡಿ ಇದನ್ನು ಆಡುವುದನ್ನು ಪ್ರಾರಂಭಿಸಿದರೆ ಅದ್ಭುತವಾಗುತ್ತದೆ."

#, fuzzy
msgid "blog.isbndb-dump.text18"
msgstr "ಕೊನೆಗೆ, ನೀವು ಈ ಕೆಲಸವನ್ನು ಬೆಂಬಲಿಸಲು ಬಯಸಿದರೆ, ದಯವಿಟ್ಟು ದೇಣಿಗೆ ನೀಡುವುದನ್ನು ಪರಿಗಣಿಸಿ. ಇದು ಸಂಪೂರ್ಣವಾಗಿ ಸ್ವಯಂಸೇವಕರಿಂದ ನಿರ್ವಹಿಸಲ್ಪಡುವ ಕಾರ್ಯಾಚರಣೆ, ಮತ್ತು ನಿಮ್ಮ ಕೊಡುಗೆ ದೊಡ್ಡ ವ್ಯತ್ಯಾಸವನ್ನು ಮಾಡುತ್ತದೆ. ಪ್ರತಿಯೊಂದು ಸಹಾಯ ಮಾಡುತ್ತದೆ. ಪ್ರಸ್ತುತ ನಾವು ಕ್ರಿಪ್ಟೋದಲ್ಲಿ ದೇಣಿಗೆಗಳನ್ನು ಸ್ವೀಕರಿಸುತ್ತೇವೆ; Anna’s Archive ನಲ್ಲಿ ದೇಣಿಗೆ ಪುಟವನ್ನು ನೋಡಿ."

