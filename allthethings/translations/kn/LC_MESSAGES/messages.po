#, fuzzy
msgid "blog.how-to.projects.metadata.text5"
msgstr "ನಾವು ಸಾಮಾನ್ಯವಾಗಿ ಇದನ್ನು ಎರಡು ಹಂತಗಳಲ್ಲಿ ಮಾಡುತ್ತೇವೆ. ಮೊದಲು ನಾವು ಕಚ್ಚಾ HTML ಫೈಲ್‌ಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡುತ್ತೇವೆ, ಸಾಮಾನ್ಯವಾಗಿ ನೇರವಾಗಿ MySQL ಗೆ (ಅನೇಕ ಸಣ್ಣ ಫೈಲ್‌ಗಳನ್ನು ತಪ್ಪಿಸಲು, ನಾವು ಕೆಳಗೆ ಹೆಚ್ಚು ಚರ್ಚಿಸುತ್ತೇವೆ). ನಂತರ, ಪ್ರತ್ಯೇಕ ಹಂತದಲ್ಲಿ, ನಾವು ಆ HTML ಫೈಲ್‌ಗಳನ್ನು ನಿಜವಾದ MySQL ಟೇಬಲ್‌ಗಳಿಗೆ ಪಾರ್ಸ್ ಮಾಡುತ್ತೇವೆ. ಈ ರೀತಿಯಾಗಿ ನೀವು ನಿಮ್ಮ ಪಾರ್ಸಿಂಗ್ ಕೋಡ್‌ನಲ್ಲಿ ದೋಷವನ್ನು ಕಂಡುಹಿಡಿದರೆ ಎಲ್ಲವನ್ನೂ ಪುನಃ ಡೌನ್‌ಲೋಡ್ ಮಾಡಬೇಕಾಗಿಲ್ಲ, ಏಕೆಂದರೆ ನೀವು ಹೊಸ ಕೋಡ್‌ನೊಂದಿಗೆ HTML ಫೈಲ್‌ಗಳನ್ನು ಪುನಃ ಪ್ರಕ್ರಿಯೆಗೊಳಿಸಬಹುದು. ಪ್ರಕ್ರಿಯೆ ಹಂತವನ್ನು ಸಮಾಂತರಗೊಳಿಸುವುದು ಸಹ ಸುಲಭವಾಗಿರುತ್ತದೆ, ಈ ಮೂಲಕ ಕೆಲವು ಸಮಯವನ್ನು ಉಳಿಸಬಹುದು (ಮತ್ತು ಸ್ಕ್ರೇಪಿಂಗ್ ನಡೆಯುತ್ತಿರುವಾಗ ನೀವು ಪ್ರಕ್ರಿಯೆ ಕೋಡ್ ಅನ್ನು ಬರೆಯಬಹುದು, ಎರಡೂ ಹಂತಗಳನ್ನು ಒಂದೇ ಬಾರಿಗೆ ಬರೆಯಬೇಕಾಗಿಲ್ಲ)."

#, fuzzy
msgid "blog.how-to.projects.metadata.text6"
msgstr "ಕೆಲವು ಗುರಿಗಳಿಗೆ ಮೆಟಾಡೇಟಾ ಸ್ಕ್ರಾಪಿಂಗ್ ಮಾತ್ರವೇ ಇದೆ ಎಂಬುದನ್ನು ಕೊನೆಗೆ ಗಮನಿಸಿ. ಅಲ್ಲಿ ಸರಿಯಾಗಿ ಸಂರಕ್ಷಿಸಲಾಗದ ಕೆಲವು ದೊಡ್ಡ ಮೆಟಾಡೇಟಾ ಸಂಗ್ರಹಗಳು ಇವೆ."

#, fuzzy
msgid "blog.how-to.projects.data"
msgstr "4. ಡೇಟಾ ಆಯ್ಕೆ"

#, fuzzy
msgid "blog.how-to.projects.data.text1"
msgstr "ನೀವು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಯುಕ್ತಿಯುಕ್ತ ಉಪಸಮೂಹವನ್ನು ಕಂಡುಹಿಡಿಯಲು ಮೆಟಾಡೇಟಾವನ್ನು ಬಳಸಬಹುದು. ನೀವು ಕೊನೆಗೆ ಎಲ್ಲಾ ಡೇಟಾವನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಬಯಸಿದರೂ, ನೀವು ಪತ್ತೆಯಾಗುವ ಮತ್ತು ರಕ್ಷಣೆಯನ್ನು ಸುಧಾರಿಸುವ ಸಾಧ್ಯತೆ ಇರುವುದರಿಂದ, ಅಥವಾ ನೀವು ಹೆಚ್ಚು ಡಿಸ್ಕ್‌ಗಳನ್ನು ಖರೀದಿಸಲು ಅಗತ್ಯವಿರುವುದರಿಂದ, ಅಥವಾ ನೀವು ಎಲ್ಲವನ್ನೂ ಡೌನ್‌ಲೋಡ್ ಮಾಡುವ ಮೊದಲು ನಿಮ್ಮ ಜೀವನದಲ್ಲಿ ಇನ್ನೇನಾದರೂ ಸಂಭವಿಸಬಹುದು ಎಂಬ ಕಾರಣದಿಂದಾಗಿ, ಮೊದಲಿಗೆ ಅತ್ಯಂತ ಮುಖ್ಯವಾದ ಐಟಂಗಳನ್ನು ಆದ್ಯತೆಯಾಗಿ ಪರಿಗಣಿಸುವುದು ಉಪಯುಕ್ತವಾಗಬಹುದು."

#, fuzzy
msgid "blog.how-to.projects.data.text2"
msgstr "ಉದಾಹರಣೆಗೆ, ಒಂದು ಸಂಗ್ರಹಣೆಯು ಅದೇ ಮೂಲ ಸಂಪತ್ತಿನ (ಪುಸ್ತಕ ಅಥವಾ ಚಲನಚಿತ್ರದಂತೆ) ಬಹು ಆವೃತ್ತಿಗಳನ್ನು ಹೊಂದಿರಬಹುದು, ಅಲ್ಲಿ ಒಂದು ಅತ್ಯುತ್ತಮ ಗುಣಮಟ್ಟದಂತೆ ಗುರುತಿಸಲಾಗಿದೆ. ಆ ಆವೃತ್ತಿಗಳನ್ನು ಮೊದಲು ಉಳಿಸುವುದು ಬಹಳ ಅರ್ಥಪೂರ್ಣವಾಗಿರುತ್ತದೆ. ಕೆಲವು ಸಂದರ್ಭಗಳಲ್ಲಿ ಮೆಟಾಡೇಟಾವನ್ನು ತಪ್ಪಾಗಿ ಟ್ಯಾಗ್ ಮಾಡಿರಬಹುದು, ಅಥವಾ ಆವೃತ್ತಿಗಳ ನಡುವೆ ತಿಳಿಯದ ವ್ಯತ್ಯಾಸಗಳು ಇರಬಹುದು (ಉದಾಹರಣೆಗೆ, \"ಅತ್ಯುತ್ತಮ ಆವೃತ್ತಿ\" ಬಹುಪಾಲು ರೀತಿಯಲ್ಲಿ ಉತ್ತಮವಾಗಿರಬಹುದು ಆದರೆ ಇತರ ರೀತಿಯಲ್ಲಿ ಕೆಟ್ಟದಾಗಿರಬಹುದು, ಉದಾಹರಣೆಗೆ, ಚಲನಚಿತ್ರವು ಹೆಚ್ಚಿನ ರೆಸಲ್ಯೂಶನ್ ಹೊಂದಿರಬಹುದು ಆದರೆ ಉಪಶೀರ್ಷಿಕೆಗಳನ್ನು ಕಳೆದುಕೊಂಡಿರಬಹುದು)."

#, fuzzy
msgid "blog.how-to.projects.data.text3"
msgstr "ನೀವು ನಿಮ್ಮ ಮೆಟಾಡೇಟಾ ಡೇಟಾಬೇಸ್ ಅನ್ನು ಹುಡುಕಲು ಮತ್ತು ಆಸಕ್ತಿದಾಯಕ ವಿಷಯಗಳನ್ನು ಕಂಡುಹಿಡಿಯಲು ಸಹ ಬಳಸಬಹುದು. ಅತಿದೊಡ್ಡ ಫೈಲ್ ಯಾವುದು ಮತ್ತು ಅದು ಏಕೆ ಅಷ್ಟು ದೊಡ್ಡದು? ಅತಿದೊಡ್ಡ ಫೈಲ್ ಯಾವುದು? ಕೆಲವು ವರ್ಗಗಳು, ಭಾಷೆಗಳು ಮತ್ತು ಇತರವುಗಳಿಗೆ ಸಂಬಂಧಿಸಿದಂತೆ ಆಸಕ್ತಿದಾಯಕ ಅಥವಾ ನಿರೀಕ್ಷಿತವಲ್ಲದ ಮಾದರಿಗಳು ಇದೆಯೇ? ನಕಲಿ ಅಥವಾ ಬಹಳ ಹೋಲುವ ಶೀರ್ಷಿಕೆಗಳಿವೆಯೇ? ಡೇಟಾವನ್ನು ಸೇರಿಸಿದಾಗ ಮಾದರಿಗಳು ಇದೆಯೇ, ಉದಾಹರಣೆಗೆ, ಒಂದು ದಿನದಲ್ಲಿ ಅನೇಕ ಫೈಲ್‌ಗಳನ್ನು ಒಂದೇ ಬಾರಿಗೆ ಸೇರಿಸಲಾಗಿದೆ? ಡೇಟಾಸೆಟ್ ಅನ್ನು ವಿಭಿನ್ನ ರೀತಿಯಲ್ಲಿ ನೋಡುವುದರಿಂದ ನೀವು ಬಹಳಷ್ಟು ಕಲಿಯಬಹುದು."

#, fuzzy
msgid "blog.how-to.projects.data.text4"
msgstr "ನಮ್ಮ ಪ್ರಕರಣದಲ್ಲಿ, ನಾವು Z-ಲೈಬ್ರರಿ ಪುಸ್ತಕಗಳನ್ನು ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್‌ನ md5 ಹ್ಯಾಶ್‌ಗಳ ವಿರುದ್ಧ ಡಿಡುಪ್ಲಿಕೇಟ್ ಮಾಡಿದ್ದೇವೆ, ಇದರಿಂದಾಗಿ ಬಹಳಷ್ಟು ಡೌನ್‌ಲೋಡ್ ಸಮಯ ಮತ್ತು ಡಿಸ್ಕ್ ಸ್ಥಳವನ್ನು ಉಳಿಸಿದ್ದೇವೆ. ಇದು ಬಹಳ ವಿಶಿಷ್ಟ ಪರಿಸ್ಥಿತಿ. ಬಹುಪಾಲು ಸಂದರ್ಭಗಳಲ್ಲಿ, ಸಹಪಾಠಿಗಳಿಂದ ಯಾವ ಫೈಲ್‌ಗಳನ್ನು ಈಗಾಗಲೇ ಸರಿಯಾಗಿ ಸಂರಕ್ಷಿಸಲಾಗಿದೆ ಎಂಬುದರ ಸಮಗ್ರ ಡೇಟಾಬೇಸ್‌ಗಳು ಇಲ್ಲ. ಇದು ಸ್ವತಃ ಯಾರಿಗಾದರೂ ದೊಡ್ಡ ಅವಕಾಶವಾಗಿದೆ. ಟೋರಂಟ್ ವೆಬ್‌ಸೈಟ್‌ಗಳಲ್ಲಿ ಈಗಾಗಲೇ ವ್ಯಾಪಕವಾಗಿ ಬೀಜಿತವಾಗಿರುವ ಸಂಗೀತ ಮತ್ತು ಚಲನಚಿತ್ರಗಳಂತಹ ವಿಷಯಗಳ ನಿಯಮಿತವಾಗಿ ನವೀಕರಿಸಲಾದ ಅವಲೋಕನವನ್ನು ಹೊಂದಿರುವುದು ಅದ್ಭುತವಾಗಿರುತ್ತದೆ, ಮತ್ತು ಆದ್ದರಿಂದ ಪೈರೇಟ್ ಮಿರರ್‌ಗಳಲ್ಲಿ ಸೇರಿಸಲು ಕಡಿಮೆ ಆದ್ಯತೆಯಾಗಿದೆ."

#, fuzzy
msgid "blog.how-to.projects.scraping"
msgstr "5. ಡೇಟಾ ಸ್ಕ್ರಾಪಿಂಗ್"

#, fuzzy
msgid "blog.how-to.projects.scraping.text1"
msgstr "ಈಗ ನೀವು ಡೇಟಾವನ್ನು ಸಮೂಹವಾಗಿ ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಸಿದ್ಧರಾಗಿದ್ದೀರಿ. ಹಿಂದಿನಂತೆ, ಈ ಹಂತದಲ್ಲಿ ನೀವು ಗುರಿಯ ವರ್ತನೆ ಮತ್ತು ನಿರ್ಬಂಧಗಳನ್ನು ಉತ್ತಮವಾಗಿ ಅರ್ಥಮಾಡಿಕೊಳ್ಳಲು ಕೆಲವು ಫೈಲ್‌ಗಳನ್ನು ಕೈಯಿಂದ ಡೌನ್‌ಲೋಡ್ ಮಾಡಿರಬೇಕು. ಆದರೆ, ನೀವು ಬಹಳಷ್ಟು ಫೈಲ್‌ಗಳನ್ನು ಒಂದೇ ಬಾರಿಗೆ ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಪ್ರಾರಂಭಿಸಿದಾಗ ಇನ್ನೂ ನಿಮಗೆ ಅಚ್ಚರಿಗಳು ಎದುರಾಗುತ್ತವೆ."

#, fuzzy
msgid "blog.how-to.projects.scraping.text2"
msgstr "ನಮ್ಮ ಸಲಹೆ ಇಲ್ಲಿದೆ ಮುಖ್ಯವಾಗಿ ಸರಳವಾಗಿರಿಸಲು. ಕೆಲವು ಫೈಲ್‌ಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡುವುದರಿಂದ ಪ್ರಾರಂಭಿಸಿ. ನೀವು ಪೈಥಾನ್ ಅನ್ನು ಬಳಸಬಹುದು, ನಂತರ ಬಹು ಥ್ರೆಡ್‌ಗಳಿಗೆ ವಿಸ್ತರಿಸಬಹುದು. ಆದರೆ ಕೆಲವೊಮ್ಮೆ ಡೇಟಾಬೇಸ್‌ನಿಂದ ನೇರವಾಗಿ ಬ್ಯಾಶ್ ಫೈಲ್‌ಗಳನ್ನು ರಚಿಸುವುದು ಮತ್ತು ನಂತರ ಅವುಗಳಲ್ಲಿ ಅನೇಕವನ್ನು ಅನೇಕ ಟರ್ಮಿನಲ್ ವಿಂಡೋಗಳಲ್ಲಿ ಚಲಾಯಿಸುವುದು ಇನ್ನೂ ಸರಳವಾಗಿದೆ. ಇಲ್ಲಿ ಉಲ್ಲೇಖಿಸಲು ಯೋಗ್ಯವಾದ ತ್ವರಿತ ತಾಂತ್ರಿಕ ತಂತ್ರ OUTFILE ಅನ್ನು MySQL ನಲ್ಲಿ ಬಳಸುವುದು, ನೀವು mysqld.cnf ನಲ್ಲಿ \"secure_file_priv\" ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಿದರೆ ಎಲ್ಲಿಯೂ ಬರೆಯಬಹುದು (ಮತ್ತು ನೀವು ಲಿನಕ್ಸ್‌ನಲ್ಲಿ ಇದ್ದರೆ AppArmor ಅನ್ನು ನಿಷ್ಕ್ರಿಯಗೊಳಿಸಲು/ಅತಿಕ್ರಮಿಸಲು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳಿ)."

#, fuzzy
msgid "blog.how-to.projects.scraping.text3"
msgstr "ನಾವು ಡೇಟಾವನ್ನು ಸರಳ ಹಾರ್ಡ್ ಡಿಸ್ಕ್‌ಗಳಲ್ಲಿ ಸಂಗ್ರಹಿಸುತ್ತೇವೆ. ನೀವು ಹೊಂದಿರುವುದರಿಂದ ಪ್ರಾರಂಭಿಸಿ, ಮತ್ತು ನಿಧಾನವಾಗಿ ವಿಸ್ತರಿಸಿ. ನೂರಾರು ಟಿಬಿಗಳ ಡೇಟಾವನ್ನು ಸಂಗ್ರಹಿಸುವ ಬಗ್ಗೆ ಯೋಚಿಸುವುದು ಭಾರವಾಗಿರಬಹುದು. ನೀವು ಎದುರಿಸುತ್ತಿರುವ ಪರಿಸ್ಥಿತಿ ಇದಾದರೆ, ಮೊದಲು ಉತ್ತಮ ಉಪಸಮೂಹವನ್ನು ಹೊರಹಾಕಿ, ಮತ್ತು ನಿಮ್ಮ ಘೋಷಣೆಯಲ್ಲಿ ಉಳಿದವುಗಳನ್ನು ಸಂಗ್ರಹಿಸಲು ಸಹಾಯಕ್ಕಾಗಿ ಕೇಳಿ. ನೀವು ಸ್ವತಃ ಹೆಚ್ಚು ಹಾರ್ಡ್ ಡ್ರೈವ್‌ಗಳನ್ನು ಪಡೆಯಲು ಬಯಸಿದರೆ, r/DataHoarder ನಲ್ಲಿ ಉತ್ತಮ ಒಪ್ಪಂದಗಳನ್ನು ಪಡೆಯಲು ಕೆಲವು ಉತ್ತಮ ಸಂಪತ್ತಿದೆ."

#, fuzzy
msgid "blog.how-to.projects.scraping.text4"
msgstr "ಆಕರ್ಷಕ ಫೈಲ್‌ಸಿಸ್ಟಮ್‌ಗಳ ಬಗ್ಗೆ ಹೆಚ್ಚು ಚಿಂತಿಸಬೇಡಿ. ZFS ನಂತಹ ವಿಷಯಗಳನ್ನು ಸ್ಥಾಪಿಸುವ ಕಣದ ರಂಧ್ರದಲ್ಲಿ ಬೀಳುವುದು ಸುಲಭ. ಆದರೆ ತಿಳಿಯಬೇಕಾದ ಒಂದು ತಾಂತ್ರಿಕ ವಿವರವೆಂದರೆ, ಅನೇಕ ಫೈಲ್‌ಗಳನ್ನು ಹೊಂದಿರುವ ಫೈಲ್‌ಸಿಸ್ಟಮ್‌ಗಳು ಚೆನ್ನಾಗಿ ನಿರ್ವಹಿಸುವುದಿಲ್ಲ. ನಾವು ಕಂಡುಹಿಡಿದ ಸರಳ ಪರಿಹಾರವೆಂದರೆ ವಿಭಿನ್ನ ಐಡಿ ಶ್ರೇಣಿಗಳು ಅಥವಾ ಹ್ಯಾಶ್ ಪ್ರಿಫಿಕ್ಸ್‌ಗಳಿಗೆ ಉದಾಹರಣೆಗೆ ಅನೇಕ ಡೈರೆಕ್ಟರಿಗಳನ್ನು ರಚಿಸುವುದು."

#, fuzzy
msgid "blog.how-to.projects.scraping.text5"
msgstr "ಡೇಟಾವನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿದ ನಂತರ, ಲಭ್ಯವಿದ್ದರೆ ಮೆಟಾಡೇಟಾದಲ್ಲಿ ಹ್ಯಾಶ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು ಫೈಲ್‌ಗಳ ಅಖಂಡತೆಯನ್ನು ಪರಿಶೀಲಿಸಿ."

#, fuzzy
msgid "blog.how-to.projects.distribution"
msgstr "6. ವಿತರಣಾ"

#, fuzzy
msgid "blog.how-to.projects.distribution.text1"
msgstr "ನಿಮ್ಮ ಬಳಿ ಡೇಟಾ ಇದೆ, ಇದರಿಂದಾಗಿ ನೀವು ವಿಶ್ವದ ಮೊದಲ ಪೈರೇಟ್ ಮಿರರ್ ಅನ್ನು ಹೊಂದಿದ್ದೀರಿ (ಬಹುಶಃ). ಅನೇಕ ರೀತಿಯಲ್ಲಿ ಕಠಿಣ ಭಾಗವು ಮುಗಿದಿದೆ, ಆದರೆ ಅತ್ಯಂತ ಅಪಾಯಕರ ಭಾಗವು ಇನ್ನೂ ನಿಮ್ಮ ಮುಂದೆ ಇದೆ. ಎಲ್ಲದಕ್ಕೂ, ಇದುವರೆಗೆ ನೀವು ಸುಳಿವಿಲ್ಲದೆ ಇದ್ದೀರಿ; ರಾಡಾರ್ ಅಡಿಯಲ್ಲಿ ಹಾರುತ್ತಿದೆ. ನೀವು ಮಾಡಬೇಕಾದದ್ದು ಒಳ್ಳೆಯ VPN ಅನ್ನು ಬಳಸುವುದು, ಯಾವುದೇ ಫಾರ್ಮ್‌ಗಳಲ್ಲಿ ನಿಮ್ಮ ವೈಯಕ್ತಿಕ ವಿವರಗಳನ್ನು ತುಂಬದಿರುವುದು (ಅರೇ), ಮತ್ತು ಬಹುಶಃ ವಿಶೇಷ ಬ್ರೌಸರ್ ಸೆಷನ್ (ಅಥವಾ ವಿಭಿನ್ನ ಕಂಪ್ಯೂಟರ್) ಅನ್ನು ಬಳಸುವುದು."

#, fuzzy
msgid "blog.how-to.projects.distribution.text2"
msgstr "ಈಗ ನೀವು ಡೇಟಾವನ್ನು ವಿತರಿಸಬೇಕು. ನಮ್ಮ ಪ್ರಕರಣದಲ್ಲಿ ನಾವು ಮೊದಲು ಪುಸ್ತಕಗಳನ್ನು ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್‌ಗೆ ಹಿಂತಿರುಗಿಸಲು ಕೊಡುಗೆ ನೀಡಲು ಬಯಸಿದ್ದೇವೆ, ಆದರೆ ಅದರಲ್ಲಿ ಕಷ್ಟಗಳನ್ನು ಶೀಘ್ರದಲ್ಲೇ ಕಂಡುಹಿಡಿದಿದ್ದೇವೆ (ಕಾಲ್ಪನಿಕ vs ಅಕಾಲ್ಪನಿಕ ವಿಂಗಡಣೆ). ಆದ್ದರಿಂದ ನಾವು ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್ ಶೈಲಿಯ ಟೋರಂಟ್‌ಗಳನ್ನು ಬಳಸಿಕೊಂಡು ವಿತರಣೆಯನ್ನು ನಿರ್ಧರಿಸಿದ್ದೇವೆ. ನೀವು ಈಗಾಗಲೇ ಇರುವ ಯೋಜನೆಗೆ ಕೊಡುಗೆ ನೀಡಲು ಅವಕಾಶವಿದ್ದರೆ, ಅದು ನಿಮಗೆ ಬಹಳಷ್ಟು ಸಮಯವನ್ನು ಉಳಿಸಬಹುದು. ಆದರೆ, ಪ್ರಸ್ತುತ ಅಲ್ಲಿ ಬಹಳಷ್ಟು ಚೆನ್ನಾಗಿ ಸಂಘಟಿತ ಪೈರೇಟ್ ಮಿರರ್‌ಗಳು ಇಲ್ಲ."

#, fuzzy
msgid "blog.how-to.projects.distribution.text3"
msgstr "ಹಾಗಾದರೆ ನೀವು ಟೋರಂಟ್‌ಗಳನ್ನು ಸ್ವತಃ ವಿತರಿಸಲು ನಿರ್ಧರಿಸುತ್ತೀರಿ ಎಂದು ಹೇಳೋಣ. ಆ ಫೈಲ್‌ಗಳನ್ನು ಸಣ್ಣಗಾಗಿಡಲು ಪ್ರಯತ್ನಿಸಿ, ಅವುಗಳನ್ನು ಇತರ ವೆಬ್‌ಸೈಟ್‌ಗಳಲ್ಲಿ ಮಿರರ್ ಮಾಡಲು ಸುಲಭವಾಗಿರುತ್ತದೆ. ನೀವು ಟೋರಂಟ್‌ಗಳನ್ನು ಸ್ವತಃ ಬೀಜಿಸಲು, ಇನ್ನೂ ಅನಾಮಿಕವಾಗಿಯೇ ಉಳಿಯಬೇಕು. ನೀವು VPN ಅನ್ನು ಬಳಸಬಹುದು (ಪೋರ್ಟ್ ಫಾರ್ವರ್ಡಿಂಗ್‌ನೊಂದಿಗೆ ಅಥವಾ ಇಲ್ಲದೆ), ಅಥವಾ ಟಂಬಲ್ ಮಾಡಿದ ಬಿಟ್‌ಕಾಯಿನ್‌ಗಳೊಂದಿಗೆ ಸೀಡ್ಬಾಕ್ಸ್‌ಗೆ ಪಾವತಿಸಬಹುದು. ಆ ಪದಗಳ ಅರ್ಥವನ್ನು ನೀವು ತಿಳಿಯದಿದ್ದರೆ, ನೀವು ಓದಲು ಬಹಳಷ್ಟು ಹೊಂದಿರುತ್ತೀರಿ, ಏಕೆಂದರೆ ಇಲ್ಲಿ ಅಪಾಯದ ವ್ಯತ್ಯಾಸಗಳನ್ನು ನೀವು ಅರ್ಥಮಾಡಿಕೊಳ್ಳುವುದು ಮುಖ್ಯ."

#, fuzzy
msgid "blog.how-to.projects.distribution.text4"
msgstr "ನೀವು ಟೋರಂಟ್ ಫೈಲ್‌ಗಳನ್ನು ಈಗಾಗಲೇ ಇರುವ ಟೋರಂಟ್ ವೆಬ್‌ಸೈಟ್‌ಗಳಲ್ಲಿ ಹೋಸ್ಟ್ ಮಾಡಬಹುದು. ನಮ್ಮ ಪ್ರಕರಣದಲ್ಲಿ, ನಾವು ವಾಸ್ತವವಾಗಿ ಒಂದು ವೆಬ್‌ಸೈಟ್ ಅನ್ನು ಹೋಸ್ಟ್ ಮಾಡಲು ಆಯ್ಕೆ ಮಾಡಿದ್ದೇವೆ, ಏಕೆಂದರೆ ನಾವು ನಮ್ಮ ತತ್ವಶಾಸ್ತ್ರವನ್ನು ಸ್ಪಷ್ಟವಾಗಿ ಹಂಚಲು ಬಯಸಿದ್ದೇವೆ. ನೀವು ಇದನ್ನು ಸ್ವತಃ ಹೋಲುವ ರೀತಿಯಲ್ಲಿ ಮಾಡಬಹುದು (ನಾವು ನಮ್ಮ ಡೊಮೇನ್‌ಗಳು ಮತ್ತು ಹೋಸ್ಟಿಂಗ್‌ಗಾಗಿ Njalla ಅನ್ನು ಬಳಸುತ್ತೇವೆ, ಟಂಬಲ್ ಮಾಡಿದ ಬಿಟ್‌ಕಾಯಿನ್‌ಗಳೊಂದಿಗೆ ಪಾವತಿಸಲಾಗಿದೆ), ಆದರೆ ನಿಮ್ಮ ಟೋರಂಟ್‌ಗಳನ್ನು ಹೋಸ್ಟ್ ಮಾಡಲು ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಲು ಮುಕ್ತವಾಗಿರಿ. ಈ ಆಲೋಚನೆ ಹಿಡಿದರೆ, ನಾವು ಸಮಯದೊಂದಿಗೆ ಪೈರೇಟ್ ಮಿರರ್‌ಗಳ ಸಮಗ್ರ ಸೂಚಿಯನ್ನು ನಿರ್ಮಿಸಲು ನೋಡುತ್ತಿದ್ದೇವೆ."

#, fuzzy
msgid "blog.how-to.projects.distribution.text5"
msgstr "VPN ಆಯ್ಕೆಗಾಗಿ, ಇದಕ್ಕಾಗಿ ಈಗಾಗಲೇ ಬಹಳಷ್ಟು ಬರೆಯಲಾಗಿದೆ, ಆದ್ದರಿಂದ ನಾವು ಖ್ಯಾತಿಯ ಮೂಲಕ ಆಯ್ಕೆ ಮಾಡುವ ಸಾಮಾನ್ಯ ಸಲಹೆಯನ್ನು ಪುನರಾವರ್ತಿಸುತ್ತೇವೆ. ಖಾಸಗಿತನವನ್ನು ರಕ್ಷಿಸುವ ದೀರ್ಘಕಾಲದ ದಾಖಲೆಗಳೊಂದಿಗೆ ನ್ಯಾಯಾಲಯ-ಪರೀಕ್ಷಿತ ಲಾಗ್-ರಹಿತ ನೀತಿಗಳು ನಮ್ಮ ಅಭಿಪ್ರಾಯದಲ್ಲಿ ಕಡಿಮೆ ಅಪಾಯದ ಆಯ್ಕೆಯಾಗಿದೆ. ನೀವು ಎಲ್ಲವನ್ನೂ ಸರಿಯಾಗಿ ಮಾಡಿದಾಗಲೂ, ನೀವು ಶೂನ್ಯ ಅಪಾಯಕ್ಕೆ ತಲುಪಲು ಸಾಧ್ಯವಿಲ್ಲ ಎಂಬುದನ್ನು ಗಮನಿಸಿ. ಉದಾಹರಣೆಗೆ, ನಿಮ್ಮ ಟೋರಂಟ್‌ಗಳನ್ನು ಬೀಜಿಸುವಾಗ, ಅತ್ಯಂತ ಪ್ರೇರಿತ ರಾಷ್ಟ್ರ-ರಾಜ್ಯ ನಟವು VPN ಸರ್ವರ್‌ಗಳಿಗಾಗಿ ಒಳಬರುವ ಮತ್ತು ಹೊರಹೋಗುವ ಡೇಟಾ ಹರಿವುಗಳನ್ನು ನೋಡಬಹುದು ಮತ್ತು ನೀವು ಯಾರು ಎಂಬುದನ್ನು ಊಹಿಸಬಹುದು. ಅಥವಾ ನೀವು ಹೇಗಾದರೂ ತಪ್ಪು ಮಾಡಬಹುದು. ನಾವು ಈಗಾಗಲೇ ಮಾಡಿದ್ದೇವೆ, ಮತ್ತು ಮತ್ತೆ ಮಾಡುತ್ತೇವೆ. ಅದೃಷ್ಟವಶಾತ್, ರಾಷ್ಟ್ರ ರಾಜ್ಯಗಳು ಪೈರಸಿ ಬಗ್ಗೆ <em>ಅಷ್ಟು</em> ಕಾಳಜಿ ವಹಿಸುತ್ತಿಲ್ಲ."

#, fuzzy
msgid "blog.how-to.projects.distribution.text6"
msgstr "ಪ್ರತಿ ಯೋಜನೆಗಾಗಿ ಒಂದು ನಿರ್ಧಾರವನ್ನು ತೆಗೆದುಕೊಳ್ಳುವುದು, ಅದನ್ನು ಹಿಂದಿನಂತೆ ಅದೇ ಗುರುತಿನೊಂದಿಗೆ ಪ್ರಕಟಿಸಬೇಕೇ ಅಥವಾ ಬೇಡವೇ ಎಂಬುದು. ನೀವು ಅದೇ ಹೆಸರನ್ನು ಬಳಸುತ್ತಾ ಮುಂದುವರಿದರೆ, ಹಿಂದಿನ ಯೋಜನೆಗಳಿಂದ ಕಾರ್ಯಾಚರಣಾ ಭದ್ರತಾ ದೋಷಗಳು ನಿಮ್ಮನ್ನು ಕಚ್ಚಬಹುದು. ಆದರೆ ವಿಭಿನ್ನ ಹೆಸರಿನ ಅಡಿಯಲ್ಲಿ ಪ್ರಕಟಿಸುವುದು ಎಂದರೆ ನೀವು ದೀರ್ಘಕಾಲದ ಖ್ಯಾತಿಯನ್ನು ನಿರ್ಮಿಸುವುದಿಲ್ಲ. ನಾವು ಪ್ರಾರಂಭದಿಂದಲೂ ಬಲವಾದ ಕಾರ್ಯಾಚರಣಾ ಭದ್ರತೆಯನ್ನು ಹೊಂದಿದ್ದೇವೆ, ಆದ್ದರಿಂದ ನಾವು ಅದೇ ಗುರುತನ್ನು ಬಳಸುತ್ತಾ ಮುಂದುವರಿಯಬಹುದು, ಆದರೆ ನಾವು ತಪ್ಪು ಮಾಡಿದರೆ ಅಥವಾ ಪರಿಸ್ಥಿತಿಗಳು ಅದನ್ನು ಕೋರಿದರೆ ವಿಭಿನ್ನ ಹೆಸರಿನ ಅಡಿಯಲ್ಲಿ ಪ್ರಕಟಿಸಲು ಹಿಂಜರಿಯುವುದಿಲ್ಲ."

#, fuzzy
msgid "blog.how-to.projects.distribution.text7"
msgstr "ಶಬ್ದವನ್ನು ಹೊರತರುವುದನ್ನು ಪಡೆಯುವುದು ಕಷ್ಟಕರವಾಗಬಹುದು. ನಾವು ಹೇಳಿದಂತೆ, ಇದು ಇನ್ನೂ ಒಂದು ನಿಶ್ ಸಮುದಾಯವಾಗಿದೆ. ನಾವು ಮೂಲತಃ ರೆಡ್ಡಿಟ್‌ನಲ್ಲಿ ಪೋಸ್ಟ್ ಮಾಡಿದ್ದೇವೆ, ಆದರೆ ವಾಸ್ತವವಾಗಿ ಹ್ಯಾಕರ್ ನ್ಯೂಸ್‌ನಲ್ಲಿ ಆಕರ್ಷಣೆ ಪಡೆದಿದ್ದೇವೆ. ಪ್ರಸ್ತುತ ನಮ್ಮ ಶಿಫಾರಸು ಕೆಲವು ಸ್ಥಳಗಳಲ್ಲಿ ಅದನ್ನು ಪೋಸ್ಟ್ ಮಾಡುವುದು ಮತ್ತು ಏನಾಗುತ್ತದೆ ಎಂಬುದನ್ನು ನೋಡುವುದು. ಮತ್ತು ಮತ್ತೆ, ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಿ. ಹೆಚ್ಚು ಪೈರೇಟ್ ಆರ್ಕೈವಿಸಮ್ ಪ್ರಯತ್ನಗಳ ಶಬ್ದವನ್ನು ಹಂಚಲು ನಾವು ಇಷ್ಟಪಡುತ್ತೇವೆ."

#, fuzzy
msgid "blog.how-to.conclusion"
msgstr "ತೀರ್ಮಾನ"

#, fuzzy
msgid "blog.how-to.conclusion.text1"
msgstr "ಈ ಹೊಸದಾಗಿ ಪ್ರಾರಂಭಿಸುತ್ತಿರುವ ಪೈರೇಟ್ ಆರ್ಕೈವಿಸ್ಟ್‌ಗಳಿಗೆ ಇದು ಸಹಾಯಕವಾಗುತ್ತದೆ ಎಂದು ಆಶಿಸುತ್ತೇವೆ. ಈ ಜಗತ್ತಿಗೆ ನಿಮ್ಮನ್ನು ಸ್ವಾಗತಿಸಲು ನಾವು ಉತ್ಸುಕರಾಗಿದ್ದೇವೆ, ಆದ್ದರಿಂದ ಸಂಪರ್ಕಿಸಲು ಹಿಂಜರಿಯಬೇಡಿ. ಜಗತ್ತಿನ ಜ್ಞಾನ ಮತ್ತು ಸಂಸ್ಕೃತಿಯನ್ನು ಸಾಧ್ಯವಾದಷ್ಟು ಉಳಿಸೋಣ ಮತ್ತು ಅದನ್ನು ವ್ಯಾಪಕವಾಗಿ ಪ್ರತಿಬಿಂಬಿಸೋಣ."

#, fuzzy
msgid "blog.how-to.signature"
msgstr "- ಅಣ್ಣಾ ಮತ್ತು ತಂಡ (<a %(reddit)s>Reddit</a>)"

#, fuzzy
msgid "blog.introducing.title"
msgstr "ಪೈರೇಟ್ ಲೈಬ್ರರಿ ಮಿರರ್ ಪರಿಚಯ: 7TB ಪುಸ್ತಕಗಳನ್ನು ಉಳಿಸುವುದು (ಅವು Libgen ನಲ್ಲಿ ಇಲ್ಲ)"

#, fuzzy
msgid "blog.introducing.text1"
msgstr "ಈ ಯೋಜನೆ (<a %(wikipedia_annas_archive)s>ಅನ್ನಾ’ಸ್ ಆರ್ಕೈವ್</a> ಗೆ ಸ್ಥಳಾಂತರಿಸಲಾಗಿದೆ) ಮಾನವ ಜ್ಞಾನವನ್ನು ಉಳಿಸುವ ಮತ್ತು ಬಿಡುಗಡೆ ಮಾಡುವಲ್ಲಿ ಸಹಾಯ ಮಾಡಲು ಉದ್ದೇಶಿಸಿದೆ. ನಮ್ಮ ಮುಂಚಿನ ಮಹಾನ್ ವ್ಯಕ್ತಿಗಳ ಹೆಜ್ಜೆಗುರುತುಗಳಲ್ಲಿ, ನಾವು ನಮ್ಮ ಸಣ್ಣ ಮತ್ತು ವಿನಮ್ರ ಕೊಡುಗೆಯನ್ನು ಮಾಡುತ್ತೇವೆ."

#, fuzzy
msgid "blog.introducing.text2"
msgstr "ಈ ಯೋಜನೆಯ ಗಮನವನ್ನು ಅದರ ಹೆಸರಿನಿಂದ ವಿವರಿಸಲಾಗಿದೆ:"

#, fuzzy
msgid "blog.introducing.focus.pirate"
msgstr "<strong>ಪೈರೇಟ್</strong> - ನಾವು ಬಹುತೇಕ ದೇಶಗಳಲ್ಲಿ ಕಾಪಿರೈಟ್ ಕಾನೂನನ್ನು ಉದ್ದೇಶಪೂರ್ವಕವಾಗಿ ಉಲ್ಲಂಘಿಸುತ್ತೇವೆ. ಇದು ನಮಗೆ ಕಾನೂನಾತ್ಮಕ ಸಂಸ್ಥೆಗಳು ಮಾಡಲಾರದ ಕೆಲಸವನ್ನು ಮಾಡಲು ಅವಕಾಶ ನೀಡುತ್ತದೆ: ಪುಸ್ತಕಗಳನ್ನು ವ್ಯಾಪಕವಾಗಿ ಪ್ರತಿಬಿಂಬಿಸುವುದನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳುವುದು."

#, fuzzy
msgid "blog.introducing.focus.library"
msgstr "<strong>ಲೈಬ್ರರಿ</strong> - ಹೆಚ್ಚಿನ ಗ್ರಂಥಾಲಯಗಳಂತೆ, ನಾವು ಮುಖ್ಯವಾಗಿ ಪುಸ್ತಕಗಳಂತಹ ಲಿಖಿತ ವಸ್ತುಗಳ ಮೇಲೆ ಗಮನಹರಿಸುತ್ತೇವೆ. ಭವಿಷ್ಯದಲ್ಲಿ ನಾವು ಇತರ ಮಾಧ್ಯಮಗಳಲ್ಲಿಯೂ ವಿಸ್ತರಿಸಬಹುದು."

#, fuzzy
msgid "blog.introducing.focus.mirror"
msgstr "<strong>ಮಿರರ್</strong> - ನಾವು ಅಸ್ತಿತ್ವದಲ್ಲಿರುವ ಗ್ರಂಥಾಲಯಗಳ ಕಠಿಣ ಪ್ರತಿಬಿಂಬ. ನಾವು ಸಂರಕ್ಷಣೆಯ ಮೇಲೆ ಗಮನಹರಿಸುತ್ತೇವೆ, ಪುಸ್ತಕಗಳನ್ನು ಸುಲಭವಾಗಿ ಹುಡುಕಲು ಮತ್ತು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು (ಪ್ರವೇಶ) ಅಥವಾ ಹೊಸ ಪುಸ್ತಕಗಳನ್ನು ಕೊಡುಗೆ ಮಾಡುವ ಜನರ ದೊಡ್ಡ ಸಮುದಾಯವನ್ನು ಬೆಳೆಸಲು (ಮೂಲಸಾಧನೆ) ಅಲ್ಲ."

#, fuzzy
msgid "blog.introducing.text3"
msgstr "ನಾವು ಪ್ರತಿಬಿಂಬಿಸಿದ ಮೊದಲ ಗ್ರಂಥಾಲಯ Z-ಲೈಬ್ರರಿ. ಇದು ಜನಪ್ರಿಯ (ಮತ್ತು ಅಕ್ರಮ) ಗ್ರಂಥಾಲಯ. ಅವರು ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್ ಸಂಗ್ರಹವನ್ನು ತೆಗೆದುಕೊಂಡು ಅದನ್ನು ಸುಲಭವಾಗಿ ಹುಡುಕಲು ಮಾಡಿದರು. ಅದಕ್ಕಿಂತ ಹೆಚ್ಚಾಗಿ, ಅವರು ಹೊಸ ಪುಸ್ತಕ ಕೊಡುಗೆಗಳನ್ನು ಪ್ರೋತ್ಸಾಹಿಸುವ ಮೂಲಕ ಹೊಸ ಪುಸ್ತಕ ಕೊಡುಗೆಗಳನ್ನು ಕೇಳುವಲ್ಲಿ ಬಹಳ ಪರಿಣಾಮಕಾರಿಯಾಗಿದ್ದಾರೆ. ಅವರು ಪ್ರಸ್ತುತ ಈ ಹೊಸ ಪುಸ್ತಕಗಳನ್ನು ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್‌ಗೆ ಹಿಂದಿರುಗಿಸುವುದಿಲ್ಲ. ಮತ್ತು ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್‌ನಂತೆ, ಅವರು ತಮ್ಮ ಸಂಗ್ರಹವನ್ನು ಸುಲಭವಾಗಿ ಪ್ರತಿಬಿಂಬಿಸಲು ಮಾಡುತ್ತಿಲ್ಲ, ಇದು ವ್ಯಾಪಕ ಸಂರಕ್ಷಣೆಯನ್ನು ತಡೆಯುತ್ತದೆ. ಇದು ಅವರ ವ್ಯವಹಾರ ಮಾದರಿಗಾಗಿ ಮುಖ್ಯವಾಗಿದೆ, ಏಕೆಂದರೆ ಅವರು ತಮ್ಮ ಸಂಗ್ರಹವನ್ನು ಸಮೂಹವಾಗಿ (ದಿನಕ್ಕೆ 10 ಕ್ಕಿಂತ ಹೆಚ್ಚು ಪುಸ್ತಕ) ಪ್ರವೇಶಿಸಲು ಹಣವನ್ನು ವಸೂಲಿಸುತ್ತಾರೆ."

#, fuzzy
msgid "blog.introducing.text4"
msgstr "ನಾವು ಅಕ್ರಮ ಪುಸ್ತಕ ಸಂಗ್ರಹಣೆಗೆ ಬೃಹತ್ ಪ್ರವೇಶಕ್ಕಾಗಿ ಹಣ ವಸೂಲಿಸುವುದರ ಬಗ್ಗೆ ನೈತಿಕ ತೀರ್ಮಾನಗಳನ್ನು ಮಾಡುವುದಿಲ್ಲ. ಜಡ್-ಲೈಬ್ರರಿ ಜ್ಞಾನವನ್ನು ವಿಸ್ತರಿಸುವಲ್ಲಿ ಮತ್ತು ಹೆಚ್ಚಿನ ಪುಸ್ತಕಗಳನ್ನು ಪೂರೈಸುವಲ್ಲಿ ಯಶಸ್ವಿಯಾಗಿದೆ ಎಂಬುದು ಅನುಮಾನವಿಲ್ಲ. ನಾವು ನಮ್ಮ ಭಾಗವನ್ನು ಮಾಡಲು ಇಲ್ಲಿ ಇದ್ದೇವೆ: ಈ ಖಾಸಗಿ ಸಂಗ್ರಹಣೆಯ ದೀರ್ಘಕಾಲಿಕ ಸಂರಕ್ಷಣೆಯನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳುವುದು."

#, fuzzy
msgid "blog.introducing.text5"
msgstr "ನೀವು ನಮ್ಮ ಟೋರಂಟ್‌ಗಳನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಿ ಸೀಡ್ ಮಾಡುವ ಮೂಲಕ ಮಾನವ ಜ್ಞಾನವನ್ನು ಉಳಿಸಲು ಮತ್ತು ಬಿಡುಗಡೆ ಮಾಡಲು ಸಹಾಯ ಮಾಡಲು ನಾವು ನಿಮ್ಮನ್ನು ಆಹ್ವಾನಿಸಲು ಇಚ್ಛಿಸುತ್ತೇವೆ. ಡೇಟಾವನ್ನು ಹೇಗೆ ಸಂಘಟಿಸಲಾಗಿದೆ ಎಂಬುದರ ಬಗ್ಗೆ ಹೆಚ್ಚಿನ ಮಾಹಿತಿಗಾಗಿ ಯೋಜನೆ ಪುಟವನ್ನು ನೋಡಿ."

#, fuzzy
msgid "blog.introducing.text6"
msgstr "ನೀವು ಯಾವ ಸಂಗ್ರಹಗಳನ್ನು ಮುಂದಿನದಾಗಿ ಪ್ರತಿಬಿಂಬಿಸಬೇಕು ಮತ್ತು ಅದನ್ನು ಹೇಗೆ ಮಾಡಬೇಕು ಎಂಬುದರ ಬಗ್ಗೆ ನಿಮ್ಮ ಆಲೋಚನೆಗಳನ್ನು ಕೊಡುಗೆ ಮಾಡಲು ನಾವು ನಿಮ್ಮನ್ನು ಬಹಳವಾಗಿ ಆಹ್ವಾನಿಸುತ್ತೇವೆ. ಒಟ್ಟಾಗಿ ನಾವು ಬಹಳಷ್ಟು ಸಾಧಿಸಬಹುದು. ಇದು ಅನೇಕ ಇತರರ ನಡುವೆ ಕೇವಲ ಒಂದು ಸಣ್ಣ ಕೊಡುಗೆ. ನೀವು ಮಾಡುವ ಎಲ್ಲದರಿಗೂ ಧನ್ಯವಾದಗಳು."

#, fuzzy
msgid "blog.introducing.signature"
msgstr "- ಅಣ್ಣಾ ಮತ್ತು ತಂಡ (<a %(reddit)s>Reddit</a>)"

