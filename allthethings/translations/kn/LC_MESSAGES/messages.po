#, fuzzy
msgid "blog.3x-new-books.text1"
msgstr "ಪೈರೇಟ್ ಲೈಬ್ರರಿ ಮಿರರ್‌ನ ಮೂಲ ಬಿಡುಗಡೆ (ತಿದ್ದುಪಡಿ: <a %(wikipedia_annas_archive)s>ಅನ್ನಾ’ಸ್ ಆರ್ಕೈವ್</a> ಗೆ ಸ್ಥಳಾಂತರಿಸಲಾಗಿದೆ) ನಲ್ಲಿ, ನಾವು Z-ಲೈಬ್ರರಿಯ ಮಿರರ್ ಮಾಡಿದ್ದೇವೆ, ಇದು ದೊಡ್ಡ ಅಕ್ರಮ ಪುಸ್ತಕ ಸಂಗ್ರಹ. ಸ್ಮರಣಾರ್ಥವಾಗಿ, ನಾವು ಆ ಮೂಲ ಬ್ಲಾಗ್ ಪೋಸ್ಟ್‌ನಲ್ಲಿ ಬರೆದಿದ್ದೇನು:"

#, fuzzy
msgid "blog.3x-new-books.q1.text1"
msgstr "Z-ಲೈಬ್ರರಿ ಒಂದು ಜನಪ್ರಿಯ (ಮತ್ತು ಅಕ್ರಮ) ಗ್ರಂಥಾಲಯ. ಅವರು ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್ ಸಂಗ್ರಹವನ್ನು ತೆಗೆದುಕೊಂಡು ಅದನ್ನು ಸುಲಭವಾಗಿ ಹುಡುಕಬಹುದಾಗಿದೆ. ಅದಕ್ಕಿಂತ ಹೆಚ್ಚಾಗಿ, ಅವರು ಹೊಸ ಪುಸ್ತಕ ಕೊಡುಗೆಗಳನ್ನು ಪ್ರೋತ್ಸಾಹಿಸುವ ಮೂಲಕ ಹೊಸ ಪುಸ್ತಕ ಕೊಡುಗೆಗಳನ್ನು ಬಹಳ ಪರಿಣಾಮಕಾರಿಯಾಗಿ ಕೇಳಿಕೊಳ್ಳುತ್ತಿದ್ದಾರೆ. ಅವರು ಪ್ರಸ್ತುತ ಈ ಹೊಸ ಪುಸ್ತಕಗಳನ್ನು ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್‌ಗೆ ಹಿಂದಿರುಗಿಸುವುದಿಲ್ಲ. ಮತ್ತು ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್‌ನಂತೆ, ಅವರು ತಮ್ಮ ಸಂಗ್ರಹವನ್ನು ಸುಲಭವಾಗಿ ಮಿರರ್ ಮಾಡಬಹುದಾದಂತೆ ಮಾಡುವುದಿಲ್ಲ, ಇದು ವ್ಯಾಪಕ ಸಂರಕ್ಷಣೆಯನ್ನು ತಡೆಯುತ್ತದೆ. ಇದು ಅವರ ವ್ಯವಹಾರ ಮಾದರಿಗಾಗಿ ಮುಖ್ಯವಾಗಿದೆ, ಏಕೆಂದರೆ ಅವರು ತಮ್ಮ ಸಂಗ್ರಹವನ್ನು ಸಮೂಹವಾಗಿ ಪ್ರವೇಶಿಸಲು (ದಿನಕ್ಕೆ 10 ಕ್ಕಿಂತ ಹೆಚ್ಚು ಪುಸ್ತಕಗಳು) ಹಣವನ್ನು ವಸೂಲಿಸುತ್ತಾರೆ."

#, fuzzy
msgid "blog.3x-new-books.q1.text2"
msgstr "ನಾವು ಅಕ್ರಮ ಪುಸ್ತಕ ಸಂಗ್ರಹಣೆಗೆ ಬೃಹತ್ ಪ್ರವೇಶಕ್ಕಾಗಿ ಹಣ ವಸೂಲಿಸುವುದರ ಬಗ್ಗೆ ನೈತಿಕ ತೀರ್ಮಾನಗಳನ್ನು ಮಾಡುವುದಿಲ್ಲ. ಜಡ್-ಲೈಬ್ರರಿ ಜ್ಞಾನವನ್ನು ವಿಸ್ತರಿಸುವಲ್ಲಿ ಮತ್ತು ಹೆಚ್ಚಿನ ಪುಸ್ತಕಗಳನ್ನು ಪೂರೈಸುವಲ್ಲಿ ಯಶಸ್ವಿಯಾಗಿದೆ ಎಂಬುದು ಅನುಮಾನವಿಲ್ಲ. ನಾವು ನಮ್ಮ ಭಾಗವನ್ನು ಮಾಡಲು ಇಲ್ಲಿ ಇದ್ದೇವೆ: ಈ ಖಾಸಗಿ ಸಂಗ್ರಹಣೆಯ ದೀರ್ಘಕಾಲಿಕ ಸಂರಕ್ಷಣೆಯನ್ನು ಖಚಿತಪಡಿಸಿಕೊಳ್ಳುವುದು."

#, fuzzy
msgid "blog.3x-new-books.text2"
msgstr "ಆ ಸಂಗ್ರಹಣೆ 2021ರ ಮಧ್ಯಭಾಗದಿಂದ ಪ್ರಾರಂಭವಾಯಿತು. ಈ ನಡುವೆ, ಜಡ್-ಲೈಬ್ರರಿ ಅಚ್ಚರಿಯ ವೇಗದಲ್ಲಿ ಬೆಳೆಯುತ್ತಿದೆ: ಅವರು ಸುಮಾರು 3.8 ಮಿಲಿಯನ್ ಹೊಸ ಪುಸ್ತಕಗಳನ್ನು ಸೇರಿಸಿದ್ದಾರೆ. ಅಲ್ಲಿ ಕೆಲವು ನಕಲುಗಳು ಇದ್ದರೂ, ಬಹುಮತವು ನಿಜವಾಗಿಯೂ ಹೊಸ ಪುಸ್ತಕಗಳು ಅಥವಾ ಹಿಂದಿನ ಸಲ್ಲಿಸಿದ ಪುಸ್ತಕಗಳ ಉತ್ತಮ ಗುಣಮಟ್ಟದ ಸ್ಕ್ಯಾನ್‌ಗಳಾಗಿವೆ. ಇದು ಬಹುಪಾಲು ಜಡ್-ಲೈಬ್ರರಿಯ ಸ್ವಯಂಸೇವಕ ನಿರ್ವಾಹಕರ ಸಂಖ್ಯೆಯ ಹೆಚ್ಚಳ ಮತ್ತು ಅವರ ನಕಲು ನಿವಾರಣಾ ವ್ಯವಸ್ಥೆಯ ಕಾರಣವಾಗಿದೆ. ಈ ಸಾಧನೆಗಳಿಗೆ ನಾವು ಅವರಿಗೆ ಅಭಿನಂದನೆ ಸಲ್ಲಿಸುತ್ತೇವೆ."

#, fuzzy
msgid "blog.3x-new-books.text3"
msgstr "ನಾವು ಜಡ್-ಲೈಬ್ರರಿಯಲ್ಲಿನ ನಮ್ಮ ಕೊನೆಯ ಮಿರರ್ ಮತ್ತು 2022ರ ಆಗಸ್ಟ್ ನಡುವೆ ಸೇರಿಸಿದ ಎಲ್ಲಾ ಪುಸ್ತಕಗಳನ್ನು ಪಡೆದಿದ್ದೇವೆ ಎಂದು ಘೋಷಿಸಲು ಸಂತೋಷವಾಗುತ್ತಿದೆ. ನಾವು ಮೊದಲ ಬಾರಿಗೆ ತಪ್ಪಿಸಿದ ಕೆಲವು ಪುಸ್ತಕಗಳನ್ನು ಹಿಂದುಗಡೆದು ತೆಗೆದುಕೊಂಡಿದ್ದೇವೆ. ಒಟ್ಟಾರೆ, ಈ ಹೊಸ ಸಂಗ್ರಹಣೆ ಸುಮಾರು 24TB, ಇದು ಹಿಂದಿನದಕ್ಕಿಂತ (7TB) ದೊಡ್ಡದು. ನಮ್ಮ ಮಿರರ್ ಈಗ ಒಟ್ಟು 31TB. ಮತ್ತೆ, ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್ ವಿರುದ್ಧ ನಕಲು ನಿವಾರಣೆ ಮಾಡಲಾಗಿದೆ, ಏಕೆಂದರೆ ಆ ಸಂಗ್ರಹಣೆಗೆ ಈಗಾಗಲೇ ಟೊರೆಂಟ್‌ಗಳು ಲಭ್ಯವಿವೆ."

#, fuzzy
msgid "blog.3x-new-books.text4"
msgstr "ದಯವಿಟ್ಟು ಪೈರೇಟ್ ಲೈಬ್ರರಿ ಮಿರರ್‌ಗೆ ಹೋಗಿ ಹೊಸ ಸಂಗ್ರಹಣೆಯನ್ನು ಪರಿಶೀಲಿಸಿ (ತಿದ್ದುಪಡಿ: <a %(wikipedia_annas_archive)s>ಅನ್ನಾ’ಸ್ ಆರ್ಕೈವ್</a> ಗೆ ಸ್ಥಳಾಂತರಿಸಲಾಗಿದೆ). ಅಲ್ಲಿ ಕಡತಗಳನ್ನು ಹೇಗೆ ರಚಿಸಲಾಗಿದೆ ಮತ್ತು ಹಿಂದಿನ ಬಾರಿಗೆ ಏನು ಬದಲಾಗಿದೆ ಎಂಬುದರ ಬಗ್ಗೆ ಹೆಚ್ಚಿನ ಮಾಹಿತಿ ಇದೆ. ನಾವು ಇದರಿಂದ ಲಿಂಕ್ ಮಾಡುವುದಿಲ್ಲ, ಏಕೆಂದರೆ ಇದು ಯಾವುದೇ ಅಕ್ರಮ ವಸ್ತುಗಳನ್ನು ಹೋಸ್ಟ್ ಮಾಡದ ಬ್ಲಾಗ್ ವೆಬ್‌ಸೈಟ್ ಮಾತ್ರ."

#, fuzzy
msgid "blog.3x-new-books.text5"
msgstr "ನಿಸ್ಸಂದೇಹವಾಗಿ, ಸೀಡಿಂಗ್ ಕೂಡ ನಮಗೆ ಸಹಾಯ ಮಾಡುವ ಉತ್ತಮ ಮಾರ್ಗವಾಗಿದೆ. ನಮ್ಮ ಹಿಂದಿನ ಟೊರೆಂಟ್‌ಗಳ ಸೆಟ್ ಅನ್ನು ಸೀಡ್ ಮಾಡುತ್ತಿರುವ ಎಲ್ಲರಿಗೂ ಧನ್ಯವಾದಗಳು. ನಾವು ಸಕಾರಾತ್ಮಕ ಪ್ರತಿಕ್ರಿಯೆಗೆ ಕೃತಜ್ಞರಾಗಿದ್ದೇವೆ ಮತ್ತು ಈ ಅಸಾಮಾನ್ಯ ರೀತಿಯಲ್ಲಿ ಜ್ಞಾನ ಮತ್ತು ಸಂಸ್ಕೃತಿಯ ಸಂರಕ್ಷಣೆಯನ್ನು ಕಾಳಜಿ ವಹಿಸುವಷ್ಟು ಜನರಿರುವುದಕ್ಕೆ ಸಂತೋಷವಾಗುತ್ತಿದೆ."

#, fuzzy
msgid "blog.3x-new-books.signature"
msgstr "- ಅಣ್ಣಾ ಮತ್ತು ತಂಡ (<a %(reddit)s>Reddit</a>)"

#, fuzzy
msgid "blog.how-to.title"
msgstr "ಪೈರೇಟ್ ಆರ್ಕೈವಿಸ್ಟ್ ಆಗುವುದು ಹೇಗೆ"

#, fuzzy
msgid "blog.how-to.tldr"
msgstr "ಮೊದಲ ಸವಾಲು ಆಶ್ಚರ್ಯಕರವಾಗಿರಬಹುದು. ಇದು ತಾಂತ್ರಿಕ ಸಮಸ್ಯೆ ಅಥವಾ ಕಾನೂನು ಸಮಸ್ಯೆಯಲ್ಲ. ಇದು ಮಾನಸಿಕ ಸಮಸ್ಯೆಯಾಗಿದೆ."

#, fuzzy
msgid "blog.how-to.updates"
msgstr "ನಾವು ಮುಂದುಹೋಗುವ ಮೊದಲು, ಪೈರೇಟ್ ಲೈಬ್ರರಿ ಮಿರರ್‌ನ ಎರಡು ನವೀಕರಣಗಳು (ತಿದ್ದುಪಡಿ: <a %(wikipedia_annas_archive)s>ಅನ್ನಾ’ಸ್ ಆರ್ಕೈವ್</a> ಗೆ ಸ್ಥಳಾಂತರಿಸಲಾಗಿದೆ):"

#, fuzzy
msgid "blog.how-to.updates.item1"
msgstr "ನಾವು ಕೆಲವು ಅತ್ಯಂತ ಉದಾರ ದೇಣಿಗೆಗಳನ್ನು ಪಡೆದಿದ್ದೇವೆ. ಮೊದಲನೆಯದು \"ಬುಕ್ವಾರಿಯರ್\" ಅನ್ನು ಬೆಂಬಲಿಸುತ್ತಿರುವ ಅನಾಮಿಕ ವ್ಯಕ್ತಿಯಿಂದ $10k, ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್‌ನ ಮೂಲ ಸ್ಥಾಪಕ. ಈ ದೇಣಿಗೆಯನ್ನು ಸುಗಮಗೊಳಿಸಿದಕ್ಕಾಗಿ ಬುಕ್ವಾರಿಯರ್‌ಗೆ ವಿಶೇಷ ಧನ್ಯವಾದಗಳು. ಎರಡನೆಯದು ನಮ್ಮ ಕೊನೆಯ ಬಿಡುಗಡೆ ನಂತರ ಸಂಪರ್ಕಿಸಿದ ಮತ್ತು ಸಹಾಯ ಮಾಡಲು ಪ್ರೇರಿತವಾದ ಮತ್ತೊಂದು ಅನಾಮಿಕ ದಾನಿಯಿಂದ $10k. ನಾವು ಕೆಲವು ಸಣ್ಣ ದೇಣಿಗೆಗಳನ್ನು ಸಹ ಪಡೆದಿದ್ದೇವೆ. ನಿಮ್ಮ ಎಲ್ಲಾ ಉದಾರ ಬೆಂಬಲಕ್ಕಾಗಿ ತುಂಬಾ ಧನ್ಯವಾದಗಳು. ಇದನ್ನು ಬೆಂಬಲಿಸುವ ಕೆಲವು ರೋಮಾಂಚಕ ಹೊಸ ಯೋಜನೆಗಳು ನಮ್ಮ ಬಳಿ ಇವೆ, ಆದ್ದರಿಂದ ತಾಳ್ಮೆಯಿಂದಿರಿ."

#, fuzzy
msgid "blog.how-to.updates.item2"
msgstr "ನಮ್ಮ ಎರಡನೇ ಬಿಡುಗಡೆದ ಗಾತ್ರದೊಂದಿಗೆ ಕೆಲವು ತಾಂತ್ರಿಕ ತೊಂದರೆಗಳು ಉಂಟಾಗಿದ್ದವು, ಆದರೆ ನಮ್ಮ ಟೊರೆಂಟ್‌ಗಳು ಈಗ ಅಪ್ ಮತ್ತು ಸೀಡಿಂಗ್ ಆಗಿವೆ. ನಮ್ಮ ಸಂಗ್ರಹಣೆಯನ್ನು ಅವರ ಅತ್ಯಂತ ವೇಗದ ಸರ್ವರ್‌ಗಳಲ್ಲಿ ಸೀಡ್ ಮಾಡಲು ಅನಾಮಿಕ ವ್ಯಕ್ತಿಯಿಂದ ಉದಾರ ಆಫರ್ ಅನ್ನು ನಾವು ಪಡೆದಿದ್ದೇವೆ, ಆದ್ದರಿಂದ ನಾವು ಅವರ ಯಂತ್ರಗಳಿಗೆ ವಿಶೇಷ ಅಪ್‌ಲೋಡ್ ಮಾಡುತ್ತಿದ್ದೇವೆ, ನಂತರ ಸಂಗ್ರಹಣೆಯನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡುತ್ತಿರುವ ಇತರ ಎಲ್ಲರೂ ವೇಗದಲ್ಲಿ ದೊಡ್ಡ ಸುಧಾರಣೆಯನ್ನು ಕಾಣಬೇಕು."

#, fuzzy
msgid "blog.how-to.text1"
msgstr "ಡಿಜಿಟಲ್ ಸಂರಕ್ಷಣೆಯ <em>ಯಾಕೆ</em> ಎಂಬುದರ ಬಗ್ಗೆ, ಮತ್ತು ವಿಶೇಷವಾಗಿ ಪೈರೇಟ್ ಆರ್ಕೈವಿಸಂ ಬಗ್ಗೆ ಸಂಪೂರ್ಣ ಪುಸ್ತಕಗಳನ್ನು ಬರೆಯಬಹುದು, ಆದರೆ ಹೆಚ್ಚು ಪರಿಚಯವಿಲ್ಲದವರಿಗೆ ತ್ವರಿತ ಪರಿಚಯವನ್ನು ನೀಡೋಣ. ಜಗತ್ತು ಎಂದಿಗಿಂತ ಹೆಚ್ಚು ಜ್ಞಾನ ಮತ್ತು ಸಂಸ್ಕೃತಿಯನ್ನು ಉತ್ಪಾದಿಸುತ್ತಿದೆ, ಆದರೆ ಎಂದಿಗಿಂತ ಹೆಚ್ಚು ಅದನ್ನು ಕಳೆದುಕೊಳ್ಳುತ್ತಿದೆ. ಮಾನವತೆ ಮುಖ್ಯವಾಗಿ ಈ ಪರಂಪರೆಯನ್ನು ಅಕಾಡೆಮಿಕ್ ಪ್ರಕಾಶಕರು, ಸ್ಟ್ರೀಮಿಂಗ್ ಸೇವೆಗಳು ಮತ್ತು ಸಾಮಾಜಿಕ ಮಾಧ್ಯಮ ಕಂಪನಿಗಳಂತಹ ನಿಗಮಗಳಿಗೆ ನಂಬಿದೆ, ಮತ್ತು ಅವರು ಉತ್ತಮ ನಿರ್ವಹಕರಾಗಿಲ್ಲ ಎಂದು ತೋರಿಸಿದ್ದಾರೆ. ಡಿಜಿಟಲ್ ಅಮ್ನೀಷಿಯಾ ಡಾಕ್ಯುಮೆಂಟರಿಯನ್ನು ಅಥವಾ ಜೇಸನ್ ಸ್ಕಾಟ್ ಅವರ ಯಾವುದೇ ಮಾತನ್ನು ಪರಿಶೀಲಿಸಿ."

#, fuzzy
msgid "blog.how-to.text2"
msgstr "ಅವರು ಸಾಧ್ಯವಾದಷ್ಟು ಹೆಚ್ಚು ಆರ್ಕೈವ್ ಮಾಡುವ ಉತ್ತಮ ಕೆಲಸವನ್ನು ಮಾಡುವ ಕೆಲವು ಸಂಸ್ಥೆಗಳಿವೆ, ಆದರೆ ಅವರು ಕಾನೂನಿನಿಂದ ಬದ್ಧರಾಗಿದ್ದಾರೆ. ಪೈರೇಟ್ಸ್ ಆಗಿ, ನಾವು ಅವರು ಸ್ಪರ್ಶಿಸಲು ಸಾಧ್ಯವಿಲ್ಲದ ಸಂಗ್ರಹಣೆಯನ್ನು ಆರ್ಕೈವ್ ಮಾಡಲು ಅನನ್ಯ ಸ್ಥಾನದಲ್ಲಿದ್ದೇವೆ, ಕಾಪಿರೈಟ್ ಜಾರಿಗೆ ಅಥವಾ ಇತರ ನಿರ್ಬಂಧಗಳ ಕಾರಣದಿಂದ. ನಾವು ಸಂಗ್ರಹಣೆಯನ್ನು ವಿಶ್ವದಾದ್ಯಂತ ಅನೇಕ ಬಾರಿ ಮಿರರ್ ಮಾಡಬಹುದು, ಈ ಮೂಲಕ ಸರಿಯಾದ ಸಂರಕ್ಷಣೆಯ ಸಾಧ್ಯತೆಯನ್ನು ಹೆಚ್ಚಿಸುತ್ತೇವೆ."

#, fuzzy
msgid "blog.how-to.text3"
msgstr "ಈಗಾಗಲೇ, ಬೌದ್ಧಿಕ ಆಸ್ತಿ, ಕಾನೂನನ್ನು ಉಲ್ಲಂಘಿಸುವ ನೈತಿಕತೆ, ಸೆನ್ಸಾರ್‌ಶಿಪ್‌ನ ಮೇಲೆ ಚಿಂತನೆಗಳು, ಅಥವಾ ಜ್ಞಾನ ಮತ್ತು ಸಂಸ್ಕೃತಿಗೆ ಪ್ರವೇಶದ ಸಮಸ್ಯೆಯ ಬಗ್ಗೆ ಚರ್ಚೆಗಳನ್ನು ನಾವು ಮಾಡುವುದಿಲ್ಲ. ಈ ಎಲ್ಲಾ ವಿಷಯಗಳನ್ನು ಬದಿಗಿಟ್ಟು, <em>ಹೇಗೆ</em> ಎಂಬುದರೊಳಗೆ ಮುಳುಗೋಣ. ನಮ್ಮ ತಂಡವು ಪೈರೇಟ್ ಆರ್ಕೈವಿಸ್ಟ್‌ಗಳಾಗಿ ಹೇಗೆ ಆಯಿತು ಮತ್ತು ನಾವು ಮಾರ್ಗದಲ್ಲಿ ಕಲಿತ ಪಾಠಗಳನ್ನು ಹಂಚಿಕೊಳ್ಳುತ್ತೇವೆ. ನೀವು ಈ ಪ್ರಯಾಣವನ್ನು ಪ್ರಾರಂಭಿಸಿದಾಗ ಅನೇಕ ಸವಾಲುಗಳಿವೆ, ಮತ್ತು ನಾವು ಅವುಗಳಲ್ಲಿ ಕೆಲವು ಮೂಲಕ ನಿಮಗೆ ಸಹಾಯ ಮಾಡಬಹುದು ಎಂದು ಆಶಿಸುತ್ತೇವೆ."

#, fuzzy
msgid "blog.how-to.community"
msgstr "ಸಮುದಾಯ"

#, fuzzy
msgid "blog.how-to.community.text1"
msgstr "ಮೊದಲ ಸವಾಲು ಆಶ್ಚರ್ಯಕರವಾಗಿರಬಹುದು. ಇದು ತಾಂತ್ರಿಕ ಸಮಸ್ಯೆ ಅಥವಾ ಕಾನೂನು ಸಮಸ್ಯೆಯಲ್ಲ. ಇದು ಮಾನಸಿಕ ಸಮಸ್ಯೆಯಾಗಿದೆ: ಈ ಕೆಲಸವನ್ನು ನೆರಳಿನಲ್ಲಿ ಮಾಡುವುದು ಅತ್ಯಂತ ಏಕಾಂತವಾಗಿರಬಹುದು. ನೀವು ಏನು ಮಾಡಲು ಯೋಜಿಸುತ್ತಿದ್ದೀರಿ ಮತ್ತು ನಿಮ್ಮ ಬೆದರಿಕೆ ಮಾದರಿಯ ಮೇಲೆ ಅವಲಂಬಿತವಾಗಿರುತ್ತದೆ, ನೀವು ಬಹಳ ಎಚ್ಚರಿಕೆಯಿಂದ ಇರಬೇಕಾಗಬಹುದು. ಸ್ಪೆಕ್ಟ್ರಮ್‌ನ ಒಂದು ತುದಿಯಲ್ಲಿ, ಸೈ-ಹಬ್‌ನ ಸ್ಥಾಪಕ ಅಲೆಕ್ಸಾಂಡ್ರಾ ಎಲ್ಬಾಕ್ಯಾನ್* ಅವರಂತಹ ಜನರಿದ್ದಾರೆ, ಅವರು ತಮ್ಮ ಚಟುವಟಿಕೆಗಳ ಬಗ್ಗೆ ಬಹಳ ತೆರೆಯಾಗಿ ಇದ್ದಾರೆ. ಆದರೆ ಈ ಹಂತದಲ್ಲಿ ಅವರು ಪಶ್ಚಿಮ ದೇಶಕ್ಕೆ ಭೇಟಿ ನೀಡಿದರೆ ಬಂಧನಕ್ಕೊಳಗಾಗುವ ಅಪಾಯದಲ್ಲಿದ್ದಾರೆ ಮತ್ತು ದಶಕಗಳ ಕಾಲ ಜೈಲು ಶಿಕ್ಷೆಯನ್ನು ಎದುರಿಸಬಹುದು. ನೀವು ತೆಗೆದುಕೊಳ್ಳಲು ಸಿದ್ಧರಾಗಿರುವ ಅಪಾಯವೇ? ನಾವು ಸ್ಪೆಕ್ಟ್ರಮ್‌ನ ಇನ್ನೊಂದು ತುದಿಯಲ್ಲಿ ಇದ್ದೇವೆ; ಯಾವುದೇ ಹಾದಿಯನ್ನು ಬಿಟ್ಟುಬಿಡದಂತೆ ಬಹಳ ಎಚ್ಚರಿಕೆಯಿಂದ, ಮತ್ತು ಬಲವಾದ ಕಾರ್ಯಾಚರಣಾ ಭದ್ರತೆಯನ್ನು ಹೊಂದಿರುವುದು."

#, fuzzy
msgid "blog.how-to.community.text2"
msgstr "* \"ynno\" ಎಂಬ ಹೆಸರಿನ HN ನಲ್ಲಿ ಉಲ್ಲೇಖಿಸಿದಂತೆ, ಅಲೆಕ್ಸಾಂಡ್ರಾ ಪ್ರಾರಂಭದಲ್ಲಿ ಪರಿಚಿತವಾಗಿರಲು ಬಯಸಲಿಲ್ಲ: \"ಅವರ ಸರ್ವರ್‌ಗಳನ್ನು PHP ನಿಂದ ವಿವರವಾದ ದೋಷ ಸಂದೇಶಗಳನ್ನು ಹೊರಸೂಸಲು ಹೊಂದಿಸಲಾಗಿತ್ತು, ದೋಷದ ಮೂಲ ಕಡತದ ಸಂಪೂರ್ಣ ಹಾದಿಯನ್ನು ಒಳಗೊಂಡಂತೆ, ಇದು /home/ringo-ring ಡೈರೆಕ್ಟರಿಯ ಅಡಿಯಲ್ಲಿ ಇತ್ತು, ಇದು ಆನ್ಲೈನ್‌ನಲ್ಲಿ ಅವರ ಬಳಕೆದಾರಹೆಸರುಗಳಿಗೆ ಹಾದಿ ಮಾಡಬಹುದಾಗಿತ್ತು. ಈ ಬಹಿರಂಗಪಡಿಸುವ ಮೊದಲು, ಅವರು ಅನಾಮಿಕರಾಗಿದ್ದರು.\" ಆದ್ದರಿಂದ, ನೀವು ಈ ವಿಷಯಕ್ಕಾಗಿ ಬಳಸುವ ಕಂಪ್ಯೂಟರ್‌ಗಳಲ್ಲಿ ಯಾದೃಚ್ಛಿಕ ಬಳಕೆದಾರಹೆಸರುಗಳನ್ನು ಬಳಸಿರಿ, ನೀವು ಏನಾದರೂ ತಪ್ಪಾಗಿ ಸಂರಚಿಸಿದರೆ."

#, fuzzy
msgid "blog.how-to.community.text3"
msgstr "ಆದರೆ, ಆ ರಹಸ್ಯತೆಯು ಮಾನಸಿಕ ವೆಚ್ಚವನ್ನು ಹೊಂದಿದೆ. ಹೆಚ್ಚಿನ ಜನರು ಅವರು ಮಾಡುವ ಕೆಲಸಕ್ಕಾಗಿ ಗುರುತಿಸಿಕೊಳ್ಳಲು ಇಷ್ಟಪಡುತ್ತಾರೆ, ಆದರೆ ನೀವು ನಿಜ ಜೀವನದಲ್ಲಿ ಇದಕ್ಕಾಗಿ ಯಾವುದೇ ಶ್ರೇಯಸ್ಸನ್ನು ಪಡೆಯಲು ಸಾಧ್ಯವಿಲ್ಲ. ಸ್ನೇಹಿತರು ನಿಮಗೆ ನೀವು ಏನು ಮಾಡುತ್ತಿದ್ದೀರಿ ಎಂದು ಕೇಳಿದಾಗಲೂ ಸರಳ ವಿಷಯಗಳು ಸವಾಲಿನಾಯಕವಾಗಬಹುದು (ಕೆಲವು ಸಮಯದಲ್ಲಿ \"ನನ್ನ NAS / ಹೋಮ್‌ಲ್ಯಾಬ್‌ನೊಂದಿಗೆ ತೊಂದರೆ\" ಹಳೆಯದಾಗುತ್ತದೆ)."

#, fuzzy
msgid "blog.how-to.community.text4"
msgstr "ಇದಕ್ಕಾಗಿ ಕೆಲವು ಸಮುದಾಯವನ್ನು ಹುಡುಕುವುದು ಬಹಳ ಮುಖ್ಯ. ನೀವು ಕೆಲವು ಅತ್ಯಂತ ಆಪ್ತ ಸ್ನೇಹಿತರೊಂದಿಗೆ ನಂಬಿಕೆ ಇಟ್ಟುಕೊಳ್ಳುವ ಮೂಲಕ ಕೆಲವು ಕಾರ್ಯಾಚರಣಾ ಭದ್ರತೆಯನ್ನು ತ್ಯಜಿಸಬಹುದು, ನೀವು ಅವರನ್ನು ಆಳವಾಗಿ ನಂಬಬಹುದು ಎಂದು ನೀವು ತಿಳಿದಿದ್ದರೆ. ಆದರೂ ಅವರು ತಮ್ಮ ಇಮೇಲ್‌ಗಳನ್ನು ಅಧಿಕಾರಿಗಳಿಗೆ ಒಪ್ಪಿಸಬೇಕಾದರೆ ಅಥವಾ ಅವರ ಸಾಧನಗಳು ಬೇರೆ ರೀತಿಯಲ್ಲಿ妥ಪದ್ರವಿತವಾಗಿದ್ದರೆ, ಯಾವುದೇ ವಿಷಯವನ್ನು ಬರವಣಿಗೆಯಲ್ಲಿ ಹಾಕದಂತೆ ಎಚ್ಚರಿಕೆಯಿಂದಿರಿ."

#, fuzzy
msgid "blog.how-to.community.text5"
msgstr "ಇದಕ್ಕಿಂತ ಉತ್ತಮವಾದುದು ಕೆಲವು ಸಹ ಪೈರೇಟ್ಸ್‌ಗಳನ್ನು ಹುಡುಕುವುದು. ನಿಮ್ಮ ಆಪ್ತ ಸ್ನೇಹಿತರು ನಿಮ್ಮೊಂದಿಗೆ ಸೇರಲು ಆಸಕ್ತಿ ಹೊಂದಿದ್ದರೆ, ಅದ್ಭುತ! ಇಲ್ಲದಿದ್ದರೆ, ನೀವು ಇತರರನ್ನು ಆನ್‌ಲೈನ್‌ನಲ್ಲಿ ಹುಡುಕಬಹುದು. ದುಃಖಕರವಾಗಿ, ಇದು ಇನ್ನೂ ಒಂದು ನಿಶ್ ಸಮುದಾಯವಾಗಿದೆ. ಇದುವರೆಗೆ ನಾವು ಈ ಸ್ಥಳದಲ್ಲಿ ಸಕ್ರಿಯವಾಗಿರುವ ಇತರ ಕೆಲವರನ್ನು ಮಾತ್ರ ಕಂಡಿದ್ದೇವೆ. ಉತ್ತಮ ಆರಂಭಿಕ ಸ್ಥಳಗಳು ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್ ಫೋರಮ್‌ಗಳು ಮತ್ತು r/DataHoarder ಆಗಿವೆ. ಆರ್ಕೈವ್ ತಂಡದಲ್ಲಿಯೂ ಸಹ ಮನಸ್ಸಿನಂತಹ ವ್ಯಕ್ತಿಗಳು ಇದ್ದಾರೆ, ಆದರೆ ಅವರು ಕಾನೂನಿನ ಒಳಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತಾರೆ (ಕಾನೂನಿನ ಕೆಲವು ಬೂದು ಪ್ರದೇಶಗಳಲ್ಲಿ ಇದ್ದರೂ). ಪರಂಪರೆಯ \"ವೇರ್‌ಜ್\" ಮತ್ತು ಪೈರೇಟಿಂಗ್ ದೃಶ್ಯಗಳಲ್ಲಿಯೂ ಸಹ ಹೋಲಿಸಿದಂತೆ ಯೋಚಿಸುವ ಜನರಿದ್ದಾರೆ."

#, fuzzy
msgid "blog.how-to.community.text6"
msgstr "ನಾವು ಸಮುದಾಯವನ್ನು ಬೆಳೆಸಲು ಮತ್ತು ಆಲೋಚನೆಗಳನ್ನು ಅನ್ವೇಷಿಸಲು ಯೋಚನೆಗಳನ್ನು ಸ್ವೀಕರಿಸುತ್ತೇವೆ. Twitter ಅಥವಾ Reddit ನಲ್ಲಿ ನಮಗೆ ಸಂದೇಶ ಕಳುಹಿಸಲು ಮುಕ್ತವಾಗಿರಿ. ಬಹುಶಃ ನಾವು ಕೆಲವು ರೀತಿಯ ವೇದಿಕೆ ಅಥವಾ ಚಾಟ್ ಗುಂಪನ್ನು ಆಯೋಜಿಸಬಹುದು. ಒಂದು ಸವಾಲು ಎಂದರೆ ಸಾಮಾನ್ಯ ವೇದಿಕೆಗಳನ್ನು ಬಳಸಿದಾಗ ಇದು ಸುಲಭವಾಗಿ ಸೆನ್ಸರ್ ಆಗಬಹುದು, ಆದ್ದರಿಂದ ನಾವು ಅದನ್ನು ಸ್ವತಃ ಆಯೋಜಿಸಬೇಕಾಗುತ್ತದೆ. ಈ ಚರ್ಚೆಗಳನ್ನು ಸಂಪೂರ್ಣವಾಗಿ ಸಾರ್ವಜನಿಕವಾಗಿ (ಹೆಚ್ಚು ತಲುಪುವಿಕೆ) ನಡೆಸುವುದು ಮತ್ತು ಖಾಸಗಿಯಾಗಿ (ನಾವು ಅವರನ್ನು ಸ್ಕ್ರೇಪ್ ಮಾಡಲು ಹೋಗುತ್ತಿದ್ದೇವೆ ಎಂಬುದನ್ನು \"ಗುರಿಗಳು\" ತಿಳಿಯದಂತೆ ಮಾಡುವುದು) ನಡುವೆ ವ್ಯತ್ಯಾಸವಿದೆ. ನಾವು ಅದನ್ನು ಯೋಚಿಸಬೇಕಾಗಿದೆ. ನೀವು ಇದರಲ್ಲಿ ಆಸಕ್ತಿ ಹೊಂದಿದ್ದರೆ ನಮಗೆ ತಿಳಿಸಿ!"

