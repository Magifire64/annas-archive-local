msgid "page.faq.help.title"
msgstr "ನಾನು ಹೇಗೆ ಸಹಾಯ ಮಾಡಬಹುದು?"

#, fuzzy
msgid "page.about.help.text"
msgstr "<li>1. ನಮ್ಮನ್ನು <a href=\"https://www.reddit.com/r/Annas_Archive/\">ರೆಡಿಟ್</a>, ಅಥವಾ <a href=\"https://t.me/annasarchiveorg\">ಟೆಲಿಗ್ರಾಮ್</a> ನಲ್ಲಿ ಅನುಸರಿಸಿ.</li><li>2. Twitter, Reddit, Tiktok, Instagram, ನಿಮ್ಮ ಸ್ಥಳೀಯ ಕಾಫಿ ಶಾಪ್ ಅಥವಾ ಗ್ರಂಥಾಲಯದಲ್ಲಿ ಅಥವಾ ನೀವು ಹೋಗುವ ಎಲ್ಲೆಡೆ Anna’s Archive ಬಗ್ಗೆ ಪ್ರಚಾರ ಮಾಡಿ! ನಾವು ಗೇಟ್‌ಕೀಪಿಂಗ್‌ನಲ್ಲಿ ನಂಬುವುದಿಲ್ಲ — ನಾವು ತೆಗೆದುಹಾಕಿದರೆ, ನಮ್ಮ ಎಲ್ಲಾ ಕೋಡ್ ಮತ್ತು ಡೇಟಾ ಸಂಪೂರ್ಣವಾಗಿ ಓಪನ್ ಸೋರ್ಸ್ ಆಗಿರುವುದರಿಂದ ನಾವು ಬೇರೆಡೆ ಮತ್ತೆ ಪ್ರತ್ಯಕ್ಷವಾಗುತ್ತೇವೆ.</li><li>3. ನೀವು ಸಾಧ್ಯವಾದರೆ, <a href=\"/donate\">ದಾನ ಮಾಡುವ</a> ಬಗ್ಗೆ ಪರಿಗಣಿಸಿ.</li><li>4. ನಮ್ಮ ವೆಬ್‌ಸೈಟ್ ಅನ್ನು ವಿಭಿನ್ನ ಭಾಷೆಗಳಿಗೆ <a href=\"https://translate.annas-software.org/\">ಅನುವಾದಿಸಲು</a> ಸಹಾಯ ಮಾಡಿ.</li><li>5. ನೀವು ಸಾಫ್ಟ್‌ವೇರ್ ಎಂಜಿನಿಯರ್ ಆಗಿದ್ದರೆ, ನಮ್ಮ <a href=\"https://annas-software.org/\">ಓಪನ್ ಸೋರ್ಸ್</a> ಗೆ ಕೊಡುಗೆ ನೀಡಲು ಅಥವಾ ನಮ್ಮ <a href=\"/datasets\">ಟೊರೆಂಟ್ಗಳನ್ನು</a> ಸೀಡ್ ಮಾಡಲು ಪರಿಗಣಿಸಿ.</li>"

#, fuzzy
