#, fuzzy
msgid "blog.duxiu-exclusive.text2"
msgstr "ಎಲ್‌ಎಲ್‌ಎಂ‌ಗಳ ತರಬೇತಿಗಾಗಿ ಉನ್ನತ-ಗುಣಮಟ್ಟದ ಶೈಕ್ಷಣಿಕ ಪಠ್ಯವು ಅತ್ಯಂತ ಉಪಯುಕ್ತವಾಗಿದೆ. ನಮ್ಮ ಸಂಗ್ರಹವು ಚೀನೀ ಭಾಷೆಯಾದರೂ, ಇದು ಇಂಗ್ಲಿಷ್ ಎಲ್‌ಎಲ್‌ಎಂ‌ಗಳ ತರಬೇತಿಗಾಗಿ ಸಹ ಉಪಯುಕ್ತವಾಗಿರುತ್ತದೆ: ಮಾದರಿಗಳು ಮೂಲ ಭಾಷೆಯನ್ನು ಲೆಕ್ಕಿಸದೆ ಪರಿಕಲ್ಪನೆಗಳು ಮತ್ತು ಜ್ಞಾನವನ್ನು ಸಂಕೇತಿಸುತ್ತವೆ."

#, fuzzy
msgid "blog.duxiu-exclusive.text3"
msgstr "ಇದಕ್ಕಾಗಿ, ಪಠ್ಯವನ್ನು ಸ್ಕ್ಯಾನ್‌ಗಳಿಂದ ಹೊರತೆಗೆಯಬೇಕು. ಅನ್ನಾ’ಸ್ ಆರ್ಕೈವ್ ಇದರಿಂದ ಏನು ಪಡೆಯುತ್ತದೆ? ಅದರ ಬಳಕೆದಾರರಿಗಾಗಿ ಪುಸ್ತಕಗಳ ಸಂಪೂರ್ಣ ಪಠ್ಯ ಶೋಧ."

#, fuzzy
msgid "blog.duxiu-exclusive.text4"
msgstr "ನಮ್ಮ ಗುರಿಗಳು ಎಲ್‌ಎಲ್‌ಎಂ ಅಭಿವೃದ್ಧಿಪರರ ಗುರಿಗಳೊಂದಿಗೆ ಹೊಂದಿಕೆಯಾಗಿರುವುದರಿಂದ, ನಾವು ಸಹಯೋಗಿಯನ್ನು ಹುಡುಕುತ್ತಿದ್ದೇವೆ. ನೀವು ಸರಿಯಾದ ಓಸಿಆರ್ ಮತ್ತು ಪಠ್ಯ ಹೊರತೆಗೆಯುವಿಕೆಯನ್ನು ಮಾಡಬಲ್ಲರೆಂದು, ನಾವು ನಿಮಗೆ <strong>ಈ ಸಂಗ್ರಹವನ್ನು 1 ವರ್ಷಕ್ಕೆ ಬೃಹತ್ ಪ್ರಮಾಣದಲ್ಲಿ ವಿಶೇಷವಾಗಿ ಮುಂಚಿತ ಪ್ರವೇಶವನ್ನು ನೀಡಲು</strong> ಸಿದ್ಧರಾಗಿದ್ದೇವೆ. ನೀವು ನಿಮ್ಮ ಪೈಪ್‌ಲೈನ್‌ನ ಸಂಪೂರ್ಣ ಕೋಡ್ ಅನ್ನು ನಮ್ಮೊಂದಿಗೆ ಹಂಚಿಕೊಳ್ಳಲು ಸಿದ್ಧರಾಗಿದ್ದರೆ, ನಾವು ಸಂಗ್ರಹವನ್ನು ಇನ್ನಷ್ಟು ಕಾಲದವರೆಗೆ ನಿರ್ಬಂಧಿಸಲು ಸಿದ್ಧರಾಗಿದ್ದೇವೆ."

#, fuzzy
msgid "blog.duxiu-exclusive.example_pages"
msgstr "ಉದಾಹರಣಾ ಪುಟಗಳು"

#, fuzzy
msgid "blog.duxiu-exclusive.example_pages.text1"
msgstr "ನಿಮ್ಮ ಪೈಪ್‌ಲೈನ್ ಉತ್ತಮವಾಗಿದೆ ಎಂದು ನಮಗೆ ತೋರಿಸಲು, ಸೂಪರ್‌ಕಂಡಕ್ಟರ್‌ಗಳ ಕುರಿತ ಪುಸ್ತಕದಿಂದ ಕೆಲವು ಉದಾಹರಣಾ ಪುಟಗಳನ್ನು ಪ್ರಾರಂಭಿಸಲು ಇಲ್ಲಿವೆ. ನಿಮ್ಮ ಪೈಪ್‌ಲೈನ್ ಗಣಿತ, ಟೇಬಲ್‌ಗಳು, ಚಾರ್ಟ್‌ಗಳು, ಪಾದಟಿಪ್ಪಣಿಗಳು ಇತ್ಯಾದಿಗಳನ್ನು ಸರಿಯಾಗಿ ನಿರ್ವಹಿಸಬೇಕು."

#, fuzzy
msgid "blog.duxiu-exclusive.example_pages.text2"
msgstr "ನಿಮ್ಮ ಪ್ರಕ್ರಿಯಿತ ಪುಟಗಳನ್ನು ನಮ್ಮ ಇಮೇಲ್‌ಗೆ ಕಳುಹಿಸಿ. ಅವು ಚೆನ್ನಾಗಿದ್ದರೆ, ನಾವು ನಿಮಗೆ ಖಾಸಗಿಯಾಗಿ ಇನ್ನಷ್ಟು ಕಳುಹಿಸುತ್ತೇವೆ, ಮತ್ತು ನೀವು ಅವುಗಳ ಮೇಲೆ ನಿಮ್ಮ ಪೈಪ್‌ಲೈನ್ ಅನ್ನು ಶೀಘ್ರವಾಗಿ ನಿರ್ವಹಿಸಲು ಸಾಧ್ಯವಾಗುತ್ತದೆ ಎಂದು ನಾವು ನಿರೀಕ್ಷಿಸುತ್ತೇವೆ. ನಾವು ತೃಪ್ತರಾಗುವವರೆಗೆ, ನಾವು ಒಪ್ಪಂದ ಮಾಡಬಹುದು."

#, fuzzy
msgid "blog.duxiu-exclusive.collection"
msgstr "ಸಂಗ್ರಹ"

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text1"
msgstr "ಸಂಗ್ರಹದ ಬಗ್ಗೆ ಇನ್ನಷ್ಟು ಮಾಹಿತಿ. <a %(duxiu)s>ಡಕ್ಸಿಯು</a> ಒಂದು ಭಾರೀ ಡೇಟಾಬೇಸ್ ಆಗಿದ್ದು, <a %(chaoxing)s>ಸೂಪರ್‌ಸ್ಟಾರ್ ಡಿಜಿಟಲ್ ಲೈಬ್ರರಿ ಗ್ರೂಪ್</a> ಮೂಲಕ ಸೃಷ್ಟಿಸಲಾಗಿದೆ. ಹೆಚ್ಚಿನವು ಶೈಕ್ಷಣಿಕ ಪುಸ್ತಕಗಳಾಗಿದ್ದು, ಅವುಗಳನ್ನು ವಿಶ್ವವಿದ್ಯಾಲಯಗಳು ಮತ್ತು ಗ್ರಂಥಾಲಯಗಳಿಗೆ ಡಿಜಿಟಲ್ ರೂಪದಲ್ಲಿ ಲಭ್ಯವಾಗಿಸಲು ಸ್ಕ್ಯಾನ್ ಮಾಡಲಾಗಿದೆ. ನಮ್ಮ ಇಂಗ್ಲಿಷ್-ಮಾತನಾಡುವ ಪ್ರೇಕ್ಷಕರಿಗಾಗಿ, <a %(library_princeton)s>ಪ್ರಿಂಸ್ಟನ್</a> ಮತ್ತು <a %(guides_lib_uw)s>ವಾಷಿಂಗ್ಟನ್ ವಿಶ್ವವಿದ್ಯಾಲಯ</a> ಉತ್ತಮ ಅವಲೋಕನಗಳನ್ನು ಹೊಂದಿವೆ. ಹಿನ್ನಲೆಯಲ್ಲಿ ಇನ್ನಷ್ಟು ಮಾಹಿತಿ ನೀಡುವ ಅತ್ಯುತ್ತಮ ಲೇಖನವೂ ಇದೆ: <a %(doi)s>“ಡಿಜಿಟೈಸಿಂಗ್ ಚೈನೀಸ್ ಬುಕ್ಸ್: ಎ ಕೇಸ್ ಸ್ಟಡಿ ಆಫ್ ದ ಸೂಪರ್‌ಸ್ಟಾರ್ ಡಕ್ಸಿಯು ಸ್ಕಾಲರ್ ಸರ್ಚ್ ಎಂಜಿನ್”</a> (ಅನ್ನಾ’ಸ್ ಆರ್ಕೈವ್‌ನಲ್ಲಿ ಹುಡುಕಿ)."

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text2"
msgstr "ಡಕ್ಸಿಯು ಪುಸ್ತಕಗಳು ಚೀನೀ ಇಂಟರ್ನೆಟ್‌ನಲ್ಲಿ ಬಹಳ ಕಾಲದಿಂದ ಪೈರಸಿ ಮಾಡಲ್ಪಟ್ಟಿವೆ. ಸಾಮಾನ್ಯವಾಗಿ ಅವುಗಳನ್ನು ಪುನರ್ವಿಕ್ರೇತಾರರಿಂದ ಒಂದು ಡಾಲರ್‌ಗಿಂತ ಕಡಿಮೆ ಬೆಲೆಗೆ ಮಾರಲಾಗುತ್ತದೆ. ಅವು ಸಾಮಾನ್ಯವಾಗಿ ಗೂಗಲ್ ಡ್ರೈವ್‌ನ ಚೀನೀ ಸಮಾನತೆಯ ಬಳಕೆ ಮೂಲಕ ವಿತರಿಸಲಾಗುತ್ತವೆ, ಇದನ್ನು ಹೆಚ್ಚುವರಿ ಸಂಗ್ರಹಣಾ ಸ್ಥಳಕ್ಕಾಗಿ ಹ್ಯಾಕ್ ಮಾಡಲಾಗಿದೆ. ಕೆಲವು ತಾಂತ್ರಿಕ ವಿವರಗಳನ್ನು <a %(github_duty_machine)s>ಇಲ್ಲಿ</a> ಮತ್ತು <a %(github_821_github_io)s>ಇಲ್ಲಿ</a> ಕಾಣಬಹುದು."

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text3"
msgstr "ಯಾವುದೇ bulk ನಲ್ಲಿ ಅವುಗಳನ್ನು ಪಡೆಯುವುದು ಬಹಳ ಕಷ್ಟಕರವಾಗಿದೆ, ಆದರೂ ಪುಸ್ತಕಗಳು ಅರ್ಧ-ಸಾರ್ವಜನಿಕವಾಗಿ ವಿತರಿಸಲ್ಪಟ್ಟಿವೆ. ನಾವು ಇದನ್ನು ನಮ್ಮ TODO-ಪಟ್ಟಿಯ ಮೇಲೆ ಉನ್ನತ ಸ್ಥಾನದಲ್ಲಿ ಇಟ್ಟುಕೊಂಡಿದ್ದೇವೆ ಮತ್ತು ಇದಕ್ಕಾಗಿ ಸಂಪೂರ್ಣ-ಕಾಲದ ಕೆಲಸಕ್ಕೆ ಹಲವಾರು ತಿಂಗಳುಗಳನ್ನು ಮೀಸಲಿಟ್ಟಿದ್ದೇವೆ. ಆದರೆ, ಇತ್ತೀಚೆಗೆ ಒಂದು ಅದ್ಭುತ, ಅಸಾಧಾರಣ, ಮತ್ತು ಪ್ರತಿಭಾವಂತ ಸ್ವಯಂಸೇವಕ ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಿದರು, ಅವರು ಈ ಎಲ್ಲಾ ಕೆಲಸವನ್ನು ಈಗಾಗಲೇ ಮಾಡಿರುವುದಾಗಿ ನಮಗೆ ತಿಳಿಸಿದರು — ದೊಡ್ಡ ವೆಚ್ಚದಲ್ಲಿ. ಅವರು ನಮ್ಮೊಂದಿಗೆ ಸಂಪೂರ್ಣ ಸಂಗ್ರಹವನ್ನು ಹಂಚಿಕೊಂಡರು, ದೀರ್ಘಕಾಲಿಕ ಸಂರಕ್ಷಣೆ ಖಾತರಿಯ ಹೊರತು ಯಾವುದೇ ಪ್ರತಿಫಲವನ್ನು ನಿರೀಕ್ಷಿಸದೆ. ನಿಜವಾಗಿಯೂ ಗಮನಾರ್ಹ. ಅವರು ಈ ರೀತಿಯಲ್ಲಿ ಸಹಾಯ ಕೇಳಲು ಒಪ್ಪಿಕೊಂಡರು, ಸಂಗ್ರಹವನ್ನು ಓಸಿಆರ್ ಮಾಡಲು."

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text4"
msgstr "ಸಂಗ್ರಹವು 7,543,702 ಕಡತಗಳಾಗಿದೆ. ಇದು ಲೈಬ್ರರಿ ಜೆನೆಸಿಸ್ ನಾನ್-ಫಿಕ್ಷನ್ (ಸುಮಾರು 5.3 ಮಿಲಿಯನ್) ಗಿಂತ ಹೆಚ್ಚು. ಒಟ್ಟು ಕಡತದ ಗಾತ್ರವು ಅದರ ಪ್ರಸ್ತುತ ರೂಪದಲ್ಲಿ ಸುಮಾರು 359TB (326TiB) ಆಗಿದೆ."

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text5"
msgstr "ನಾವು ಇತರ ಪ್ರಸ್ತಾಪಗಳು ಮತ್ತು ಆಲೋಚನೆಗಳಿಗೆ ತೆರೆಯಿದ್ದೇವೆ. ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಿ. ನಮ್ಮ ಸಂಗ್ರಹಗಳು, ಸಂರಕ್ಷಣೆ ಪ್ರಯತ್ನಗಳು, ಮತ್ತು ನೀವು ಹೇಗೆ ಸಹಾಯ ಮಾಡಬಹುದು ಎಂಬುದರ ಬಗ್ಗೆ ಹೆಚ್ಚಿನ ಮಾಹಿತಿಗಾಗಿ ಅನ್ನಾ’ಸ್ ಆರ್ಕೈವ್ ಅನ್ನು ಪರಿಶೀಲಿಸಿ. ಧನ್ಯವಾದಗಳು!"

