#, fuzzy
msgid "blog.annas-update-2022.open-source.text1"
msgstr "ಮಾಹಿತಿ ಉಚಿತವಾಗಿರಬೇಕು ಎಂದು ನಾವು ನಂಬುತ್ತೇವೆ, ಮತ್ತು ನಮ್ಮದೇ ಆದ ಕೋಡ್ ಇದಕ್ಕೆ ಹೊರತಾಗಿಲ್ಲ. ನಾವು ನಮ್ಮ ಎಲ್ಲಾ ಕೋಡ್ ಅನ್ನು ನಮ್ಮ ಖಾಸಗಿ ಹೋಸ್ಟ್ ಮಾಡಿದ Gitlab ಉದಾಹರಣೆಯಲ್ಲಿ ಬಿಡುಗಡೆ ಮಾಡಿದ್ದೇವೆ: <a %(annas_archive)s>ಅನ್ನಾ'ಸ್ ಸಾಫ್ಟ್‌ವೇರ್</a>. ನಾವು ನಮ್ಮ ಕೆಲಸವನ್ನು ಸಂಘಟಿಸಲು ಸಮಸ್ಯಾ ಟ್ರ್ಯಾಕರ್ ಅನ್ನು ಸಹ ಬಳಸುತ್ತೇವೆ. ನೀವು ನಮ್ಮ ಅಭಿವೃದ್ಧಿಯೊಂದಿಗೆ ತೊಡಗಿಸಿಕೊಳ್ಳಲು ಬಯಸಿದರೆ, ಇದು ಪ್ರಾರಂಭಿಸಲು ಉತ್ತಮ ಸ್ಥಳವಾಗಿದೆ."

#, fuzzy
msgid "blog.annas-update-2022.open-source.text2"
msgstr "ನಾವು ಕೆಲಸ ಮಾಡುತ್ತಿರುವ ವಿಷಯಗಳ ರುಚಿಯನ್ನು ನಿಮಗೆ ನೀಡಲು, ಕ್ಲೈಂಟ್-ಸೈಡ್ ಕಾರ್ಯಕ್ಷಮತೆಯ ಸುಧಾರಣೆಗಳ ಮೇಲೆ ನಮ್ಮ ಇತ್ತೀಚಿನ ಕೆಲಸವನ್ನು ತೆಗೆದುಕೊಳ್ಳಿ. ನಾವು ಇನ್ನೂ ಪುಟೀಕರಣವನ್ನು ಅನುಷ್ಠಾನಗೊಳಿಸಿಲ್ಲದ ಕಾರಣ, ನಾವು ಬಹುಶಃ 100-200 ಫಲಿತಾಂಶಗಳೊಂದಿಗೆ ಬಹಳ ಉದ್ದವಾದ ಹುಡುಕಾಟ ಪುಟಗಳನ್ನು ಹಿಂತಿರುಗಿಸುತ್ತೇವೆ. ನಾವು ಹುಡುಕಾಟದ ಫಲಿತಾಂಶಗಳನ್ನು ತುಂಬಾ ಬೇಗನೆ ಕಡಿತಗೊಳಿಸಲು ಬಯಸಲಿಲ್ಲ, ಆದರೆ ಇದು ಕೆಲವು ಸಾಧನಗಳನ್ನು ನಿಧಾನಗೊಳಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ಅರ್ಥೈಸಿತು. ಇದಕ್ಕಾಗಿ, ನಾವು ಒಂದು ಚಿಕ್ಕ ತಂತ್ರವನ್ನು ಅನುಷ್ಠಾನಗೊಳಿಸಿದ್ದೇವೆ: ನಾವು ಹೆಚ್ಚಿನ ಹುಡುಕಾಟದ ಫಲಿತಾಂಶಗಳನ್ನು HTML ಕಾಮೆಂಟ್‌ಗಳಲ್ಲಿ (<code><!-- --></code>) ಸುತ್ತುವರೆಯುತ್ತೇವೆ, ಮತ್ತು ನಂತರ ಯಾವಾಗ ಫಲಿತಾಂಶವು ಕಾಣಿಸಿಕೊಳ್ಳಬೇಕು ಎಂಬುದನ್ನು ಪತ್ತೆಹಚ್ಚುವ ಚಿಕ್ಕ Javascript ಅನ್ನು ಬರೆದಿದ್ದೇವೆ, ಆ ಕ್ಷಣದಲ್ಲಿ ನಾವು ಕಾಮೆಂಟ್ ಅನ್ನು ಅನ್ವಯಿಸುತ್ತೇವೆ:"

#, fuzzy
msgid "blog.annas-update-2022.open-source.text3"
msgstr "DOM \"ವರ್ಚುವಲೈಜೇಶನ್\" 23 ಸಾಲುಗಳಲ್ಲಿ ಅನುಷ್ಠಾನಗೊಳಿಸಲಾಗಿದೆ, ಆಕರ್ಷಕ ಗ್ರಂಥಾಲಯಗಳ ಅಗತ್ಯವಿಲ್ಲ! ಇದು ನೀವು ಸೀಮಿತ ಸಮಯ ಹೊಂದಿರುವಾಗ ಮತ್ತು ನಿಜವಾದ ಸಮಸ್ಯೆಗಳನ್ನು ಪರಿಹರಿಸಬೇಕಾದಾಗ ನೀವು ಹೊಂದುವ ತ್ವರಿತ ಪ್ರಾಯೋಗಿಕ ಕೋಡ್. ನಮ್ಮ ಹುಡುಕಾಟವು ನಿಧಾನಗತಿಯ ಸಾಧನಗಳಲ್ಲಿ ಈಗ ಚೆನ್ನಾಗಿ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತಿದೆ ಎಂದು ವರದಿಯಾಗಿದೆ!"

#, fuzzy
msgid "blog.annas-update-2022.open-source.text4"
msgstr "ಮತ್ತೊಂದು ದೊಡ್ಡ ಪ್ರಯತ್ನವು ಡೇಟಾಬೇಸ್ ನಿರ್ಮಾಣವನ್ನು ಸ್ವಯಂಚಾಲಿತಗೊಳಿಸುವುದು. ನಾವು ಪ್ರಾರಂಭಿಸಿದಾಗ, ನಾವು ವಿಭಿನ್ನ ಮೂಲಗಳನ್ನು ಅಸಮರ್ಪಕವಾಗಿ ಒಟ್ಟುಗೂಡಿಸಿದ್ದೇವೆ. ಈಗ ನಾವು ಅವುಗಳನ್ನು ನವೀಕರಿಸಲು ಬಯಸುತ್ತೇವೆ, ಆದ್ದರಿಂದ ನಾವು ಎರಡು Library Genesis ಫೋರ್ಕ್‌ಗಳಿಂದ ಹೊಸ ಮೆಟಾಡೇಟಾವನ್ನು ಡೌನ್‌ಲೋಡ್ ಮಾಡಲು ಮತ್ತು ಅವುಗಳನ್ನು ಒಟ್ಟುಗೂಡಿಸಲು ಕೆಲವು ಸ್ಕ್ರಿಪ್ಟ್‌ಗಳನ್ನು ಬರೆದಿದ್ದೇವೆ. ನಮ್ಮ ಆರ್ಕೈವ್‌ಗೆ ಮಾತ್ರ ಇದನ್ನು ಉಪಯುಕ್ತವಾಗಿಸುವುದಲ್ಲ, ಶ್ಯಾಡೋ ಲೈಬ್ರರಿ ಮೆಟಾಡೇಟಾವನ್ನು ಆಡುವುದಕ್ಕೆ ಆಸಕ್ತಿ ಹೊಂದಿರುವ ಯಾರಿಗಾದರೂ ಸುಲಭವಾಗಿಸಲು ಉದ್ದೇಶವಾಗಿದೆ. ಉದ್ದೇಶವು ಎಲ್ಲಾ ರೀತಿಯ ಆಸಕ್ತಿದಾಯಕ ಮೆಟಾಡೇಟಾವನ್ನು ಹೊಂದಿರುವ ಜುಪಿಟರ್ ನೋಟ್ಬುಕ್ ಆಗಿರುತ್ತದೆ, ಆದ್ದರಿಂದ ನಾವು ISBN ಗಳ ಶಾಶ್ವತ ಸಂರಕ್ಷಣೆ ಶೇಕಡಾವಾರು ಅಂಶವನ್ನು ಕಂಡುಹಿಡಿಯುವಂತಹ ಹೆಚ್ಚಿನ ಸಂಶೋಧನೆಗಳನ್ನು ಮಾಡಬಹುದು."

#, fuzzy
msgid "blog.annas-update-2022.open-source.text5"
msgstr "ಅಂತಿಮವಾಗಿ, ನಾವು ನಮ್ಮ ದೇಣಿಗೆ ವ್ಯವಸ್ಥೆಯನ್ನು ಪುನರ್‌ವ್ಯವಸ್ಥಿತಗೊಳಿಸಿದ್ದೇವೆ. ನೀವು ಈಗ ಕ್ರೆಡಿಟ್ ಕಾರ್ಡ್ ಬಳಸಿ ನೇರವಾಗಿ ನಮ್ಮ ಕ್ರಿಪ್ಟೋ ವಾಲೆಟ್‌ಗಳಿಗೆ ಹಣವನ್ನು ಠೇವಣಿ ಮಾಡಬಹುದು, ಕ್ರಿಪ್ಟೋಕರೆನ್ಸಿಗಳ ಬಗ್ಗೆ ಏನನ್ನೂ ತಿಳಿಯಬೇಕಾಗಿಲ್ಲ. ಇದು ಪ್ರಾಯೋಗಿಕವಾಗಿ ಹೇಗೆ ಕಾರ್ಯನಿರ್ವಹಿಸುತ್ತದೆ ಎಂಬುದನ್ನು ನಾವು ನಿರಂತರವಾಗಿ ಗಮನಿಸುತ್ತೇವೆ, ಆದರೆ ಇದು ದೊಡ್ಡ ವಿಷಯವಾಗಿದೆ."

