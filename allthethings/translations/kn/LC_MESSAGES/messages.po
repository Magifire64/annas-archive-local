#, fuzzy
msgid "blog.ai-copyright.text1"
msgstr "ಇತ್ತೀಚೆಗೆ, “ನೆರಳಿನ-ಗ್ರಂಥಾಲಯಗಳು” ನಾಶವಾಗುತ್ತಿವೆ. Sci-Hub, ಅಕಾಡೆಮಿಕ್ ಲೇಖನಗಳ ಭಾರೀ ಅಕ್ರಮ ಆರ್ಕೈವ್, ಹೊಸ ಕೃತಿಗಳನ್ನು ಸ್ವೀಕರಿಸುವುದನ್ನು ನಿಲ್ಲಿಸಿತ್ತು, ಕಾನೂನು ಪ್ರಕರಣಗಳ ಕಾರಣದಿಂದ. “Z-ಗ್ರಂಥಾಲಯ”, ಅತಿದೊಡ್ಡ ಅಕ್ರಮ ಪುಸ್ತಕ ಗ್ರಂಥಾಲಯ, ಅದರ ಆರೋಪಿತ ಸೃಷ್ಟಿಕರ್ತರು ಕಾನೂನು ಕಾಪಿರೈಟ್ ಆರೋಪಗಳಲ್ಲಿ ಬಂಧಿತರಾದರು. ಅವರು ತಮ್ಮ ಬಂಧನದಿಂದ ತಪ್ಪಿಸಿಕೊಳ್ಳಲು ಅಸಾಧಾರಣವಾಗಿ ಯಶಸ್ವಿಯಾದರು, ಆದರೆ ಅವರ ಗ್ರಂಥಾಲಯದ ಮೇಲೆ ಬೆದರಿಕೆ ಕಡಿಮೆ ಆಗಿಲ್ಲ."

#, fuzzy
msgid "blog.ai-copyright.text2"
msgstr "Z-ಗ್ರಂಥಾಲಯವನ್ನು ಮುಚ್ಚುವಾಗ, ನಾನು ಅದರ ಸಂಪೂರ್ಣ ಗ್ರಂಥಾಲಯವನ್ನು ಬ್ಯಾಕಪ್ ಮಾಡಿದ್ದೆ ಮತ್ತು ಅದನ್ನು ಇರಿಸಲು ವೇದಿಕೆಯನ್ನು ಹುಡುಕುತ್ತಿದ್ದೆ. ಅದು ನನ್ನನ್ನು Anna’s Archive ಪ್ರಾರಂಭಿಸಲು ಪ್ರೇರೇಪಿಸಿತು: ಆ ಹಿಂದಿನ ಉಪಕ್ರಮಗಳ ಹಿಂದಿನ ಮಿಷನ್‌ನ ಮುಂದುವರಿಕೆ. ನಾವು ಈಗಾಗಲೇ 140 ಮಿಲಿಯನ್ ಕಾಪಿರೈಟ್ ಪಠ್ಯಗಳನ್ನು ವಿವಿಧ ಸ್ವರೂಪಗಳಲ್ಲಿ — ಪುಸ್ತಕಗಳು, ಅಕಾಡೆಮಿಕ್ ಲೇಖನಗಳು, ಮಾಗಜಿನ್‌ಗಳು, ಪತ್ರಿಕೆಗಳು, ಮತ್ತು ಇನ್ನಷ್ಟು — ಹೊಂದಿರುವ ವಿಶ್ವದ ಅತಿದೊಡ್ಡ ನೆರಳಿನ ಗ್ರಂಥಾಲಯವಾಗಿ ಬೆಳೆದಿದ್ದೇವೆ."

#, fuzzy
msgid "blog.ai-copyright.text3"
msgstr "ನನ್ನ ತಂಡ ಮತ್ತು ನಾನು ಸಿದ್ಧಾಂತಪರರು. ಈ ಕಡತಗಳನ್ನು ಸಂರಕ್ಷಿಸುವುದು ಮತ್ತು ಹೋಸ್ಟ್ ಮಾಡುವುದು ನೈತಿಕವಾಗಿ ಸರಿಯಾಗಿದೆ ಎಂದು ನಾವು ನಂಬುತ್ತೇವೆ. ವಿಶ್ವದಾದ್ಯಂತ ಗ್ರಂಥಾಲಯಗಳು ಹಣಕಾಸಿನ ಕಡಿತಗಳನ್ನು ಎದುರಿಸುತ್ತಿವೆ, ಮತ್ತು ನಾವು ಮಾನವತೆಯ ಪರಂಪರೆಯನ್ನು ಕಂಪನಿಗಳಿಗೆ ನಂಬಲು ಸಾಧ್ಯವಿಲ್ಲ."

#, fuzzy
msgid "blog.ai-copyright.text4"
msgstr "ನಂತರ AI ಬಂತು. LLMಗಳನ್ನು ನಿರ್ಮಿಸುತ್ತಿರುವ ಎಲ್ಲಾ ಪ್ರಮುಖ ಕಂಪನಿಗಳು ನಮ್ಮ ಡೇಟಾದ ಮೇಲೆ ತರಬೇತಿ ಪಡೆಯಲು ನಮ್ಮನ್ನು ಸಂಪರ್ಕಿಸಿದವು. ಬಹುಶಃ (ಆದರೆ ಎಲ್ಲಾ ಅಲ್ಲ!) ಅಮೇರಿಕಾದ ಕಂಪನಿಗಳು ನಮ್ಮ ಕೆಲಸದ ಅಕ್ರಮ ಸ್ವಭಾವವನ್ನು ಅರಿತ ನಂತರ ಪುನಃ ಪರಿಗಣಿಸಿದವು. ಇದಕ್ಕೆ ವಿರುದ್ಧವಾಗಿ, ಚೀನಾದ ಕಂಪನಿಗಳು ನಮ್ಮ ಸಂಗ್ರಹವನ್ನು ಉತ್ಸಾಹದಿಂದ ಸ್ವೀಕರಿಸಿವೆ, ಅದರ ಕಾನೂನಾತ್ಮಕತೆಯ ಬಗ್ಗೆ ತೊಂದರೆಗೊಳಗಾಗದೆ. ಇದು ಚೀನಾದ ಪ್ರಮುಖ ಅಂತಾರಾಷ್ಟ್ರೀಯ ಕಾಪಿರೈಟ್ ಒಪ್ಪಂದಗಳಿಗೆ ಸಹಿ ಹಾಕಿದ ದೇಶದ ಪಾತ್ರವನ್ನು ಗಮನಿಸಿದಾಗ ಗಮನಾರ್ಹವಾಗಿದೆ."

#, fuzzy
msgid "blog.ai-copyright.text5"
msgstr "ನಾವು ಸುಮಾರು 30 ಕಂಪನಿಗಳಿಗೆ ಹೈ-ಸ್ಪೀಡ್ ಪ್ರವೇಶವನ್ನು ನೀಡಿದ್ದೇವೆ. ಅವುಗಳಲ್ಲಿ ಹೆಚ್ಚಿನವು LLM ಕಂಪನಿಗಳು, ಮತ್ತು ಕೆಲವು ಡೇಟಾ ಬ್ರೋಕರ್‌ಗಳು, ಅವರು ನಮ್ಮ ಸಂಗ್ರಹವನ್ನು ಮರುಮಾರಾಟ ಮಾಡುತ್ತಾರೆ. ಹೆಚ್ಚಿನವು ಚೀನಾದವು, ಆದರೆ ನಾವು ಅಮೇರಿಕಾ, ಯುರೋಪ್, ರಷ್ಯಾ, ದಕ್ಷಿಣ ಕೊರಿಯಾ, ಮತ್ತು ಜಪಾನ್‌ನ ಕಂಪನಿಗಳೊಂದಿಗೆ ಸಹ ಕೆಲಸ ಮಾಡಿದ್ದೇವೆ. DeepSeek <a %(arxiv)s>ಸ್ವೀಕರಿಸಿದೆ</a> ಅದರ ಹಿಂದಿನ ಆವೃತ್ತಿ ನಮ್ಮ ಸಂಗ್ರಹದ ಭಾಗದ ಮೇಲೆ ತರಬೇತಿ ಪಡೆದಿತ್ತು, ಆದರೆ ಅವರ ಇತ್ತೀಚಿನ ಮಾದರಿಯ ಬಗ್ಗೆ ಅವರು ಮೌನವಾಗಿದ್ದಾರೆ (ಬಹುಶಃ ಅದು ಸಹ ನಮ್ಮ ಡೇಟಾದ ಮೇಲೆ ತರಬೇತಿ ಪಡೆದಿರಬಹುದು)."

#, fuzzy
msgid "blog.ai-copyright.text6"
msgstr "ಪಶ್ಚಿಮ ದೇಶಗಳು LLMಗಳ ಸ್ಪರ್ಧೆಯಲ್ಲಿ ಮುಂಚಿತವಾಗಿರಲು, ಮತ್ತು ಅಂತಿಮವಾಗಿ, AGIಗೆ, ಕಾಪಿರೈಟ್ ಬಗ್ಗೆ ತಮ್ಮ ಸ್ಥಾನವನ್ನು ಪುನಃ ಪರಿಗಣಿಸಬೇಕಾಗಿದೆ, ಮತ್ತು ಶೀಘ್ರದಲ್ಲೇ. ನಮ್ಮ ನೈತಿಕ ಪ್ರಕರಣದ ಬಗ್ಗೆ ನೀವು ನಮ್ಮೊಂದಿಗೆ ಒಪ್ಪಿಕೊಳ್ಳುತ್ತೀರಾ ಅಥವಾ ಇಲ್ಲವೇ ಎಂಬುದನ್ನು ಬಿಟ್ಟು, ಇದು ಈಗ ಆರ್ಥಿಕತೆಯ ಮತ್ತು ರಾಷ್ಟ್ರದ ಭದ್ರತೆಯ ವಿಷಯವಾಗುತ್ತಿದೆ. ಎಲ್ಲಾ ಶಕ್ತಿ ಬ್ಲಾಕ್‌ಗಳು ಕೃತಕ ಸೂಪರ್-ವಿಜ್ಞಾನಿಗಳು, ಸೂಪರ್-ಹ್ಯಾಕರ್‌ಗಳು, ಮತ್ತು ಸೂಪರ್-ಸೈನ್ಯಗಳನ್ನು ನಿರ್ಮಿಸುತ್ತಿವೆ. ಮಾಹಿತಿಯ ಸ್ವಾತಂತ್ರ್ಯವು ಈ ದೇಶಗಳಿಗೆ ಬದುಕುಳಿಯುವ ವಿಷಯವಾಗುತ್ತಿದೆ — ಅಂದರೆ ರಾಷ್ಟ್ರದ ಭದ್ರತೆಯ ವಿಷಯ."

#, fuzzy
msgid "blog.ai-copyright.text7"
msgstr "ನಮ್ಮ ತಂಡವು ವಿಶ್ವದಾದ್ಯಂತದಿಂದ ಬಂದಿದೆ, ಮತ್ತು ನಾವು ಯಾವುದೇ ವಿಶೇಷ ಹೊಂದಾಣಿಕೆಯನ್ನು ಹೊಂದಿಲ್ಲ. ಆದರೆ ನಾವು ಬಲವಾದ ಕಾಪಿರೈಟ್ ಕಾನೂನುಗಳನ್ನು ಹೊಂದಿರುವ ದೇಶಗಳನ್ನು ಈ ಅಸ್ತಿತ್ವದ ಬೆದರಿಕೆಯನ್ನು ಬಳಸಲು ಪ್ರೋತ್ಸಾಹಿಸುತ್ತೇವೆ. ಹಾಗಾದರೆ ಏನು ಮಾಡಬೇಕು?"

#, fuzzy
msgid "blog.ai-copyright.text8"
msgstr "ನಮ್ಮ ಮೊದಲ ಶಿಫಾರಸು ಸರಳವಾಗಿದೆ: ಕಾಪಿರೈಟ್ ಅವಧಿಯನ್ನು ಕಡಿಮೆ ಮಾಡುವುದು. ಅಮೇರಿಕಾದಲ್ಲಿ, ಕಾಪಿರೈಟ್ ಲೇಖಕರ ಮರಣದ 70 ವರ್ಷಗಳ ನಂತರ ನೀಡಲಾಗುತ್ತದೆ. ಇದು ಅಸಂಬದ್ಧವಾಗಿದೆ. ನಾವು ಇದನ್ನು ಪೇಟೆಂಟ್‌ಗಳೊಂದಿಗೆ ಹೊಂದಾಣಿಕೆಗೆ ತರುವಂತೆ ಮಾಡಬಹುದು, ಅವುಗಳನ್ನು ಸಲ್ಲಿಕೆಯ 20 ವರ್ಷಗಳ ನಂತರ ನೀಡಲಾಗುತ್ತದೆ. ಇದು ಪುಸ್ತಕಗಳು, ಲೇಖನಗಳು, ಸಂಗೀತ, ಕಲೆ, ಮತ್ತು ಇತರ ಸೃಜನಾತ್ಮಕ ಕೃತಿಗಳ ಲೇಖಕರಿಗೆ ಅವರ ಪ್ರಯತ್ನಗಳಿಗೆ ಸಂಪೂರ್ಣವಾಗಿ ಪರಿಹಾರ ನೀಡಲು ಸಾಕಷ್ಟು ಸಮಯವಾಗಿರುತ್ತದೆ (ಚಲನಚಿತ್ರ ರೂಪಾಂತರಗಳಂತಹ ದೀರ್ಘಕಾಲಿಕ ಯೋಜನೆಗಳನ್ನು ಒಳಗೊಂಡಂತೆ)."

#, fuzzy
msgid "blog.ai-copyright.text9"
msgstr "ನಂತರ, ಕನಿಷ್ಠ, ನೀತಿ ನಿರ್ಧಾರಕರು ಪಠ್ಯಗಳ ಸಾಮೂಹಿಕ ಸಂರಕ್ಷಣೆ ಮತ್ತು ಪ್ರಸರಣಕ್ಕಾಗಿ ಹೊರತಾಗುವಿಕೆಗಳನ್ನು ಸೇರಿಸಬೇಕು. ವೈಯಕ್ತಿಕ ಗ್ರಾಹಕರಿಂದ ಕಳೆದುಹೋದ ಆದಾಯ ಮುಖ್ಯ ಚಿಂತೆ ಆಗಿದ್ದರೆ, ವೈಯಕ್ತಿಕ ಮಟ್ಟದ ವಿತರಣೆಯನ್ನು ನಿಷೇಧಿಸಬಹುದು. ಬದಲಾಗಿ, LLMಗಳನ್ನು ತರಬೇತಿ ನೀಡುವ ಕಂಪನಿಗಳು, ಗ್ರಂಥಾಲಯಗಳು ಮತ್ತು ಇತರ ಆರ್ಕೈವ್‌ಗಳೊಂದಿಗೆ, ಈ ಹೊರತಾಗುವಿಕೆಗಳಿಂದ ಆವೃತವಾಗಿರಬಹುದು."

#, fuzzy
msgid "blog.ai-copyright.text10"
msgstr "ಕೆಲವು ದೇಶಗಳು ಈಗಾಗಲೇ ಇದರ ಒಂದು ಆವೃತ್ತಿಯನ್ನು ಮಾಡುತ್ತಿವೆ. TorrentFreak <a %(torrentfreak)s>ವರದಿ ಮಾಡಿದೆ</a> ಚೀನಾ ಮತ್ತು ಜಪಾನ್ ತಮ್ಮ ಕಾಪಿರೈಟ್ ಕಾನೂನುಗಳಿಗೆ AI ಹೊರತಾಗುವಿಕೆಗಳನ್ನು ಪರಿಚಯಿಸಿವೆ. ಇದು ಅಂತಾರಾಷ್ಟ್ರೀಯ ಒಪ್ಪಂದಗಳೊಂದಿಗೆ ಹೇಗೆ ಸಂವಹನ ಮಾಡುತ್ತದೆ ಎಂಬುದು ನಮಗೆ ಸ್ಪಷ್ಟವಿಲ್ಲ, ಆದರೆ ಇದು ಖಂಡಿತವಾಗಿಯೂ ಅವರ ದೇಶೀಯ ಕಂಪನಿಗಳಿಗೆ ಆವರಣವನ್ನು ನೀಡುತ್ತದೆ, ಇದು ನಾವು ನೋಡುತ್ತಿರುವುದನ್ನು ವಿವರಿಸುತ್ತದೆ."

#, fuzzy
msgid "blog.ai-copyright.text11"
msgstr "Anna’s Archiveಗೆ ಬಂದರೆ — ನಾವು ನೈತಿಕ ನಂಬಿಕೆಯಲ್ಲಿ ನೆಲೆಸಿದ ನಮ್ಮ ಭೂಗತ ಕೆಲಸವನ್ನು ಮುಂದುವರಿಸುತ್ತೇವೆ. ಆದರೂ ನಮ್ಮ ದೊಡ್ಡ ಆಶಯವು ಬೆಳಕಿಗೆ ಬಂದು, ನಮ್ಮ ಪರಿಣಾಮವನ್ನು ಕಾನೂನಾತ್ಮಕವಾಗಿ ವಿಸ್ತರಿಸುವುದು. ದಯವಿಟ್ಟು ಕಾಪಿರೈಟ್ ಅನ್ನು ಸುಧಾರಿಸಿ."

