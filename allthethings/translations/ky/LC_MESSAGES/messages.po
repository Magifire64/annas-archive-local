#, fuzzy
msgid "blog.annas-archive-containers.standard.metadata-file.jsonlines"
msgstr "Файл кеңейтүүсү көрсөткөндөй, файл түрү <a %(jsonlines)s>JSON Lines</a> <a %(zstd)s>Zstandard</a> менен кысылган."

