#, fuzzy
msgid "blog.critical-window.priorities.order.measurements"
msgstr "Xogta cabbirka sida cabbiraadyada sayniska, xogta dhaqaalaha, warbixinada shirkadaha"

#, fuzzy
msgid "blog.critical-window.priorities.order.science-websites"
msgstr "Bogagga internetka ee sayniska & injineerinka, doodaha khadka tooska ah"

#, fuzzy
msgid "blog.critical-window.priorities.order.nonfiction-other"
msgstr "Joornaalada aan sheeko-faneed ahayn, wargeysyada, buugaagta hagaha"

#, fuzzy
msgid "blog.critical-window.priorities.order.nonfiction-transcripts"
