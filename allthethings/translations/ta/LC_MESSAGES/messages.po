#, fuzzy
msgid "blog.all-isbns-winners.third2.text1"
msgstr "மிகவும் பளபளப்பான UI அல்ல, ஆனால் இந்த <a %(annas_archive_note_2917)s>சமர்ப்பிப்பு</a> பல பெட்டிகளை சரிபார்க்கிறது. குறிப்பாக அதன் ஒப்பீட்டு அம்சத்தை நாங்கள் விரும்பினோம்."

#, fuzzy
