msgstr "<a %(critical_window_chinese)s>Versión en chinés 中文版</a>, discuti en <a %(reddit)s>Reddit</a>, <a %(news_ycombinator)s>Hacker News</a>"

#, fuzzy
msgid "blog.critical-window.text1"
