#, fuzzy
msgid "blog.critical-window.storage.text4"
msgstr "نرخەکانی هارد درایڤ بۆ هەر TB یەک بە شێوەیەکی زۆر بەردەوامە لە ماوەی ١٠ ساڵی ڕابردووەوە، و بە شێوەیەکی زۆر بەردەوامە بەرزتر دەبێت. تێپ وەک هەمان ڕێژەیە. نرخەکانی SSD بە شێوەیەکی زۆر خێراتر دابەزین، و دەتوانن نرخەکانی HDD بەرزتر بکەن تا کۆتایی داهەیە."

#, fuzzy
msgid "blog.critical-window.hdd-prices"
msgstr "ڕوونکردنەوەی نرخەکانی HDD لە چەند سەرچاوەیەکی جیاوازەوە (کرتە بکە بۆ بینینی توێژینەوە)."

#, fuzzy
msgid "blog.critical-window.storage.text5"
msgstr "ئەگەر ئەمە بەردەوام بێت، ئەوا لە ١٠ ساڵدا دەتوانین تەنها $5,000–$13,000 بۆ کۆپیکردن وەک خۆی کۆلێکشنەکانمان (١/٣)، یان هەتا کەمتر ئەگەر بە شێوەیەکی زۆر بەرزتر نەبێت. هەروەها زۆر پارەیە، بەڵام ئەمە بەرزە بۆ زۆرینەی کەسان. و ئەمە دەتوانێت باشتر بێت بەهۆی خاڵی دواتر…"

#, fuzzy
msgid "blog.critical-window.storage.density"
msgstr "٣. باشترکردنی چڕی زانیاری"

#, fuzzy
msgid "blog.critical-window.storage.density.text1"
msgstr "ئێستا کتێبەکانمان لە فۆرماتە خاوەنانەدا پاشەکەوت دەکەین کە بۆمان ناردراون. بەڵام زۆربەی ئەمانە هێشتا سکانە گەورەکان یان وێنەی پەڕەکانن."

#, fuzzy
msgid "blog.critical-window.storage.density.text2"
msgstr "تا ئێستا، تەنها هەڵبژاردنەکان بۆ کەمکردنەوەی قەبارەی کۆمەڵەمان بە فشاردانی زۆرتر یان لابردنی دووبارەبوون بووە. بەڵام، بۆ بەدەستهێنانی پارەدانێکی گرنگ، هەردووە زۆر زۆر لەبەرمانە. فشاردانی زۆری وێنەکان دەکرێت دەق بە زۆری نەخوێندراو بێت. و لابردنی دووبارەبوون پێویستی بە باوەڕی زۆری هەیە کە کتێبەکان وەک یەکە، کە زۆرجار زۆر نادروستە، تایبەتمەندی ئەگەر ناوەڕۆکەکان وەک یەک بێت بەڵام سکانەکان لە کاتە جیاوازەکاندا کراون."

#, fuzzy
msgid "blog.critical-window.storage.density.text3"
msgstr "هەموو کاتێک هەڵبژاردنێکی سێهەمی هەبووە، بەڵام کوالیتیەکەی زۆر خراپ بووە کە هەرگیز بیرمان لەسەر نەکرد: <strong>OCR، یان ناساندنی تایبەتمەندی ڕووناکی</strong>. ئەمە پرۆسەی گۆڕینی وێنەکان بۆ دەقی خاوەندە، بە بەکارهێنانی AI بۆ ناساندنی تایبەتمەندەکان لە وێنەکاندا. ئەم ئامرازانە زۆر کاتەیەکە هەبوون، و زۆر باش بوون، بەڵام \"زۆر باش\" بۆ مەبەستەکانی پاراستن بەس نییە."

#, fuzzy
msgid "blog.critical-window.storage.density.text4"
msgstr "بەڵام، مۆدێلەکانی فێرکردنی ژەهراوی چەند ڕووناکیەکان بە شێوەیەکی زۆر خێرا پێشکەوتووە، هەروەها بە تێچوونی زۆر. ئێمە چاوەڕوانین هەردوو ڕاستی و تێچوون بە شێوەیەکی زۆر باش پێشکەوتن لە ساڵەکانی داهاتوودا، بۆ ئەوەی بێت بە شێوەیەکی ڕاستەقینە بەرز بکرێت بەرەو کتێبخانەمان."

#, fuzzy
msgid "blog.critical-window.ocr"
msgstr "پیشکەوتنەکانی OCR."

#, fuzzy
msgid "blog.critical-window.storage.density.text5"
msgstr "کاتێک ئەوە ڕوویدا، لەوانەیە هێشتا فایلە سەرەکیەکان پاراستن، بەڵام بە پەیوەندیدانی ئەوە دەتوانین وەشانی زۆر بچووکتر لە کتێبخانەمان هەبێت کە زۆربەی خەڵک دەتوانن کۆپیکردن وەک خۆی بکەن. ئەوەی زۆر گرنگە ئەوەیە کە دەقی خاوەندە خۆی باشتر فشاردەکرێت، و زۆر ئاسانترە بۆ لابردنی دووبارەبوون، پارەدانێکی زیاترمان دەدات."

#, fuzzy
msgid "blog.critical-window.storage.density.text6"
msgstr "بە گشتی، ناتوانین چاوەڕوانی کەمکردنەوەی قەبارەی فایلەکان بە ٥-١٠ هەندێکی کەمتر بێت، لەوانەیە زیاتر. هەتا بە کەمکردنەوەی ٥ هەندێکی پارێزراو، ئێمە بە <strong>$١,٠٠٠–$٣,٠٠٠ لە ١٠ ساڵدا سەیر دەکەین هەتا ئەگەر کتێبخانەمان سێجارە بەرز بکرێت</strong>."

#, fuzzy
msgid "blog.critical-window.the-window"
msgstr "پەنجەرەی گرنگ"

#, fuzzy
msgid "blog.critical-window.the-window.text1"
msgstr "ئەگەر ئەم پێشبینییانە ڕاست بێت، ئێمە <strong>تەنها پێویستە چەند ساڵێک چاوەڕوان بکەین</strong> پێش ئەوەی کۆمەڵەمان بە شێوەیەکی فراوان کۆپیکردن وەک خۆی بکرێت. بە شێوەی توماس جێفەرسان، \"لە دەستەوەی ڕووداوەکان دابنرێت.\""

#, fuzzy
msgid "blog.critical-window.the-window.text2"
msgstr "بەداخەوە، هاتنی LLMەکان، و فێرکردنی زۆر زانیارییان، زۆر کەسەکان بە شێوەیەکی زۆر بەرزە. زۆرتر لە ئەوەی پێشتر بوون. زۆر وێبسایتەکان بە شێوەیەکی زۆر قورس دەکەن بۆ کۆکردنەوە و ئەرشیڤکردن، دادگا بە شێوەیەکی زۆر دەچنە پێش، و هەموو کاتەکە کتێبخانە فیزیکیەکان و ئەرشیڤەکان بە شێوەیەکی زۆر نادروست دەبن."

#, fuzzy
msgid "blog.critical-window.the-window.text3"
msgstr "تەنها چاوەڕوانی ئەمە دەکەین کە ئەم ڕووناکییانە بە شێوەیەکی زۆر بەرز دەبن، و زۆر کارەکان بە شێوەیەکی زۆر لەناوەڕۆکی گشتی نادیبن."

#, fuzzy
msgid "blog.critical-window.the-window.text4"
msgstr "<strong>ئێمە لە شەوی پەیوەندیدانی پاراستنەکاندا هەستین، بەڵام <q>ئەوەی لەدەستدا ناتوانرێت بگەڕێنرێت.</q></strong> ئێمە پەنجەرەیەکی گرنگی ٥-١٠ ساڵەمان هەیە کە هێشتا بە شێوەیەکی زۆر بەرزە بۆ کارکردنی کتێبخانەی سێبەری ئەلیکترۆنی و دروستکردنی زۆر کۆپیکردن وەک خۆی لە سەرانسەری جیهان، و کە لەوانەیە هێشتا بە شێوەیەکی زۆر بەرز نەبێت."

#, fuzzy
msgid "blog.critical-window.the-window.text5"
msgstr "ئەگەر بتوانین ئەم پەنجەرەیە بڕوانین، ئەوا بەڕاستی زانیاری و کەلتوری مرۆڤایەتی بە شێوەیەکی هەردەم پاراستووە. پێویستە ئەم کاتە بە فایده نەبەستین. پێویستە ئەم پەنجەرەیەی گرنگی لەسەرمان نەبەستێت."

