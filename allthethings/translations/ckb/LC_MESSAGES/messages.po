msgid "blog.worldcat-scrape.tldr"
msgstr "<em><strong>کورتەیەک:</strong> کتێبخانەی ئەنایە هەموو وەرگرتنی WorldCat (گەورەترین کۆمەڵەی metadataی کتێب لە جیهان) کرد بۆ دروستکردنی لیستی کارەکان بۆ کتێبەکان کە پێویستە پاراستن.</em>"

#, fuzzy
msgid "blog.worldcat-scrape.text1"
msgstr "ساڵێک لەمەوبەر، <a %(blog)s>هەوڵماندا</a> ئەم پرسیارە وەڵام بدەین: <strong>چەند ڕێژەیەک لە کتێبەکان بە شێوەیەکی هەردەم پاراستنەوە لە کتێبخانە سێبەرە ئەلیکترۆنیەکان؟</strong>"

#, fuzzy
msgid "blog.worldcat-scrape.text2"
msgstr "کاتێک کتێبێک بەرزەنگاری دەکرێت بۆ کتێبخانەی سێبەری ئەلیکترۆنییەکی داتا کراوە وەک <a %(wikipedia_library_genesis)s>Library Genesis</a>، و ئێستا <a %(wikipedia_annas_archive)s>کتێبخانەی ئەنایە</a>، لە هەموو جیهانەوە وەشانی دەکرێت (بە شێوەی تورەنت)، بە شێوەیەکی ڕاستەوخۆ پاراستنی هەردەمە."

#, fuzzy
msgid "blog.worldcat-scrape.text3"
msgstr "بۆ وەڵامدانی پرسیاری چەند ڕێژەیەک لە کتێبەکان پاراستنەوە، پێویستە بزانین چەند کتێب هەیە بە گشتی؟ و بە باشترین شێوە تەنها ژمارەیەکمان نییە، بەڵکو metadataی ڕاستەقینەمان هەبێت. پاشان ناتەنها دەتوانین پێویستەکانمان لەگەڵ کتێبخانە سێبەرە ئەلیکترۆنیەکان وەکەین، بەڵکو <strong>لیستی کارەکان دروست بکەین بۆ کتێبەکان کە پێویستە پاراستن!</strong> هەتا دەتوانین خەونەکانمان دەربارەی هەوڵێکی بەشکراوە بۆ پەیوەندیدانی ئەم لیستی کارەکانە دەبینین."

#, fuzzy
msgid "blog.worldcat-scrape.text4"
msgstr "ئێمە <a %(wikipedia_isbndb_com)s>ISBNdb</a> هەڵگرتین، و داتای <a %(openlibrary)s>Open Library</a> داگرتین، بەڵام ئەنجامەکان قانەبخشی نەبوو. کێشەی سەرەکی ئەوە بوو کە زۆرترین هاوبەشبوونی ISBN نەبوو. ئەم ڤێن ڕەسمە ببینە لە <a %(blog)s>بابەتی بڵاگمان</a>:"

#, fuzzy
msgid "blog.worldcat-scrape.text5"
msgstr "زۆر سوپڕایزمان کرد کە چەند هاوبەشبوونی کەم بوو لە نێوان ISBNdb و Open Library، کە هەردووکیان بە فراوانی داتا لە سەرچاوە جیاوازەکان وەردەگرن، وەک هەڵگرتنی وێب و تۆمارە کتێبخانەییەکان. ئەگەر هەردووکیان کارێکی باش بکەن لە دۆزینەوەی زۆرترین ISBN لە دەرەوە، بێگومان دووایەکیان هاوبەشبوونی زۆری هەبایە، یان یەکێکیان بەرزەیەکی یەکەی تر بێت. ئەمەمان واداکرد بپرسین، چەند کتێبەکانەیە کە <em>بە تەواوی لە دەرەوەی ئەم دووایانە دابن</em>? پێویستمان بە بنکەی داتایەکی گەورەترە."

#, fuzzy
msgid "blog.worldcat-scrape.worldcat"
msgstr "WorldCat"

#, fuzzy
msgid "blog.worldcat-scrape.text6"
msgstr "کاتێکە بوو کە سەیرمان کردەوە بەرزترین بنکەی داتای کتێب لە جیهان: <a %(wikipedia_worldcat)s>WorldCat</a>. ئەمە بنکەی داتایەکی تایبەتیە لەلایەن ڕێکخراوی نەفەعی <a %(wikipedia_oclc)s>OCLC</a>، کە تۆمارە metadata یەکانی کتێبخانەکان لە سەرتاسەری جیهان کۆدەکات، بە جێگرتنی ئەوەی کە ئەو کتێبخانانە دەستیان بە داتای تەواو دەبەخشێت، و ئەوانیش لە ئەنجامی گەڕانی بەکارهێنەران نیشان دەدرێن."

#, fuzzy
msgid "blog.worldcat-scrape.text7"
msgstr "هەروەها ئەگەرچی OCLC ڕێکخراویەکی نەفەعیە، مۆدێلی کارگێڕییان پێویستی بە پاراستنی بنکەی داتایان هەیە. باشە، بەرزەکانمان لە OCLC، بێزارین بڵێین، هەمووی دەبەخشین. :-)"

#, fuzzy
msgid "blog.worldcat-scrape.text8"
msgstr "لە ماوەی ساڵێکدا، بە وردی هەموو تۆمارەکانی WorldCat هەڵگرتین. لە سەرەتا، بەختەکی باشمان هەبوو. WorldCat تازە دەستپێکرد بە گۆڕینی تەواوی وێبسایتیان (لە تشرینی یەکەمی 2022). ئەمە گۆڕانکاریەکی زۆر لە سیستەمە پەشتیوانەکانیان بوو، کە زۆرترین کێشەی پاراستنیان هەبوو. بەرەوپێشمان هات و توانین سەدان ملیۆن (!) تۆمار بە هەندێک ڕۆژدا هەڵبگرین."

