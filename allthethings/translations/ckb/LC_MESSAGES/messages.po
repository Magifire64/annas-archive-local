#, fuzzy
msgid "blog.duxiu-exclusive.subtitle"
msgstr "<a %(duxiu_exclusive_chinese)s>وەشانی چینی 中文版</a>, <a %(news_ycombinator)s>لێدوان لە Hacker News</a>"

#, fuzzy
msgid "blog.duxiu-exclusive.tldr"
msgstr "<em><strong>کورتەیەک:</strong> ئەرشیڤی ئاننا کۆمەڵەیەکی تایبەتی ٧.٥ ملیۆن / ٣٥٠TB کتێبە نەخۆشییە چینیەکان بەدەستهێنا — گەورەتر لە Library Genesis. ئێمە ئامادەین بۆ دانانی دەستگەیشتنە تایبەتی بۆ کۆمپانیاکانی LLM، بە جێگۆڕینی OCRی بەرز و گەڕانەوەی دەق."

#, fuzzy
msgid "blog.duxiu-exclusive.text1"
msgstr "ئەمە پەیامێکی کورتەی بلاگە. ئێمە بەدوای کۆمپانیا یان دامەزراندنێک دەگەڕێین بۆ یارمەتی دان بە OCR و گەڕانەوەی دەق بۆ کۆمەڵەیەکی زۆر گەورە کە بەدەستهێنان، بە جێگۆڕینی دەستگەیشتنە تایبەتییەکی زوو. دوای کاتی ڕاگرتن، بەڵامەکانەمان بە شێوەیەکی تەواو بڵاو دەکەینەوە."

#, fuzzy
msgid "blog.duxiu-exclusive.text2"
msgstr "دەقە ئەکادیمییە بەرزەکانی بەرز زۆر بە سوودە بۆ ڕاهێنانەوەی LLMەکان. هەروەها ئەوەی کۆکردنەوەکەمان بە چینییە، ئەمە دەبێت هەتا بۆ ڕاهێنانەوەی LLMە ئینگلیزیەکانیش بە سوود بێت: مۆدێلەکان وەک ئەوەی دەردەکەون کۆنسیپت و زانیارییەکان بە بێ گونجاوی زمانە سەرچاوەکان."

#, fuzzy
msgid "blog.duxiu-exclusive.text3"
msgstr "بۆ ئەمە، دەق پێویستە لە سکانەکان وەرگیراو بکرێت. چەی ئەرشەفی ئانایە لەوە دەبێت؟ گەڕانی تەواوی دەقەکان بۆ بەکارهێنەرانەکەی."

#, fuzzy
msgid "blog.duxiu-exclusive.text4"
msgstr "چونکە ئامانجەکانمان لەگەڵ ئەوەی پەرەپێدەرانی LLMەکان یەکسانە، ئێمە بەدوای هاوکارێک دەگەڕێین. ئێمە ئامادەین بۆ ئەوەی <strong>دەستپێکی تایبەتی زوو بۆ ئەم کۆکردنەوەیە بە شێوەیەکی گشتی بۆ ١ ساڵ بۆ تۆ بدەین</strong>، ئەگەر بتوانیت OCR و وەرگرتنی دەق بە شێوەیەکی ڕاستەقینە بکەیت. ئەگەر ئامادە بیت کۆدی تەواوی پەیپڵاینەکەت لەگەڵ ئێمە بەش بکەیت، ئێمە ئامادەین کۆکردنەوەکە بۆ ماوەیەکی درێژتر بەرز بکه‌ین."

#, fuzzy
msgid "blog.duxiu-exclusive.example_pages"
msgstr "لاپەڕە نموونەکان"

#, fuzzy
msgid "blog.duxiu-exclusive.example_pages.text1"
msgstr "بۆ ئەوەی بۆ ئێمە بەرز بکه‌یت کە پەیپڵاینەکی باشت هەیە، ئەمانە هەندێک لاپەڕە نموونەیە بۆ دەستپێکردن، لە کتێبێک سەبارەت بە سوپەرکۆندەکتۆرەکان. پەیپڵاینەکەت دەبێت بە شێوەیەکی ڕاستەقینە ڕەوشی ماتماتیک، خشتەکان، شارتەکان، پاوەنووسەکان، و هتد بگرێت."

#, fuzzy
msgid "blog.duxiu-exclusive.example_pages.text2"
msgstr "پەڕەکانت کە پڕۆسەی کردووە بۆ ئیمەیڵەکەمان بنێرە. ئەگەر باش بن، ئێمە زیاتر بۆ تۆ بە شێوەیەکی تایبەتی ئەنێرین، و ئێمە چاوەڕوانین کە بتوانیت زوو پەیپڵاینەکەت لەسەر ئەوانیش بڕوانیت. کاتێک کەمان قەناعت پێمان هات، ئێمە دەتوانین پەیوەندیدانێک بکەین."

#, fuzzy
msgid "blog.duxiu-exclusive.collection"
msgstr "کۆکردنەوە"

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text1"
msgstr "هەندێک زانیاری زیاتر سەبارەت بە کۆکردنەوەکە. <a %(duxiu)s>Duxiu</a> بنکەیەکی گەورەی کتێبە سکانکراوەکانە، دروستکراوە لەلایەن <a %(chaoxing)s>گروپی کتێبخانەی دیجیتاڵی سوپەرستار</a>. زۆربەی ئەمانە کتێبە ئەکادیمییەکانن، سکانکراون بۆ ئەوەی بە شێوەیەکی دیجیتاڵی بۆ زانکۆکان و کتێبخانەکان بەردەست بکرێن. بۆ بینەرانی ئینگلیزی زمانمان، <a %(library_princeton)s>پرینستۆن</a> و <a %(guides_lib_uw)s>زانکۆی واشینگتۆن</a> پێداچوونەوەیەکی باشیان هەیە. هەروەها وتارێکی زۆر باشیش هەیە کە پەیوەندیدانی زیاتر دەدات: <a %(doi)s>“دیجیتاڵکردنی کتێبە چینییەکان: کەیسێکی لەسەر ئەنجامی گەڕانی زانای سوپەرستار دوکسو”</a> (لە ئەرشەفی ئانایە بگەڕێنەوە)."

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text2"
msgstr "کتێبەکانی Duxiu ماوەیەکی درێژە لەسەر ئینتەرنێتی چینی بە بێ ڕێگەپێدان پەخشکراون. زۆربەی کاتەکان بە کەمتر لە یەک دۆلار لەلایەن فرۆشیارەکان فرۆشتن. زۆربەی کاتەکان بە شێوەیەکی چینی وەک گووگڵ درایڤ پەخش دەکرێن، کە زۆرجار هەک کراوە بۆ ڕێگەپێدان بە زۆرتر بەرزکردنی شوێن. هەندێک وردەکاری فنی دەتوانرێت <a %(github_duty_machine)s>لێرە</a> و <a %(github_821_github_io)s>لێرە</a> بدۆزرێتەوە."

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text3"
msgstr "هەروەها کتێبەکان بە شێوەیەکی نیو-گشتی پەخشکراون، بەڵام زۆر قورسە بە شێوەیەکی گشتی وەرگرتنیان. ئێمە ئەمە بەرز لە لیستی ئیشەکانمان داناوە، و چەند مانگێکی تەواو بۆ ئەوەی بە شێوەیەکی تەواو کار بکەین بەرز کرد. بەڵام، بە تازەیەکی هەژمارێکی بەرز، شایان، و توانایەکی فەرمی پەیوەندیمان پێوە کرد، و گوتی ئەوان هەموو ئەم کارەیان پێشتر کردووە — بە خەرجی زۆر. ئەوان کۆکردنەوەی تەواو لەگەڵ ئێمە بەش کرد، بە بێ ئەوەی هیچ شتێکی لەبەر بگرن، جگە لە دڵنیابوونەوەی پاراستنی ماوەیەکی درێژ. بەراستی شایانە. ئەوان ڕازی بوون بۆ ئەوەی بە شێوەیەکی ئەمە یارمەتی بپرسن بۆ وەرگرتنی کۆکردنەوەکە بە OCR."

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text4"
msgstr "کۆکردنەوەکە ٧،٥٤٣،٧٠٢ فایلە. ئەمە زیاترە لە کتێبخانەی جینەسیس نەخۆشی (نزیکەی ٥.٣ ملیۆن). قەبارەی تەواوی فایلەکان نزیکەی ٣٥٩TB (٣٢٦TiB) لە شێوەی ئێستایەوە."

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text5"
msgstr "ئێمە بەرزین بۆ پێشنیارەکان و بیرۆکەی تر. تەنها پەیوەندیمان پێوە بکە. ئەرشەفی ئانایە بزانە بۆ زانیاری زیاتر سەبارەت بە کۆکردنەوەکانمان، هەوڵە پاراستنەکانمان، و چۆن دەتوانیت یارمەتی بدەیت. سوپاس!"

