#, fuzzy
msgid "blog.annas-archive-containers.standard.metadata-file.jsonlines"
msgstr "Nk'uko byerekanywe n'inyongera y'inyandiko, ubwoko bw'inyandiko ni <a %(jsonlines)s>JSON Lines</a> yashyizwe mu buryo bwa <a %(zstd)s>Zstandard</a>."

#, fuzzy
msgid "blog.annas-archive-containers.standard.metadata-file.fields"
msgstr "Buri kintu cya JSON kigomba kuba gifite ibi bice bikurikira ku rwego rwo hejuru: <strong>aacid</strong>, <strong>metadata</strong>, <strong>data_folder</strong> (bitari ngombwa). Ibindi bice ntibyemewe."

#, fuzzy
msgid "blog.annas-archive-containers.standard.metadata-file.metadata"
