msgstr "Dushobora gute kuvuga ko tuzabika ingorane zacu iteka ryose, mu gihe ziri hafi kugera kuri 1 PB?"

#, fuzzy
msgid "blog.critical-window.links"
msgstr "<a %(critical_window_chinese)s>Icyongereza cy'Abashinwa 中文版</a>, ganira kuri <a %(reddit)s>Reddit</a>, <a %(news_ycombinator)s>Hacker News</a>"

#, fuzzy
