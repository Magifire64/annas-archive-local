msgstr "Existem mais recursos sobre o Arquivo da Anna?"

msgid "page.faq.resources.annas_blog"
msgstr "<a %(a_blog)s>Blog da Anna</a>, <a %(a_reddit_u)s>Reddit</a>, <a %(a_reddit_r)s>Subreddit</a> — atualizações regulares"

