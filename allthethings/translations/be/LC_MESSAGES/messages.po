msgid "blog.annas-archive-containers.goals.goal2"
msgstr "Гетэрагенныя ідэнтыфікатары ў крынічных бібліятэках або нават адсутнасць ідэнтыфікатараў."

#, fuzzy
msgid "blog.annas-archive-containers.goals.goal3"
