#, fuzzy
msgid "blog.all-isbns.bounty.bonus6"
msgstr "Спосабы адладкі праблем, такіх як іншыя metadata, якія не вельмі добра супадаюць (напрыклад, значна розныя назвы)."

#, fuzzy
