msgid "blog.how-to.signature"
msgstr "- ანა და გუნდი (<a %(reddit)s>Reddit</a>)"

#, fuzzy
msgid "blog.introducing.title"
msgstr "მეკობრე ბიბლიოთეკის სარკის წარდგენა: 7TB წიგნების შენარჩუნება (რომლებიც არ არის Libgen-ში)"

#, fuzzy
msgid "blog.introducing.text1"
msgstr "ეს პროექტი (<a %(wikipedia_annas_archive)s>ანა არქივი</a>-ზე გადატანილი) მიზნად ისახავს ადამიანის ცოდნის შენარჩუნებასა და გათავისუფლებას. ჩვენ ვაკეთებთ ჩვენს მცირე და თავმდაბალ წვლილს, ჩვენს წინამორბედთა დიდების კვალდაკვალ."

#, fuzzy
msgid "blog.introducing.text2"
msgstr "პროექტის ფოკუსი მისი სახელით არის ილუსტრირებული:"

#, fuzzy
msgid "blog.introducing.focus.pirate"
msgstr "<strong>მეკობრე</strong> - ჩვენ განზრახ ვარღვევთ საავტორო უფლებების კანონებს უმეტეს ქვეყნებში. ეს გვაძლევს საშუალებას გავაკეთოთ ის, რაც იურიდიულ პირებს არ შეუძლიათ: დავრწმუნდეთ, რომ წიგნები შორს და ფართოდ არის ასახული."

#, fuzzy
msgid "blog.introducing.focus.library"
msgstr "<strong>ბიბლიოთეკა</strong> - როგორც უმეტეს ბიბლიოთეკებში, ჩვენ ძირითადად ვამახვილებთ ყურადღებას წერილობით მასალებზე, როგორიცაა წიგნები. მომავალში შეიძლება სხვა ტიპის მედიაში გავფართოვდეთ."

#, fuzzy
msgid "blog.introducing.focus.mirror"
msgstr "<strong>სარკე</strong> - ჩვენ მხოლოდ არსებული ბიბლიოთეკების სარკე ვართ. ჩვენ ვამახვილებთ ყურადღებას შენარჩუნებაზე და არა წიგნების მარტივად საძიებლად და ჩამოსატვირთად (წვდომა) ან ახალი წიგნების შემომტანი დიდი საზოგადოების შექმნაზე (წყარო)."

#, fuzzy
msgid "blog.introducing.text3"
msgstr "პირველი ბიბლიოთეკა, რომელიც ჩვენ ავსახეთ, არის Z-Library. ეს პოპულარული (და არალეგალური) ბიბლიოთეკაა. მათ აიღეს Library Genesis-ის კოლექცია და გაადვილეს მისი ძიება. გარდა ამისა, ისინი ძალიან ეფექტურები გახდნენ ახალი წიგნების შემომტანების მოზიდვაში, მომხმარებლების წახალისებით სხვადასხვა სარგებელით. ამჟამად ისინი არ უბრუნებენ ამ ახალ წიგნებს Library Genesis-ს. და განსხვავებით Library Genesis-ისგან, ისინი არ აკეთებენ თავიანთ კოლექციას ადვილად ასახვად, რაც ხელს უშლის ფართო შენარჩუნებას. ეს მნიშვნელოვანია მათი ბიზნეს მოდელისთვის, რადგან ისინი ფულს იღებენ თავიანთი კოლექციის მასობრივად (10-ზე მეტი წიგნი დღეში) წვდომისთვის."

#, fuzzy
msgid "blog.introducing.text4"
msgstr "ჩვენ არ ვაკეთებთ მორალურ შეფასებებს ფულის აღებაზე არალეგალური წიგნების კოლექციაზე მასობრივი წვდომისთვის. ეჭვგარეშეა, რომ Z-ბიბლიოთეკამ წარმატებით გააფართოვა ცოდნის წვდომა და მოიძია მეტი წიგნი. ჩვენ უბრალოდ აქ ვართ, რომ ჩვენი წვლილი შევიტანოთ: უზრუნველვყოთ ამ კერძო კოლექციის გრძელვადიანი შენახვა."

#, fuzzy
msgid "blog.introducing.text5"
msgstr "გვსურს მოგიწვიოთ, რომ დაეხმაროთ ადამიანის ცოდნის შენარჩუნებასა და გათავისუფლებაში ჩვენი ტორენტების ჩამოტვირთვით და დათესვით. იხილეთ პროექტის გვერდი მონაცემების ორგანიზების შესახებ მეტი ინფორმაციისთვის."

#, fuzzy
msgid "blog.introducing.text6"
msgstr "ასევე ძალიან გვსურს, რომ შემოგვთავაზოთ თქვენი იდეები, რომელ კოლექციებს უნდა ავსახოთ შემდეგ და როგორ უნდა გავაკეთოთ ეს. ერთად შეგვიძლია ბევრი რამ მივაღწიოთ. ეს მხოლოდ მცირე წვლილია უამრავ სხვათა შორის. მადლობა, ყველაფრისთვის, რასაც აკეთებთ."

