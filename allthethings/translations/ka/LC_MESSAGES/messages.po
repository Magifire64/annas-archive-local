#, fuzzy
msgid "blog.backed-up-libgen-li.fundraiser.text7"
msgstr "აქ არის ტორენტები, რომლებიც აქამდე გამოვუშვით (ჩვენ ჯერ კიდევ ვამუშავებთ დანარჩენს):"

#, fuzzy
msgid "blog.backed-up-libgen-li.fundraiser.text8"
