#, fuzzy
msgid "blog.backed-up-libgen-li.forks"
msgstr "Libgen-ის ფორკები"

#, fuzzy
msgid "blog.backed-up-libgen-li.forks.text1"
msgstr "პირველ რიგში, ცოტა ფონი. შესაძლოა იცნობდეთ Library Genesis-ს მათი ეპიკური წიგნების კოლექციისთვის. ნაკლებად იციან, რომ Library Genesis-ის მოხალისეებმა შექმნეს სხვა პროექტები, როგორიცაა ჟურნალებისა და სტანდარტული დოკუმენტების დიდი კოლექცია, Sci-Hub-ის სრული სარეზერვო ასლი (Sci-Hub-ის დამფუძნებელ ალექსანდრა ელბაკიანთან თანამშრომლობით) და მართლაც, კომიქსების მასიური კოლექცია."

#, fuzzy
msgid "blog.backed-up-libgen-li.forks.text2"
msgstr "ერთ მომენტში Library Genesis-ის სარკეების სხვადასხვა ოპერატორები თავიანთი გზებით წავიდნენ, რამაც წარმოშვა ამჟამინდელი სიტუაცია, სადაც არსებობს რამდენიმე სხვადასხვა „ფორკი“, რომლებიც კვლავ Library Genesis-ის სახელს ატარებენ. Libgen.li ფორკს უნიკალურად აქვს ეს კომიქსების კოლექცია, ასევე დიდი ჟურნალების კოლექცია (რომელზეც ჩვენც ვმუშაობთ)."

#, fuzzy
msgid "blog.backed-up-libgen-li.collaboration"
msgstr "თანამშრომლობა"

#, fuzzy
msgid "blog.backed-up-libgen-li.collaboration.text1"
msgstr "მისი ზომის გათვალისწინებით, ეს კოლექცია დიდი ხანია ჩვენს სურვილების სიაშია, ამიტომ Z-Library-ის სარეზერვო ასლის წარმატების შემდეგ, ჩვენი მზერა ამ კოლექციაზე გადავიტანეთ. თავიდან პირდაპირ ვაგროვებდით მას, რაც საკმაოდ რთული იყო, რადგან მათი სერვერი საუკეთესო მდგომარეობაში არ იყო. ამ გზით დაახლოებით 15TB მივიღეთ, მაგრამ ეს ნელი პროცესი იყო."

#, fuzzy
msgid "blog.backed-up-libgen-li.collaboration.text2"
msgstr "საბედნიეროდ, მოვახერხეთ ბიბლიოთეკის ოპერატორთან დაკავშირება, რომელმაც დაგვთანხმდა, რომ ყველა მონაცემი პირდაპირ გადმოგვეგზავნა, რაც ბევრად უფრო სწრაფი იყო. მაინც ნახევარ წელზე მეტი დასჭირდა ყველა მონაცემის გადატანასა და დამუშავებას, და თითქმის ყველაფერი დისკის დაზიანების გამო დავკარგეთ, რაც თავიდან დაწყებას ნიშნავდა."

#, fuzzy
msgid "blog.backed-up-libgen-li.collaboration.text3"
msgstr "ამ გამოცდილებამ დაგვარწმუნა, რომ მნიშვნელოვანია ეს მონაცემები რაც შეიძლება სწრაფად გავავრცელოთ, რათა სარკეები ფართოდ გავრცელდეს. ჩვენ მხოლოდ ერთი ან ორი უიღბლო შემთხვევისგან ვართ დაშორებული, რომ ეს კოლექცია სამუდამოდ დავკარგოთ!"

#, fuzzy
msgid "blog.backed-up-libgen-li.collection"
msgstr "კოლექცია"

#, fuzzy
msgid "blog.backed-up-libgen-li.collection.text1"
msgstr "სწრაფად მოძრაობა ნიშნავს, რომ კოლექცია ცოტა არაორგანიზებულია… მოდით შევხედოთ. წარმოიდგინეთ, რომ გვაქვს ფაილური სისტემა (რომელსაც რეალურად ტორენტებში ვყოფთ):"

#, fuzzy
msgid "blog.backed-up-libgen-li.collection.text2"
msgstr "პირველი დირექტორია, <code>/repository</code>, ამ ყველაფრის უფრო სტრუქტურირებული ნაწილია. ეს დირექტორია შეიცავს ე.წ. „ათას დირექტორიებს“: დირექტორიები, თითოეულში ათასი ფაილი, რომლებიც მონაცემთა ბაზაში თანმიმდევრულად არის დანომრილი. დირექტორია <code>0</code> შეიცავს ფაილებს comic_id 0–999, და ასე შემდეგ."

#, fuzzy
msgid "blog.backed-up-libgen-li.collection.text3"
msgstr "ეს იგივე სქემაა, რომელსაც Library Genesis იყენებს თავისი მხატვრული და არამხატვრული კოლექციებისთვის. იდეა ისაა, რომ ყოველი „ათას დირექტორია“ ავტომატურად გადაიქცევა ტორენტად, როგორც კი შეივსება."

#, fuzzy
msgid "blog.backed-up-libgen-li.collection.text4"
msgstr "თუმცა, Libgen.li ოპერატორმა არასდროს შექმნა ტორენტები ამ კოლექციისთვის, ამიტომ ათას დირექტორიები ალბათ მოუხერხებელი გახდა და „არასორტირებული დირექტორიების“ გზა გაიხსნა. ესენი არიან <code>/comics0</code> დან <code>/comics4</code> მდე. ყველა შეიცავს უნიკალურ დირექტორიულ სტრუქტურებს, რომლებიც ალბათ ფაილების შეგროვებისთვის აზრიანი იყო, მაგრამ ახლა ჩვენთვის დიდად აზრიანი არ არის. საბედნიეროდ, metadata პირდაპირ ეხება ყველა ამ ფაილს, ამიტომ მათი შენახვის ორგანიზაცია დისკზე რეალურად არ აქვს მნიშვნელობა!"

#, fuzzy
msgid "blog.backed-up-libgen-li.collection.text5"
msgstr "metadata ხელმისაწვდომია MySQL მონაცემთა ბაზის სახით. ეს შეიძლება პირდაპირ გადმოიწეროს Libgen.li ვებსაიტიდან, მაგრამ ჩვენ ასევე გავავრცელებთ მას ტორენტში, ჩვენი საკუთარი ცხრილით, რომელიც შეიცავს ყველა MD5 ჰეშს."

