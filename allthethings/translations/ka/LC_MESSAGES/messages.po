#, fuzzy
msgid "blog.annas-archive-containers.example.heading"
msgstr "მაგალითი"

#, fuzzy
msgid "blog.annas-archive-containers.example.text1"
msgstr "მოდით, განვიხილოთ ჩვენი ბოლო Z-Library გამოშვება, როგორც მაგალითი. ის შედგება ორი კოლექციისგან: “<span style=\"background: #fffaa3\">zlib3_records</span>” და “<span style=\"background: #ffd6fe\">zlib3_files</span>”. ეს საშუალებას გვაძლევს, ცალკე გამოვყოთ და გამოვუშვათ მეტამონაცემების ჩანაწერები რეალური წიგნის ფაილებიდან. შესაბამისად, გამოვუშვით ორი ტორენტი მეტამონაცემების ფაილებით:"

#, fuzzy
msgid "blog.annas-archive-containers.example.text2"
msgstr "ასევე გამოვუშვით ტორენტების სერია ბინარული მონაცემების ფოლდერებით, მაგრამ მხოლოდ “<span style=\"background: #ffd6fe\">zlib3_files</span>” კოლექციისთვის, სულ 62:"

#, fuzzy
msgid "blog.annas-archive-containers.example.text3"
msgstr "როდესაც ვუშვებთ <code>zstdcat <span style=\"color: red\">annas_archive_meta__</span><span style=\"color: blue\">aacid__<span style=\"background: #fffaa3\">zlib3_records</span>__20230808T014342Z--20230808T023702Z.jsonl.zst</span></code>, შეგვიძლია ვნახოთ, რა არის შიგნით:"

#, fuzzy
msgid "blog.annas-archive-containers.example.text4"
msgstr "ამ შემთხვევაში, ეს არის წიგნის მეტამონაცემები, როგორც Z-Library-მა აღნიშნა. ზედა დონეზე გვაქვს მხოლოდ “aacid” და “metadata”, მაგრამ არა “data_folder”, რადგან შესაბამისი ბინარული მონაცემები არ არსებობს. AACID შეიცავს “22430000”-ს, როგორც ძირითად ID-ს, რაც ჩანს, რომ აღებულია “zlibrary_id”-დან. შეგვიძლია ველოდოთ, რომ ამ კოლექციაში სხვა AAC-ებს ექნებათ იგივე სტრუქტურა."

#, fuzzy
msgid "blog.annas-archive-containers.example.text5"
msgstr "ახლა ვუშვებთ <code>zstdcat <span style=\"color: red\">annas_archive_meta__</span><span style=\"color: blue\">aacid__<span style=\"background: #ffd6fe\">zlib3_files</span>__20230808T051503Z--20230809T223215Z.jsonl.zst</span></code>:"

#, fuzzy
msgid "blog.annas-archive-containers.example.text6"
msgstr "ეს არის ბევრად მცირე AAC მეტამონაცემები, თუმცა ამ AAC-ის ძირითადი ნაწილი სხვაგან, ბინარულ ფაილშია განთავსებული! ბოლოს და ბოლოს, ამჯერად გვაქვს “data_folder”, ასე რომ შეგვიძლია ველოდოთ, რომ შესაბამისი ბინარული მონაცემები განთავსებულია <code><span style=\"color: green\">annas_archive_data__</span><span style=\"color: blue\">aacid__<span style=\"background: #ffd6fe\">zlib3_files</span>__20230808T051503Z--20230808T051504Z</span>/<span style=\"color: #0093ff\">aacid__<span style=\"background: #ffd6fe\">zlib3_files</span>__20230808T051503Z__22433983__NRgUGwTJYJpkQjTbz2jA3M</span></code>. “metadata” შეიცავს “zlibrary_id”-ს, ასე რომ შეგვიძლია მარტივად დავაკავშიროთ ის შესაბამის AAC-თან “zlib_records” კოლექციაში. შეგვეძლო დაგვაკავშირებინა სხვადასხვა გზით, მაგალითად AACID-ის მეშვეობით — სტანდარტი ამას არ განსაზღვრავს."

#, fuzzy
msgid "blog.annas-archive-containers.example.text7"
msgstr "გაითვალისწინეთ, რომ “metadata” ველი არ არის აუცილებელი იყოს JSON. ის შეიძლება იყოს სტრიქონი, რომელიც შეიცავს XML-ს ან სხვა მონაცემთა ფორმატს. მეტამონაცემების ინფორმაცია შეიძლება შეინახოთ შესაბამის ბინარულ ბლობსშიც, მაგალითად, თუ ეს დიდი მოცულობის მონაცემებია."

