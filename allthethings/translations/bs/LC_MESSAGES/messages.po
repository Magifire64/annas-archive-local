msgid "blog.all-isbns.background.text2"
msgstr "Ne postoji centralna vlast koja zna sve dodjele ISBN brojeva. Umjesto toga, to je distribuirani sistem, gdje zemlje dobijaju raspon brojeva, koji zatim dodjeljuju manje raspone velikim izdavačima, koji mogu dalje podijeliti raspone manjim izdavačima. Na kraju, pojedinačni brojevi se dodjeljuju knjigama."

#, fuzzy
msgid "blog.all-isbns.background.text3"
