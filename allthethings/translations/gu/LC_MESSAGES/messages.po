msgstr "<code>zstdcat <span style=\"color: red\">annas_archive_meta__</span><span style=\"color: blue\">aacid__<span style=\"background: #fffaa3\">zlib3_records</span>__20230808T014342Z--20230808T023702Z.jsonl.zst</span></code> ચલાવીને આપણે અંદર શું છે તે જોઈ શકીએ છીએ:"

#, fuzzy
msgid "blog.annas-archive-containers.example.text4"
msgstr "આ કિસ્સામાં, તે Z-લાઇબ્રેરી દ્વારા રિપોર્ટ કરેલા પુસ્તકનું મેટાડેટા છે. ટોચના સ્તરે અમારી પાસે ફક્ત “aacid” અને “metadata” છે, પરંતુ કોઈ “data_folder” નથી, કારણ કે ત્યાં કોઈ અનુરૂપ બાઇનરી ડેટા નથી. AACIDમાં “22430000” મુખ્ય ID તરીકે છે, જે આપણે જોઈ શકીએ છીએ કે “zlibrary_id”માંથી લેવામાં આવ્યું છે. આપણે આ સંગ્રહમાં અન્ય AACsને સમાન માળખું ધરાવવાની અપેક્ષા રાખી શકીએ છીએ."

#, fuzzy
msgid "blog.annas-archive-containers.example.text5"
msgstr "હવે ચાલો <code>zstdcat <span style=\"color: red\">annas_archive_meta__</span><span style=\"color: blue\">aacid__<span style=\"background: #ffd6fe\">zlib3_files</span>__20230808T051503Z--20230809T223215Z.jsonl.zst</span></code> ચલાવીએ:"

#, fuzzy
msgid "blog.annas-archive-containers.example.text6"
msgstr "આ એક ખૂબ જ નાનું AAC મેટાડેટા છે, જોકે આ AACનો મોટો ભાગ અન્યત્ર બાઇનરી ફાઇલમાં સ્થિત છે! આખરે, આ વખતે અમારી પાસે “data_folder” છે, તેથી આપણે અપેક્ષા રાખી શકીએ છીએ કે અનુરૂપ બાઇનરી ડેટા <code><span style=\"color: green\">annas_archive_data__</span><span style=\"color: blue\">aacid__<span style=\"background: #ffd6fe\">zlib3_files</span>__20230808T051503Z--20230808T051504Z</span>/<span style=\"color: #0093ff\">aacid__<span style=\"background: #ffd6fe\">zlib3_files</span>__20230808T051503Z__22433983__NRgUGwTJYJpkQjTbz2jA3M</span></code> પર સ્થિત છે. “metadata”માં “zlibrary_id” છે, તેથી આપણે તેને સરળતાથી “zlib_records” સંગ્રહમાં અનુરૂપ AAC સાથે જોડાઈ શકીએ છીએ. આપણે વિવિધ રીતે જોડાઈ શકતા, ઉદાહરણ તરીકે AACID દ્વારા — ધોરણ તે નક્કી કરતું નથી."

#, fuzzy
msgid "blog.annas-archive-containers.example.text7"
msgstr "નોટ કરો કે “metadata” ક્ષેત્રને પોતે JSON હોવું જરૂરી નથી. તે XML અથવા કોઈપણ અન્ય ડેટા ફોર્મેટ ધરાવતી સ્ટ્રિંગ હોઈ શકે છે. તમે સંકળાયેલા બાઇનરી બ્લોબમાં પણ મેટાડેટા માહિતી સંગ્રહિત કરી શકો છો, ઉદાહરણ તરીકે જો તે ઘણું ડેટા હોય."

