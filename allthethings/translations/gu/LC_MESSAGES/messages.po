msgid "blog.how-to.signature"
msgstr "- અન્ના અને ટીમ (<a %(reddit)s>Reddit</a>)"

#, fuzzy
msgid "blog.introducing.title"
msgstr "પાયરેટ લાઇબ્રેરી મિરર રજૂ કરવું: 7TB પુસ્તકોનું સંરક્ષણ (જે Libgen માં નથી)"

#, fuzzy
msgid "blog.introducing.text1"
msgstr "આ પ્રોજેક્ટ (સંપાદન: <a %(wikipedia_annas_archive)s>એના’સ આર્કાઇવ</a> પર ખસેડવામાં આવ્યું) માનવ જ્ઞાનના સંરક્ષણ અને મુક્તિમાં યોગદાન આપવા માટે પ્રયત્નશીલ છે. અમે અમારા નાના અને નમ્ર યોગદાન આપીએ છીએ, અમારા પૂર્વજોના પગલે."

#, fuzzy
msgid "blog.introducing.text2"
msgstr "આ પ્રોજેક્ટનું ધ્યાન તેના નામ દ્વારા દર્શાવવામાં આવ્યું છે:"

#, fuzzy
msgid "blog.introducing.focus.pirate"
msgstr "<strong>પાયરેટ</strong> - અમે ઇચ્છાપૂર્વક મોટાભાગના દેશોમાં કૉપિરાઇટ કાયદાનું ઉલ્લંઘન કરીએ છીએ. આ અમને કાનૂની સંસ્થાઓ જે કરી શકતી નથી તે કરવા માટે સક્ષમ બનાવે છે: ખાતરી કરવી કે પુસ્તકો વ્યાપક રીતે પ્રતિબિંબિત થાય છે."

#, fuzzy
msgid "blog.introducing.focus.library"
msgstr "<strong>લાઇબ્રેરી</strong> - મોટાભાગની લાઇબ્રેરીઓની જેમ, અમે મુખ્યત્વે પુસ્તકો જેવા લખાણ સામગ્રી પર ધ્યાન કેન્દ્રિત કરીએ છીએ. ભવિષ્યમાં અમે અન્ય પ્રકારના મીડિયા તરફ વિસ્તરી શકીએ છીએ."

#, fuzzy
msgid "blog.introducing.focus.mirror"
msgstr "<strong>મિરર</strong> - અમે કડક રીતે અસ્તિત્વમાં આવેલી લાઇબ્રેરીઓના પ્રતિબિંબ છીએ. અમે સંરક્ષણ પર ધ્યાન કેન્દ્રિત કરીએ છીએ, પુસ્તકોને સરળતાથી શોધી શકાય તેવા અને ડાઉનલોડ કરી શકાય તેવા (પ્રવેશ) અથવા નવા પુસ્તકો યોગદાન આપતા લોકોના મોટા સમુદાયને પ્રોત્સાહન આપતા નથી."

#, fuzzy
msgid "blog.introducing.text3"
msgstr "પ્રથમ લાઇબ્રેરી જેનું અમે પ્રતિબિંબિત કર્યું છે તે Z-લાઇબ્રેરી છે. આ એક લોકપ્રિય (અને ગેરકાયદેસર) લાઇબ્રેરી છે. તેમણે લાઇબ્રેરી જેનેસિસ સંગ્રહને સરળતાથી શોધી શકાય તેવું બનાવ્યું છે. તે ઉપરાંત, તેઓ નવા પુસ્તક યોગદાનને પ્રોત્સાહિત કરીને ખૂબ જ અસરકારક બની ગયા છે. તેઓ હાલમાં આ નવા પુસ્તકોને લાઇબ્રેરી જેનેસિસમાં પાછા યોગદાન આપતા નથી. અને લાઇબ્રેરી જેનેસિસની જેમ, તેઓ તેમના સંગ્રહને સરળતાથી પ્રતિબિંબિત કરી શકતા નથી, જે વ્યાપક સંરક્ષણને અટકાવે છે. આ તેમના વ્યવસાય મોડલ માટે મહત્વપૂર્ણ છે, કારણ કે તેઓ તેમના સંગ્રહને બલ્કમાં (દિવસે 10 થી વધુ પુસ્તકો) ઍક્સેસ કરવા માટે પૈસા લે છે."

#, fuzzy
msgid "blog.introducing.text4"
msgstr "અમે ગેરકાયદેસર પુસ્તક સંગ્રહ માટે મોટા પાયે પ્રવેશ માટે પૈસા વસૂલવા અંગે નૈતિક નિર્ણય નથી લેતા. એમાં કોઈ શંકા નથી કે Z-લાઇબ્રેરીએ જ્ઞાનનો પ્રવેશ વિસ્તૃત કરવામાં અને વધુ પુસ્તકો મેળવવામાં સફળતા મેળવી છે. અમે ફક્ત અમારી ભૂમિકા નિભાવવા માટે અહીં છીએ: આ ખાનગી સંગ્રહના લાંબા ગાળાના સંરક્ષણને સુનિશ્ચિત કરવું."

#, fuzzy
msgid "blog.introducing.text5"
msgstr "અમે તમને અમારા ટોરેન્ટ્સ ડાઉનલોડ કરીને અને સીડ કરીને માનવ જ્ઞાનને જાળવવા અને મુક્ત કરવા માટે મદદ કરવા માટે આમંત્રિત કરવા માંગીએ છીએ. ડેટા કેવી રીતે ગોઠવાયેલું છે તે વિશે વધુ માહિતી માટે પ્રોજેક્ટ પૃષ્ઠ જુઓ."

#, fuzzy
msgid "blog.introducing.text6"
msgstr "અમે તમને કયા સંગ્રહોનું પ્રતિબિંબિત કરવું તે માટેના તમારા વિચારોમાં યોગદાન આપવા માટે પણ ખૂબ જ આમંત્રિત કરીએ છીએ, અને તે કેવી રીતે કરવું તે માટે. સાથે મળીને અમે ઘણું હાંસલ કરી શકીએ છીએ. આ અનંત અન્ય લોકોમાં એક નાનું યોગદાન છે. તમે જે બધું કરો છો તે માટે આભાર."

