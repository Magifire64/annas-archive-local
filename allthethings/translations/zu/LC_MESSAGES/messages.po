msgid "blog.critical-window.priorities.text3"
msgstr "Ukulinganisa kulolu hlu kungenzeka kube okungahleliwe — ezinye izinto zilingana noma kunokungavumelani phakathi kwethimba lethu — futhi kungenzeka sikhohlwe ezinye izigaba ezibalulekile. Kodwa lokhu cishe yindlela esibeka ngayo phambili."

#, fuzzy
msgid "blog.critical-window.priorities.text4"
