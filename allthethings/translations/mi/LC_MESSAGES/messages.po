#, fuzzy
msgid "blog.all-isbns.bounty.code.text1"
msgstr "Ka kitea te waehere hei waihanga i ēnei whakaahua, me ētahi atu tauira, i <a %(annas_archive)s>tēnei kōpaki</a>."

