msgid "page.donate.payment.desc.bank_card_app.step2.desc1"
msgstr "Поддерживаются: Visa, MasterCard, JCB, Diners Club и Discover."

#, fuzzy
msgid "page.donate.payment.desc.bank_card_app.step2.desc2"
