msgid "blog.how-to.projects"
msgstr "ਪ੍ਰੋਜੈਕਟਸ"

#, fuzzy
msgid "blog.how-to.projects.text1"
msgstr "ਜਦੋਂ ਅਸੀਂ ਕੋਈ ਪ੍ਰੋਜੈਕਟ ਕਰਦੇ ਹਾਂ, ਇਸ ਵਿੱਚ ਕੁਝ ਪੜਾਅ ਹੁੰਦੇ ਹਨ:"

