msgstr "<a %(a_software)s>Phần mềm của Anna</a> — mã nguồn mở của chúng tôi"

msgid "page.faq.resources.translate"
msgstr "<a %(a_translate)s>Dịch trên Phần mềm của Anna</a> — hệ thống dịch thuật của chúng tôi"

