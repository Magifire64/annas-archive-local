msgid "blog.critical-window.title"
msgstr "Jandela kritis perpustakaan bayangan"

#, fuzzy
msgid "blog.critical-window.tldr"
msgstr "Kumaha urang tiasa ngaku ngajaga koleksi urang salawasna, nalika aranjeunna parantos ngadeukeutan 1 PB?"

