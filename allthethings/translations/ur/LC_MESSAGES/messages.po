msgstr "پروجیکٹس"

#, fuzzy
msgid "blog.how-to.projects.text1"
msgstr "جب ہم کوئی پروجیکٹ کرتے ہیں، تو اس کے کچھ مراحل ہوتے ہیں:"

#, fuzzy
msgid "blog.how-to.projects.phase1"
msgstr "ڈومین کا انتخاب / فلسفہ: آپ تقریباً کہاں توجہ مرکوز کرنا چاہتے ہیں، اور کیوں؟ آپ کے منفرد شوق، مہارتیں، اور حالات کیا ہیں جنہیں آپ اپنے فائدے کے لئے استعمال کر سکتے ہیں؟"

#, fuzzy
msgid "blog.how-to.projects.phase2"
msgstr "ہدف کا انتخاب: آپ کون سا مخصوص مجموعہ آئینہ بنائیں گے؟"

#, fuzzy
msgid "blog.how-to.projects.phase3"
msgstr "میٹا ڈیٹا سکریپنگ: فائلوں کے بارے میں معلومات کی کیٹلاگنگ، بغیر اصل میں (اکثر بہت بڑی) فائلوں کو ڈاؤن لوڈ کیے۔"

#, fuzzy
msgid "blog.how-to.projects.phase4"
msgstr "ڈیٹا کا انتخاب: میٹا ڈیٹا کی بنیاد پر، یہ تنگ کرنا کہ کون سا ڈیٹا ابھی آرکائیو کرنے کے لئے سب سے زیادہ متعلقہ ہے۔ یہ سب کچھ ہو سکتا ہے، لیکن اکثر جگہ اور بینڈوڈتھ بچانے کا ایک معقول طریقہ ہوتا ہے۔"

#, fuzzy
msgid "blog.how-to.projects.phase5"
msgstr "ڈیٹا سکریپنگ: اصل میں ڈیٹا حاصل کرنا۔"

#, fuzzy
msgid "blog.how-to.projects.phase6"
msgstr "تقسیم: اسے ٹورینٹس میں پیکج کرنا، کہیں اعلان کرنا، لوگوں کو اسے پھیلانے کے لئے حاصل کرنا۔"

#, fuzzy
msgid "blog.how-to.projects.text2"
msgstr "یہ مکمل طور پر آزاد مراحل نہیں ہیں، اور اکثر بعد کے مرحلے سے بصیرت آپ کو پہلے مرحلے پر واپس بھیج دیتی ہے۔ مثال کے طور پر، میٹا ڈیٹا سکریپنگ کے دوران آپ کو احساس ہو سکتا ہے کہ آپ کے منتخب کردہ ہدف کے پاس آپ کی مہارت کی سطح سے آگے کے دفاعی میکانزم ہیں (جیسے آئی پی بلاکس)، لہذا آپ واپس جا کر ایک مختلف ہدف تلاش کرتے ہیں۔"

#, fuzzy
msgid "blog.how-to.projects.domain"
msgstr "1. ڈومین کا انتخاب / فلسفہ"

#, fuzzy
msgid "blog.how-to.projects.domain.text1"
msgstr "محفوظ کرنے کے لیے علم اور ثقافتی ورثے کی کوئی کمی نہیں ہے، جو کہ زبردست ہو سکتا ہے۔ اسی لیے اکثر یہ مفید ہوتا ہے کہ ایک لمحہ لیں اور سوچیں کہ آپ کا تعاون کیا ہو سکتا ہے۔"

#, fuzzy
msgid "blog.how-to.projects.domain.text2"
msgstr "ہر کسی کا اس بارے میں سوچنے کا مختلف طریقہ ہوتا ہے، لیکن یہاں کچھ سوالات ہیں جو آپ اپنے آپ سے پوچھ سکتے ہیں:"

#, fuzzy
msgid "blog.how-to.projects.domain.why.why"
msgstr "آپ اس میں دلچسپی کیوں رکھتے ہیں؟ آپ کس چیز کے بارے میں پرجوش ہیں؟ اگر ہم لوگوں کا ایک گروپ حاصل کر سکتے ہیں جو ان چیزوں کو محفوظ کرتے ہیں جن کی وہ خاص طور پر پرواہ کرتے ہیں، تو یہ بہت کچھ کا احاطہ کرے گا! آپ اپنے شوق کے بارے میں اوسط شخص سے بہت زیادہ جانیں گے، جیسے کہ محفوظ کرنے کے لیے اہم ڈیٹا کیا ہے، بہترین مجموعے اور آن لائن کمیونٹیز کیا ہیں، وغیرہ۔"

#, fuzzy
msgid "blog.how-to.projects.domain.why.skills"
msgstr "آپ کے پاس کون سی مہارتیں ہیں جنہیں آپ اپنے فائدے کے لیے استعمال کر سکتے ہیں؟ مثال کے طور پر، اگر آپ آن لائن سیکیورٹی کے ماہر ہیں، تو آپ محفوظ اہداف کے لیے آئی پی بلاکس کو شکست دینے کے طریقے تلاش کر سکتے ہیں۔ اگر آپ کمیونٹیز کو منظم کرنے میں ماہر ہیں، تو شاید آپ کسی مقصد کے ارد گرد کچھ لوگوں کو اکٹھا کر سکتے ہیں۔ کچھ پروگرامنگ جاننا مفید ہے، اگر صرف اس عمل کے دوران اچھی آپریشنل سیکیورٹی کو برقرار رکھنے کے لیے۔"

#, fuzzy
msgid "blog.how-to.projects.domain.why.time"
msgstr "آپ کے پاس اس کے لئے کتنا وقت ہے؟ ہمارا مشورہ یہ ہوگا کہ چھوٹے سے شروع کریں اور جیسے جیسے آپ کو اس کی عادت ہو جائے، بڑے پروجیکٹس کریں، لیکن یہ سب کچھ کھا سکتا ہے۔"

#, fuzzy
msgid "blog.how-to.projects.domain.why.target"
msgstr "کون سا اعلیٰ فائدہ مند علاقہ ہے جس پر توجہ مرکوز کی جائے؟ اگر آپ قزاقی آرکائیونگ پر X گھنٹے صرف کرنے جا رہے ہیں، تو پھر آپ اپنے \"بک کے لئے سب سے بڑا بینگ\" کیسے حاصل کر سکتے ہیں؟"

#, fuzzy
msgid "blog.how-to.projects.domain.why.thinking"
msgstr "آپ اس بارے میں منفرد طریقے سے کیسے سوچ رہے ہیں؟ آپ کے پاس کچھ دلچسپ خیالات یا طریقے ہو سکتے ہیں جو دوسروں نے نظرانداز کر دیے ہوں۔"

#, fuzzy
msgid "blog.how-to.projects.domain.text3"
msgstr "ہمارے معاملے میں، ہم خاص طور پر سائنس کے طویل مدتی تحفظ کے بارے میں فکر مند تھے۔ ہمیں Library Genesis کے بارے میں معلوم تھا، اور یہ کہ اسے کئی بار مکمل طور پر ٹورینٹس کے ذریعے عکس بند کیا گیا تھا۔ ہمیں یہ خیال بہت پسند آیا۔ پھر ایک دن، ہم میں سے ایک نے Library Genesis پر کچھ سائنسی درسی کتابیں تلاش کرنے کی کوشش کی، لیکن انہیں نہیں مل سکا، جس سے یہ شک پیدا ہوا کہ یہ واقعی کتنا مکمل تھا۔ پھر ہم نے ان درسی کتابوں کو آن لائن تلاش کیا، اور انہیں دوسری جگہوں پر پایا، جس نے ہمارے منصوبے کے لیے بیج بو دیا۔ یہاں تک کہ جب ہم Z-Library کے بارے میں نہیں جانتے تھے، ہمارے پاس یہ خیال تھا کہ ان تمام کتابوں کو دستی طور پر جمع کرنے کی کوشش نہ کریں، بلکہ موجودہ مجموعوں کو عکس بند کرنے پر توجہ مرکوز کریں، اور انہیں Library Genesis میں واپس شامل کریں۔"

