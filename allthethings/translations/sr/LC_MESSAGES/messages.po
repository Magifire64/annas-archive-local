#, fuzzy
msgid "blog.all-isbns-winners.third2.text1"
msgstr "Иако није најполираније корисничко сучеље, ова <a %(annas_archive_note_2917)s>пријава</a> испуњава многе критеријуме. Посебно нам се допала њена функција поређења."

#, fuzzy
msgid "blog.all-isbns-winners.third3"
