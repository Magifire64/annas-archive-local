#, fuzzy
msgid "page.datasets.zlib.historical.release2.description4"
msgstr "Այս թողարկման համար մենք փոխեցինք կոլլացիան “utf8mb4_unicode_ci”-ի, որը պետք է համատեղելի լինի MySQL-ի հին տարբերակների հետ։"

#, fuzzy
