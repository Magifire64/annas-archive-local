msgid "blog.all-isbns-winner.text5"
msgstr "Խնդրում ենք տեսնել <a %(all_isbns)s>բնօրինակ բլոգային գրառումը</a> լրացուցիչ տեղեկությունների համար։"

#, fuzzy
msgid "blog.all-isbns-winner.text6"
msgstr "Մենք մարտահրավեր ենք նետել այս բարելավմանը։ Մենք կշնորհեինք առաջին տեղին $6,000, երկրորդ տեղին՝ $3,000, և երրորդ տեղին՝ $1,000։ Հաշվի առնելով մեծ արձագանքը և անհավանական ներկայացումները, մենք որոշել ենք մի փոքր ավելացնել մրցանակային ֆոնդը և շնորհել չորս երրորդ տեղ՝ յուրաքանչյուրը $500։ Հաղթողները ստորև են, բայց համոզվեք, որ դիտեք բոլոր ներկայացումները <a %(annas_archive)s>այստեղ</a>, կամ ներբեռնեք մեր <a %(a_2025_01_isbn_visualization_files)s>համակցված տոռենտը</a>։"

