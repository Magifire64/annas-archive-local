#, fuzzy
msgid "blog.all-isbns-winners.text3"
msgstr "Վերջապես մենք ցանկանում էինք պատասխանել հետևյալ հարցերին՝ <strong>որ գրքերն են գոյություն ունեն աշխարհում, քանիսն ենք արդեն արխիվացրել, և որ գրքերին պետք է կենտրոնանանք հաջորդիվ։</strong> Հիանալի է տեսնել, որ այսքան շատ մարդիկ հետաքրքրված են այս հարցերով։"

#, fuzzy
