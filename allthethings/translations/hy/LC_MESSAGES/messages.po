#, fuzzy
msgid "blog.duxiu-exclusive.example_pages.text1"
msgstr "Ձեզ ապացուցելու համար, որ ունեք լավ գործընթաց, ահա որոշ օրինակ էջեր, որոնցով կարող եք սկսել՝ գերհաղորդիչների մասին գրքից։ Ձեր գործընթացը պետք է ճիշտ աշխատի մաթեմատիկայի, աղյուսակների, գծապատկերների, ծանոթագրությունների և այլն։"

#, fuzzy
msgid "blog.duxiu-exclusive.example_pages.text2"
msgstr "Ուղարկեք ձեր մշակված էջերը մեր էլ. հասցեին։ Եթե դրանք լավ տեսք ունենան, մենք ձեզ ավելի շատ կուղարկենք մասնավոր կերպով, և մենք ակնկալում ենք, որ դուք արագ կկարողանաք ձեր գործընթացը կիրառել դրանց վրա։ Երբ մենք գոհ լինենք, կարող ենք գործարք կնքել։"

#, fuzzy
msgid "blog.duxiu-exclusive.collection"
msgstr "Հավաքածու"

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text1"
msgstr "Հավաքածուի մասին որոշ լրացուցիչ տեղեկություններ։ <a %(duxiu)s>Duxiu</a> հսկայական տվյալների բազա է սկանավորված գրքերի, որը ստեղծվել է <a %(chaoxing)s>SuperStar Digital Library Group</a>-ի կողմից։ Դրանք հիմնականում ակադեմիական գրքեր են, սկանավորված՝ համալսարաններին և գրադարաններին թվային հասանելիություն ապահովելու համար։ Մեր անգլախոս լսարանի համար <a %(library_princeton)s>Princeton</a>-ը և <a %(guides_lib_uw)s>University of Washington</a>-ը ունեն լավ ակնարկներ։ Կա նաև հիանալի հոդված, որը տալիս է ավելի շատ նախապատմություն՝ <a %(doi)s>«Digitizing Chinese Books: A Case Study of the SuperStar DuXiu Scholar Search Engine»</a> (փնտրեք Աննայի Արխիվում)։"

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text2"
msgstr "Duxiu-ի գրքերը վաղուց են պիրատացվել չինական ինտերնետում։ Դրանք սովորաբար վաճառվում են մեկ դոլարից պակաս գնով վերավաճառողների կողմից։ Դրանք սովորաբար տարածվում են Google Drive-ի չինական համարժեքի միջոցով, որը հաճախ կոտրվում է՝ ավելի շատ պահեստային տարածք ապահովելու համար։ Որոշ տեխնիկական մանրամասներ կարող եք գտնել <a %(github_duty_machine)s>այստեղ</a> և <a %(github_821_github_io)s>այստեղ</a>։"

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text3"
msgstr "Թեև գրքերը կիսահանրային կերպով տարածվել են, բավականին դժվար է դրանք մեծածավալ ստանալ։ Մենք դա բարձր էինք դրել մեր TODO-ցուցակում և մի քանի ամիս ամբողջական աշխատանք էինք հատկացրել դրա համար։ Սակայն վերջերս մի անհավանական, զարմանալի և տաղանդավոր կամավոր կապ հաստատեց մեզ հետ՝ ասելով, որ նրանք արդեն արել են այս ամբողջ աշխատանքը՝ մեծ ծախսերով։ Նրանք կիսվեցին ամբողջ հավաքածուով մեզ հետ՝ առանց որևէ բանի ակնկալիքի, բացի երկարաժամկետ պահպանման երաշխիքից։ Իրոք զարմանալի։ Նրանք համաձայնեցին այս կերպ օգնություն խնդրել՝ հավաքածուն OCR-ով մշակելու համար։"

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text4"
msgstr "Հավաքածուն ունի 7,543,702 ֆայլ։ Սա ավելի շատ է, քան Library Genesis-ի ոչ գեղարվեստական (մոտ 5.3 միլիոն)։ Ընդհանուր ֆայլի չափը մոտ 359TB (326TiB) է իր ներկայիս ձևով։"

#, fuzzy
msgid "blog.duxiu-exclusive.collection.text5"
msgstr "Մենք բաց ենք այլ առաջարկների և գաղափարների համար։ Պարզապես կապ հաստատեք մեզ հետ։ Տեսեք Աննայի Արխիվը՝ մեր հավաքածուների, պահպանման ջանքերի և ինչպես կարող եք օգնել մասին ավելի շատ տեղեկությունների համար։ Շնորհակալություն!"

