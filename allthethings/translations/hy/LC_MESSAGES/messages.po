msgid "blog.all-isbns-winners.text1"
msgstr "Մի քանի ամիս առաջ մենք հայտարարեցինք <a %(all_isbns)s>10,000 դոլար մրցանակ</a>՝ մեր տվյալների լավագույն հնարավոր վիզուալիզացիան ստեղծելու համար, որը ցույց է տալիս ISBN տարածքը։ Մենք շեշտեցինք, թե որ ֆայլերն ենք արդեն արխիվացրել և որոնք՝ ոչ, և հետագայում ավելացրեցինք տվյալների հավաքածու, որը նկարագրում է, թե քանի գրադարաններ ունեն ISBN-ներ (հազվադեպության չափանիշ)։"

#, fuzzy
msgid "blog.all-isbns-winners.text2"
