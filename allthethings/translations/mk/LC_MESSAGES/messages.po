msgid "blog.annas-archive-containers.goals.heading"
msgstr "Цели на дизајнот"

#, fuzzy
msgid "blog.annas-archive-containers.goals.text1"
msgstr "Нашиот примарен случај на употреба е дистрибуција на датотеки и поврзани metadata од различни постоечки колекции. Нашите најважни размислувања се:"

#, fuzzy
msgid "blog.annas-archive-containers.goals.goal1"
