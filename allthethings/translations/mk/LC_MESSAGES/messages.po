#, fuzzy
msgid "blog.annas-archive-containers.text2.li2"
msgstr "Помагање на сенка библиотеки кои сакаат да бидат поотворени, но немаа време или ресурси за тоа (како колекцијата на стрипови на Libgen)."

#, fuzzy
msgid "blog.annas-archive-containers.text2.li3"
