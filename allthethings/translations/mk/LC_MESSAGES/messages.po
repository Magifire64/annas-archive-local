#, fuzzy
msgid "blog.annas-archive-containers.goals.goal3"
msgstr "Одделни изданија на metadata наспроти податоци за датотеки, или изданија само со metadata (на пр. нашето издание на ISBNdb)."

#, fuzzy
msgid "blog.annas-archive-containers.goals.goal4"
msgstr "Дистрибуција преку торенти, но со можност за други методи на дистрибуција (на пр. IPFS)."

#, fuzzy
msgid "blog.annas-archive-containers.goals.goal5"
