msgid "blog.how-to-run.title"
msgstr "Bawo ni lati ṣiṣẹ ile-ikawe ojiji: awọn iṣẹ ni Ikojọpọ Anna"

#, fuzzy
msgid "blog.how-to-run.tldr"
msgstr "Ko si <q>AWS fun awọn alanu ojiji,</q> nitorina bawo ni a ṣe nṣiṣẹ Ikojọpọ Anna?"

#, fuzzy
msgid "blog.how-to-run.text1"
msgstr "Mo n ṣiṣẹ <a %(wikipedia_annas_archive)s>Ikojọpọ Anna</a>, ẹrọ wiwa ti kii ṣe èrè ti o tobi julọ ni agbaye fun <a %(wikipedia_shadow_library)s>awọn ile-ikawe ojiji</a>, bii Sci-Hub, Library Genesis, ati Z-Library. Ero wa ni lati jẹ ki imọ ati aṣa wa ni irọrun, ati nikẹhin lati kọ agbegbe ti awọn eniyan ti o papọ ṣe igbasilẹ ati tọju <a %(blog_isbndb_dump_how_many_books_are_preserved_forever)s>gbogbo awọn iwe ni agbaye</a>."

#, fuzzy
msgid "blog.how-to-run.text2"
msgstr "Ninu nkan yii Emi yoo fihan bi a ṣe nṣiṣẹ oju opo wẹẹbu yii, ati awọn italaya alailẹgbẹ ti o wa pẹlu ṣiṣe oju opo wẹẹbu pẹlu ipo ofin ti o ni ibeere, nitori ko si “AWS fun awọn alanu ojiji”."

#, fuzzy
msgid "blog.how-to-run.text3"
