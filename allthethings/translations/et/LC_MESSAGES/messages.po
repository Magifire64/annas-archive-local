msgid "blog.backed-up-libgen-li.title"
msgstr "Anna Arhiiv on varundanud maailma suurima koomiksite varjatud raamatukogu (95TB) — saate aidata seda seemendada"

#, fuzzy
msgid "blog.backed-up-libgen-li.tldr"
